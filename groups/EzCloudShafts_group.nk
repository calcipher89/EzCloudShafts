version 15.1 v3
add_layer {P P.red P.green P.blue}
add_layer {shafts shafts.red shafts.green shafts.blue shafts.alpha}
add_layer {cloudshadow cloudshadow.red cloudshadow.green cloudshadow.blue cloudshadow.alpha}
add_layer {shafts_lit shafts_lit.red shafts_lit.green shafts_lit.blue shafts_lit.alpha}
add_layer {atmos_haze_sun atmos_haze_sun.red atmos_haze_sun.green atmos_haze_sun.blue}
Group {
 name EzCloudShafts1
 tile_color 0xb08a4aff
 addUserKnob {20 ezcloudshafts l EzCloudShafts}
 addUserKnob {22 analyze t "Reads the cloud height from the clouds' depth (the median of the cloudy pixels), takes the units from the EzAtmosScatter in 'atmos', and reports how much of the ground the gobo reaches. Run it at a frame where the clouds are in view." T "\nimport math\nn = nuke.thisNode()\nframe = nuke.frame()\nnotes = \[]\n\n\ndef up(i, knob):\n    node = n.input(i)\n    while node is not None and not node.knob(knob):\n        node = node.input(0) if node.inputs() else None\n    return node\n\n\natmos = up(3, 'haze_density')\ncam = up(2, 'focal')\nclouds = n.input(1)\nenv = n.input(0)\nif atmos is not None and atmos.knob('scene_scale'):\n    n\['scene_scale'].setValue(atmos\['scene_scale'].value())\n    notes.append('Units to metres %g, from %s.' % (atmos\['scene_scale'].value(), atmos.name()))\nscale = n\['scene_scale'].value()\nif cam is None:\n    notes.append('No camera in the camera input: connect the shot camera.')\nif env is None:\n    notes.append('Nothing in the env input.')\nif clouds is None:\n    notes.append('Nothing in the clouds input.')\n\n# warns: (rank, text), the most important first; the top one becomes the status line.\nwarns = \[]\nif cam is None or env is None or clouds is None:\n    warns.append((0, 'An input is missing: connect env, clouds and camera.'))\n\n# Find the world position and sun light layers by their usual names.\nif env is not None:\n    layers = set()\n    for c in env.channels():\n        layers.add(c.split('.')\[0])\n    if n\['position_layer'].value() not in layers or n\['position_layer'].value() == 'rgba':\n        found = None\n        for want in ('p', 'pworld', 'p_world', 'pw', 'p_w', 'worldp', 'position', 'world_position', 'worldposition',\n                     'position_world', 'pos', 'wp'):\n            for have in sorted(layers):\n                if found is None and have.lower() == want:\n                    found = have\n        if found is not None:\n            n\['position_layer'].setValue(found)\n            notes.append('Position layer: found \"%s\".' % found)\n    if not n\['use_sun_layer'].value():\n        found = None\n        for want in ('light_sun', 'sun', 'sunlight', 'sun_light', 'rgba_sun', 'c_sun', 'lgt_sun', 'lg_sun', 'key',\n                     'key_light', 'light_key', 'rgba_key', 'lgt_key'):\n            for have in sorted(layers):\n                if found is None and have.lower() == want:\n                    found = have\n        if found is not None:\n            n\['sun_layer'].setValue(found)\n            n\['use_sun_layer'].setValue(True)\n            n\['comp_shadow'].setValue(1)\n            notes.append('Sun light layer: found \"%s\", cloud shadow set to 1.' % found)\n\nif cam is not None and clouds is not None:\n    m = \[cam\['world_matrix'].getValueAt(frame, i) for i in range(16)]\n    focal = cam\['focal'].getValueAt(frame)\n    hap = cam\['haperture'].getValueAt(frame)\n    vap = cam\['vaperture'].getValueAt(frame)\n    fmt = clouds.format()\n    efmt = env.format() if env is not None else fmt\n    ox = max(0.0, (fmt.width() - efmt.width()) / 2.0)\n    oy = max(0.0, (fmt.height() - efmt.height()) / 2.0)\n    depth = n\['clouds_depth'].value()\n    if depth not in clouds.channels():\n        notes.append('The clouds input has no %s channel: set \"clouds depth\".' % depth)\n    else:\n        heights = \[]\n        nx, ny = 64, 36\n        for j in range(ny):\n            for i in range(nx):\n                px = (i + 0.5) * fmt.width() / nx\n                py = (j + 0.5) * fmt.height() / ny\n                a = clouds.sample('rgba.alpha', px, py)\n                if a < 0.5:\n                    continue\n                z = clouds.sample(depth, px, py)\n                if z <= 0:\n                    continue\n                u = (px - ox) / (fmt.width() - 2 * ox)\n                v = (py - oy) / (fmt.height() - 2 * oy)\n                cx = (u - 0.5) * hap / focal * z\n                cy = (v - 0.5) * vap / focal * z\n                cz = -z\n                heights.append((m\[4] * cx + m\[5] * cy + m\[6] * cz + m\[7]) * scale)\n        if len(heights) < 10:\n            notes.append('Too little cloud in the clouds alpha (%d of %d samples) to measure its height.'\n                         % (len(heights), nx * ny))\n        else:\n            heights.sort()\n            pick = lambda f: heights\[min(len(heights) - 1, int(f * len(heights)))]\n            if pick(0.5) <= 0:\n                notes.append('The cloud measured below the ground (%.0f m): is the depth Planar Z, in scene '\n                             'units?' % pick(0.5))\n            else:\n                n\['cloud_height'].setValue(round(pick(0.5), 1))\n                notes.append('Cloud height %.0f m (base %.0f m, top %.0f m, from %d samples).'\n                             % (pick(0.5), pick(0.1), pick(0.9), len(heights)))\n\n        # How much of the ground the gobo reaches, from a grid of the env's world positions.\n        layer = n\['position_layer'].value()\n        if env is not None and layer + '.red' in env.channels():\n            sun = \[n\['sun_in_use'].getValueAt(frame, i) for i in range(3)]\n            rot = math.radians(-n\['sun_rotation_in_use'].getValueAt(frame))\n            sun = \[sun\[0] * math.cos(rot) + sun\[2] * math.sin(rot), sun\[1],\n                   -sun\[0] * math.sin(rot) + sun\[2] * math.cos(rot)]\n            norm = math.sqrt(sum(s * s for s in sun)) or 1.0\n            sun = \[s / norm for s in sun]\n            h = n\['cloud_height'].value()\n            cam_pos = \[m\[3] * scale, m\[7] * scale, m\[11] * scale]\n            cz_ok = True\n            ground = covered = 0\n            bounds = clouds.bbox()\n            short = \{'left': 0.0, 'right': 0.0, 'top': 0.0, 'bottom': 0.0\}\n            dists = \[]\n            for j in range(36):\n                for i in range(64):\n                    px = (i + 0.5) * efmt.width() / 64\n                    py = (j + 0.5) * efmt.height() / 36\n                    p = \[env.sample(layer + '.' + c, px, py) * scale\n                         for c in ('red', 'green', 'blue')]\n                    if p == \[0.0, 0.0, 0.0]:\n                        continue\n                    dists.append(math.sqrt((p\[0] - cam_pos\[0]) ** 2 + (p\[1] - cam_pos\[1]) ** 2 +\n                                           (p\[2] - cam_pos\[2]) ** 2))\n                    if p\[1] >= h:\n                        continue\n                    ground += 1\n                    if sun\[1] <= 0.01:\n                        continue\n                    t = (h - p\[1]) / sun\[1]\n                    d = \[p\[k] + sun\[k] * t - cam_pos\[k] for k in range(3)]\n                    cx = m\[0] * d\[0] + m\[4] * d\[1] + m\[8] * d\[2]\n                    cy = m\[1] * d\[0] + m\[5] * d\[1] + m\[9] * d\[2]\n                    cz = m\[2] * d\[0] + m\[6] * d\[1] + m\[10] * d\[2]\n                    if cz > -1e-3:\n                        cz_ok = False\n                        continue\n                    x = ox + (0.5 + cx / -cz * focal / hap) * (fmt.width() - 2 * ox)\n                    y = oy + (0.5 + cy / -cz * focal / vap) * (fmt.height() - 2 * oy)\n                    if bounds.x() <= x < bounds.x() + bounds.w() and bounds.y() <= y < bounds.y() + bounds.h():\n                        covered += 1\n                    else:\n                        short\['left'] = max(short\['left'], bounds.x() - x)\n                        short\['right'] = max(short\['right'], x - bounds.x() - bounds.w())\n                        short\['bottom'] = max(short\['bottom'], bounds.y() - y)\n                        short\['top'] = max(short\['top'], y - bounds.y() - bounds.h())\n            if ground:\n                share = 100.0 * covered / ground\n                notes.append('The gobo reaches %.0f%% of the ground; the rest uses \"outside frame\" (%s).'\n                             % (share, n\['outside_frame'].value()))\n                if share < 90:\n                    need = \[]\n                    for side in ('top', 'left', 'right', 'bottom'):\n                        if short\[side] > 0:\n                            need.append('%s %d px' % (side, short\[side]))\n                    text = 'Gobo reaches only %.0f%% of the ground.' % share\n                    if need and cz_ok:\n                        text += ' Ask CG for more overscan: ' + ', '.join(need) + '.'\n                    else:\n                        text += ' The sun rays land behind the camera, so overscan will not help.'\n                    warns.append((3, text))\n\n            # A first result that shows: haze from how far the scene reaches.\n            if dists:\n                dists.sort()\n                near_km = dists\[len(dists) // 2] / 1000.0\n                far_km = dists\[min(len(dists) - 1, int(len(dists) * 0.99))] / 1000.0\n                n\['scene_depth'].setValue(round(near_km, 3))\n                density = min(2.0, max(0.005, 0.6 / max(near_km, 0.05)))\n                reach = round(max(far_km * 1.2, 1.0), 1)\n                if abs(n\['shaft_density'].value() - 0.1) < 1e-6 and n\['max_distance'].value() == 0:\n                    n\['shaft_density'].setValue(round(density, 3))\n                    n\['max_distance'].setValue(reach)\n                    n\['sky_distance'].setValue(reach)\n                    notes.append('Scene reaches %.1f km (median %.1f km): haze density %.3f /km, max and sky distance '\n                                 '%.1f km.' % (far_km, near_km, density, reach))\n                else:\n                    notes.append('Scene reaches %.1f km (median %.1f km). Haze density around %.3f /km would suit it '\n                                 '(left as it is, since you have set it).' % (far_km, near_km, density))\n                if near_km > 500 or far_km < 0.002:\n                    warns.append((1, 'Units look wrong: the scene is %.3g km deep. Check \"units to metres\".' % near_km))\n        else:\n            notes.append('The env input has no \"%s\" layer: set \"position layer\" to its world position.' % layer)\n\nif cam is not None:\n    m = \[cam\['world_matrix'].getValueAt(frame, i) for i in range(16)]\n    sun = \[n\['sun_in_use'].getValueAt(frame, i) for i in range(3)]\n    rot = math.radians(-n\['sun_rotation_in_use'].getValueAt(frame))\n    sun = \[sun\[0] * math.cos(rot) + sun\[2] * math.sin(rot), sun\[1],\n           -sun\[0] * math.sin(rot) + sun\[2] * math.cos(rot)]\n    norm = math.sqrt(sun\[0] ** 2 + sun\[1] ** 2 + sun\[2] ** 2) or 1.0\n    sun = \[v / norm for v in sun]\n    elev = math.degrees(math.asin(max(-1.0, min(1.0, sun\[1]))))\n    fwd = \[-m\[2], -m\[6], -m\[10]]\n    az = (math.degrees(math.atan2(sun\[0], -sun\[2]) - math.atan2(fwd\[0], -fwd\[2])) + 180.0) % 360.0 - 180.0\n    notes.append('Sun %.0f deg up, %.0f deg %s of where the camera looks.' % (elev, abs(az), 'right' if az > 0 else 'left'))\n    if elev <= 0:\n        warns.append((1, 'The sun is below the horizon (%.0f deg): no beams can form.' % elev))\n    elif abs(az) > 120:\n        warns.append((2, 'The sun is behind the camera (%.0f deg off): beams run away from the lens and the gobo '\n                         'cannot reach. A sun-view clouds render would fix it.' % abs(az)))\n    elif abs(az) > 60:\n        warns.append((2, 'The sun is to the side (%.0f deg off): beams will be faint and the gobo only covers '\n                         'part of the frame.' % abs(az)))\n    elif elev > 55:\n        warns.append((2, 'The sun is high (%.0f deg): beams fall almost straight down and will not fan out.' % elev))\n    height = n\['cloud_height'].value()\n    cam_m = m\[7] * n\['scene_scale'].value()\n    if abs(cam_m) > 20000:\n        warns.append((1, 'Units look wrong: the camera is %.0f km up. Check \"units to metres\".' % (cam_m / 1000.0)))\n    if height <= cam_m:\n        warns.append((1, 'Cloud height (%.0f m) is at or below the camera (%.0f m): nothing can cast from there.'\n                         % (height, cam_m)))\n    elif height > 15000:\n        warns.append((1, 'Cloud height %.0f m is implausibly high. It is in metres whatever the scene units are.' % height))\n\nwarns.sort()\nstatus = warns\[0]\[1] if warns else 'OK: the sun, units and gobo all look right.'\nn\['status'].setValue(status)\nif warns:\n    notes.append('')\n    for rank, text in warns:\n        notes.append('Warning: ' + text)\nnuke.message('EzCloudShafts analyze\\n\\n' + '\\n'.join(notes))\n" +STARTLINE}
 addUserKnob {4 view t "What the main rgb shows. The passes are always written to the shafts and cloudshadow layers; Comp is the finished look (see the Comp knobs). Passthrough leaves rgba as the env render. Lit Share shows shafts_lit: 1 where the haze is sunlit, 0 under cloud." -STARTLINE M {Passthrough "Shafts Over Env" "Shadow Matte" "Gobo Check" "Shafts Matte" "Lit Share" Comp}}
 view Comp
 addUserKnob {22 layer_breakout l "layer breakout" t "Builds the Comp view from this node's layers next to it, as plain nodes: cloud shadow on the sun light, haze from shafts_lit, then the shafts. Their values follow the Comp knobs, and a Difference at the bottom is black while 'view' is Comp." T "\nn = nuke.thisNode()\nenv = n.input(0)\nif env is None:\n    nuke.message('EzCloudShafts: connect the env input first.')\nelse:\n    N = n.name()\n    col, row = 180, 60\n    x0, y0 = n.xpos() + 300, n.ypos() + 60\n    with (n.parent() or nuke.root()):\n        for other in nuke.allNodes():\n            other.setSelected(False)\n        made = \[]\n\n        def place(node, cx, cy, src=None, src2=None):\n            node.setXYpos(int(x0 + cx * col), int(y0 + cy * row))\n            if src is not None:\n                node.setInput(0, src)\n            if src2 is not None:\n                node.setInput(1, src2)\n            made.append(node)\n            return node\n\n        def dot(cx, cy, src):\n            d = nuke.nodes.Dot()\n            d.setXYpos(int(x0 + cx * col + 34), int(y0 + cy * row + 4))\n            d.setInput(0, src)\n            made.append(d)\n            return d\n\n        def pick(layer, cx, src):\n            sh = nuke.nodes.Shuffle2(name='%s_%s' % (n.name(), layer), label='%s to rgba' % layer)\n            sh\['in1'].setValue(layer)\n            return place(sh, cx, 1, src)\n\n        def expr(name, label, exprs, cx, cy, src):\n            e = nuke.nodes.Expression(name='%s_%s' % (n.name(), name), label=label)\n            for i, text in enumerate(exprs):\n                e\['expr%d' % i].setValue(text.replace('N.', N + '.'))\n            return place(e, cx, cy, src)\n\n        # Row 0: the env trunk on the left, then a row of Dots from the node, one per layer.\n        trunk = dot(0, 0, env)\n        heads = \[dot(2, 0, n)]\n        for cx in (3, 4):\n            heads.append(dot(cx, 0, heads\[-1]))\n        shadow = pick('cloudshadow', 2, heads\[0])\n        lit = pick('shafts_lit', 3, heads\[1])\n        shafts = pick('shafts', 4, heads\[2])\n\n        # Cloud shadow: take the shadowed share of the sun light away from the env.\n        if n\['use_sun_layer'].value():\n            sun_dot = dot(1, 0, trunk)\n            sun = nuke.nodes.Shuffle2(name='%s_sunlight' % n.name(), label='sun light to rgba')\n            sun\['in1'].setValue(n\['sun_layer'].value())\n            sun = place(sun, 1, 1, sun_dot)\n        else:\n            sun = dot(1, 0, trunk)\n        amount = expr('shadow_amount', 'sun lost under cloud',\n                      \['(1-a)*N.comp_shadow'] * 3 + \['a'], 2, 3, shadow)\n        lost = place(nuke.nodes.Merge2(operation='multiply', output='rgb', label='sun light x lost'),\n                     1, 3, amount, sun)\n        land = place(nuke.nodes.Merge2(operation='from', output='rgb', label='cloud shadow'), 0, 4, trunk, lost)\n\n        # Haze: transmittance from shafts_lit.a, haze light graded by the lit share.\n        trans = expr('haze_transmittance', 'T = (1 - haze) ^ amount',\n                     \['pow(clamp(1-a,0,1), N.comp_haze*N.comp_haze_falloff.%s)' % c for c in 'rgb'] + \['r'],\n                     3, 5, lit)\n        hazed = place(nuke.nodes.Merge2(operation='multiply', output='rgb', label='land x T'), 0, 6, land,\n                      dot(3, 6, trans))\n        light = expr('haze_light', 'haze colour x (1 - T) x lit grade',\n                     \['(1-%s)*N.comp_haze_color.%s*(N.comp_haze_shadow+(N.comp_haze_lit-N.comp_haze_shadow)*a)'\n                      % (c, c) for c in 'rgb'] + \['a'], 3, 7, trans)\n        with_haze = place(nuke.nodes.Merge2(operation='plus', output='rgb', label='+ haze'), 0, 8, hazed,\n                          dot(3, 8, light))\n        beams = place(nuke.nodes.Merge2(operation='plus', output='rgb', label='+ shafts'), 0, 9, with_haze,\n                      dot(4, 9, shafts))\n        beams\['mix'].setExpression(N + '.comp_shafts')\n\n        # Check against the node's own Comp view: black when 'view' is Comp.\n        check_dot = dot(5, 10, dot(5, 0, heads\[-1]))\n        check = place(nuke.nodes.Merge2(name='%s_breakout_check' % n.name(), operation='difference', output='rgb',\n                                        label='black when view is Comp'), 0, 10, beams, check_dot)\n        made.append(nuke.nodes.BackdropNode(label='%s breakout' % n.name(), note_font_size=24,\n                                            xpos=int(x0 - 60), ypos=int(y0 - 80),\n                                            bdwidth=col * 6 + 60, bdheight=row * 11 + 100))\n        for node in made:\n            node.setSelected(True)\n" -STARTLINE}
 addUserKnob {4 look t "A starting point for the haze, beams and Comp knobs. Press Analyze first, so the haze suits the scene's size, then 'apply look'. Reset puts those knobs back to their defaults." M {"Soft Morning" "God Rays" "Storm Break" "Golden Hour" Reset}}
 look "God Rays"
 addUserKnob {22 apply_look l "apply look" t "Sets the knobs from the chosen look." T "\nimport math\nn = nuke.thisNode()\nlook = n\['look'].value()\n# tau: optical depth at the scene's median distance. height: haze height as a share of it.\n# beam: target brightness of the beams.\nlooks = \{\n    'Soft Morning': dict(tau=0.5, height=0.7, beam=2.8, penumbra=0.8, steps=96, soften=6, gap=1.0,\n                         tint=\[1.0, 0.96, 0.9], haze=\[0.13, 0.17, 0.26], falloff=\[0.85, 1.0, 1.2],\n                         shadow=0.65, lit=1.2),\n    'God Rays': dict(tau=0.35, height=0.45, beam=4.0, penumbra=0.4, steps=128, soften=5, gap=1.0,\n                     tint=\[0.9, 0.95, 1.1], haze=\[0.06, 0.13, 0.33], falloff=\[0.75, 1.0, 1.4],\n                     shadow=0.35, lit=1.5),\n    'Storm Break': dict(tau=0.55, height=0.4, beam=4.0, penumbra=0.3, steps=128, soften=4, gap=2.5,\n                        tint=\[0.85, 0.93, 1.15], haze=\[0.03, 0.05, 0.11], falloff=\[0.9, 1.0, 1.15],\n                        shadow=0.2, lit=1.8),\n    'Golden Hour': dict(tau=0.4, height=0.5, beam=3.4, penumbra=0.5, steps=128, soften=5, gap=1.2,\n                        tint=\[1.25, 0.88, 0.55], haze=\[0.2, 0.12, 0.09], falloff=\[0.6, 1.0, 1.6],\n                        shadow=0.45, lit=1.6),\n\}\nif look == 'Reset':\n    for knob, value in (('shaft_density', 0.1), ('haze_height', 1.2), ('penumbra', 0.5), ('march_steps', 32),\n                        ('soften', 4), ('gap_contrast', 1), ('gap_threshold', 0.5), ('shaft_intensity', 1),\n                        ('comp_haze', 1), ('comp_haze_shadow', 0.35), ('comp_haze_lit', 1.5), ('comp_shafts', 1)):\n        n\[knob].setValue(value)\n    n\['shaft_color'].setValue(1)\n    n\['comp_haze_color'].setValue(\[0.06, 0.13, 0.33])\n    n\['comp_haze_falloff'].setValue(\[0.75, 1.0, 1.4])\nelse:\n    p = looks\[look]\n    depth = n\['scene_depth'].value()\n    if depth <= 0:\n        depth = 3.0\n        nuke.message('This look used a guessed scene depth of 3 km. Press Analyze, then apply it again.')\n    # How bright the beams' colour is along the sun, so the look doesn't depend on the atmos's level.\n    level = 1.0\n    if int(n\['color_from'].getValue()) == 0 and n\['atm_found'].value():\n        sun = \[n\['sun_in_use'].value(i) for i in range(3)]\n        norm = math.sqrt(sun\[0] ** 2 + sun\[1] ** 2 + sun\[2] ** 2) or 1.0\n        with n:\n            src = nuke.toNode('AtmosOrNone')\n            if n\['atm_screen'].value():\n                u, v = 0.5, 0.9\n            else:\n                lon = math.atan2(sun\[0], -sun\[2]) - math.radians(n\['atm_rotation'].value())\n                u = (lon / (2 * math.pi) + 0.5) % 1.0\n                v = math.asin(max(-1.0, min(1.0, sun\[1] / norm))) / math.pi + 0.5\n            level = max(src.sample('green', u * src.width(), v * src.height()), 1e-3)\n    n\['shaft_density'].setValue(round(p\['tau'] / depth, 4))\n    n\['haze_height'].setValue(round(min(5.0, max(0.2, p\['height'] * depth)), 2))\n    n\['penumbra'].setValue(p\['penumbra'])\n    n\['march_steps'].setValue(p\['steps'])\n    n\['soften'].setValue(p\['soften'])\n    n\['gap_contrast'].setValue(p\['gap'])\n    n\['gap_threshold'].setValue(0.5)\n    n\['shaft_color'].setValue(p\['tint'])\n    n\['shaft_intensity'].setValue(round(p\['beam'] / level, 4))\n    n\['comp_haze'].setValue(1)\n    n\['comp_haze_color'].setValue(p\['haze'])\n    n\['comp_haze_falloff'].setValue(p\['falloff'])\n    n\['comp_haze_shadow'].setValue(p\['shadow'])\n    n\['comp_haze_lit'].setValue(p\['lit'])\n    n\['comp_shafts'].setValue(1)\n" -STARTLINE}
 addUserKnob {1 status t "The main warning from the last Analyze. It doesn't update by itself: press Analyze again." +DISABLED}
 status "Press Analyze to check the setup."
 addUserKnob {7 scene_depth +INVISIBLE}
 addUserKnob {4 viewer_resolution l "viewer resolution" t "Size the passes are computed at in the Nuke GUI, then scaled back up. Half is about four times faster than Full. Renders from a terminal or the farm use 'render resolution'." M {Full Half Quarter}}
 viewer_resolution Half
 addUserKnob {4 render_resolution l "render resolution" t "Size the passes are computed at when rendering outside the GUI (terminal, farm)." -STARTLINE M {Full Half Quarter}}
 addUserKnob {4 shafts_resolution l "shafts at" t "The shafts are soft, so they can be computed smaller again than the ground matte: Half of the viewer or render resolution is four times faster and rarely shows." -STARTLINE M {Same Half Quarter}}
 shafts_resolution Half
 addUserKnob {7 matte_scale +INVISIBLE}
 matte_scale {{"(\$gui ? viewer_resolution : render_resolution) == 0 ? 1 : (\$gui ? viewer_resolution : render_resolution) == 1 ? 0.5 : 0.25"}}
 addUserKnob {7 shafts_scale +INVISIBLE}
 shafts_scale {{"matte_scale * (shafts_resolution == 0 ? 1 : shafts_resolution == 1 ? 0.5 : 0.25)"}}
 addUserKnob {26 inputs_divider l Inputs}
 addUserKnob {41 position_layer l "position layer" t "Layer of the env render holding world position (P World), in scene units." T PositionPick.in1}
 addUserKnob {1 clouds_depth l "clouds depth" t "Channel of the clouds input holding its depth (Planar Z, scene units). Only analyze reads it."}
 clouds_depth depth.Z
 addUserKnob {7 scene_scale l "units to metres" t "Scene units to metres: 0.1 for decimetres. Analyze takes it from the EzAtmosScatter in 'atmos'." R 0 1}
 scene_scale 0.1
 addUserKnob {26 sun_divider l Sun}
 addUserKnob {4 sun_from l "sun from" t "Auto: the Axis in the 'sun' input if there is one, else the EzAtmosScatter in 'atmos', else 'sun direction'. The Axis's world position is the direction towards the sun." M {Auto "Sun Input (Axis)" EzAtmosScatter Manual}}
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up, used when there is no Axis or atmos (or 'sun from' is Manual)."}
 sun_direction {0 0.5 -1}
 addUserKnob {13 sun_in_use l "sun in use" t "The sun direction in use, whichever 'sun from' picked. Read only." +DISABLED}
 addUserKnob {7 sun_rotation_in_use l "sun rotation" +INVISIBLE}
 addUserKnob {26 clouds_divider l "Cloud gobo"}
 addUserKnob {7 cloud_height l "cloud height (m)" t "Height of the cloud sheet above the scene's 0, in metres. Analyze measures it from the clouds' depth; raise or lower it to slide the shadows along the sun." R 0 8000}
 cloud_height 2000
 addUserKnob {7 cloud_density l "cloud density" t "Multiplies the clouds alpha: above 1 thin cloud blocks more sun." R 0 3}
 cloud_density 1
 addUserKnob {7 gap_contrast l "gap contrast" t "Levels on the clouds' alpha before it is used as the gobo. Above 1 thin, soft clouds become more clearly solid or clear, for crisper beams. 1 with threshold 0.5 changes nothing." R 0.1 10}
 gap_contrast 1
 addUserKnob {7 gap_threshold l "gap threshold" t "The alpha that stays at 0.5 under 'gap contrast'. Higher opens more gaps; lower closes them."}
 gap_threshold 0.5
 addUserKnob {7 shadow_strength l "shadow strength" t "How much sunlight the cloud takes away: 1 is all of it."}
 shadow_strength 1
 addUserKnob {4 outside_frame l "outside frame" t "Where the sun ray meets the cloud sheet outside the clouds render (past its overscan), as the camera sees it: count it as a gap (Lit) or as cloud (Shadowed)." M {Lit Shadowed}}
 addUserKnob {7 penumbra l "softness (deg)" t "Spreads the sun over a cone this wide, so shadow edges soften the further they fall from the cloud. The real sun is about 0.27." R 0 5}
 penumbra 0.5
 addUserKnob {3 samples l "softness samples" t "Sun directions averaged for the ground matte. More is smoother and slower."}
 samples 6
 addUserKnob {7 drift_x l "drift x (m/frame)" t "Moves the cloud shadows across the ground over time, for clouds rendered still." R -20 20}
 addUserKnob {7 drift_z l "drift z (m/frame)" t "Moves the cloud shadows across the ground over time, for clouds rendered still." R -20 20}
 addUserKnob {3 drift_frame l "drift from frame" t "The frame where the drift is 0."}
 drift_frame 1001
 addUserKnob {26 shafts_divider l Shafts}
 addUserKnob {7 shaft_density l "haze density (1/km)" t "How much the air in front of the terrain scatters the sun at camera height: more gives stronger beams. 0.1 is light haze." R 0 1}
 shaft_density 0.1
 addUserKnob {7 haze_height l "haze height (km)" t "Height over which the haze thins out by a factor of e." R 0.1 5}
 haze_height 1.2
 addUserKnob {7 shaft_start l "start (m)" t "Air nearer than this has no beams." R 0 2000}
 addUserKnob {7 max_distance l "max distance (km)" t "Air further than this has no beams. 0 runs to the terrain." R 0 50}
 addUserKnob {7 sky_distance l "sky distance (km)" t "How far the beams reach where there is no terrain (sky), if the cloud sheet is not met first." R 1 100}
 sky_distance 20
 addUserKnob {3 march_steps l steps t "Steps along each view ray. More gives cleaner beams and is slower."}
 march_steps 32
 addUserKnob {4 color_from l "colour from" t "EzAtmosScatter: the sunlit haze colour of the atmos input (atmos_haze_sun along the view), times 'shaft color'. Color: 'shaft color' alone. Without an atmos input it is Color." M {EzAtmosScatter Color}}
 addUserKnob {18 shaft_color l "shaft color" t "Colour of the beams, or a tint on the atmos colour."}
 shaft_color 1
 addUserKnob {7 shaft_intensity l intensity t "Multiplies the beams, rgb and matte." R 0 10}
 shaft_intensity 1
 addUserKnob {7 soften l "soften (px)" t "Blurs the shafts and shafts_lit layers to take out the sampling grain of long rays. 0 is off." R 0 20}
 soften 4
 addUserKnob {6 edge_aware l "edge aware" t "Keeps the softening from blurring beams across ridge lines, using the distance to the camera from the position layer. Off is a plain blur, which is a little faster." -STARTLINE}
 edge_aware true
 addUserKnob {26 comp_divider l Comp}
 addUserKnob {7 comp_shadow l "cloud shadow" t "How much of the sun light the cloud shadow takes off the env: 0 none, 1 all of it. Use 1 with a sun light layer; without one the whole env is darkened, so keep it lower."}
 comp_shadow 0.7
 addUserKnob {6 use_sun_layer l "sun light layer" t "On: the cloud shadow only darkens the env's sun light group, picked on the right (the beauty must be the sum of its light groups). Off: it darkens the whole env." +STARTLINE}
 addUserKnob {41 sun_layer l "" t "Layer of the env render holding the sun's light group." -STARTLINE T SunPick.in1}
 addUserKnob {7 comp_haze l "haze amount" t "How strongly the haze veils the env with distance. 0 is no haze: only the shadow and the shafts." R 0 3}
 comp_haze 1
 addUserKnob {18 comp_haze_color l "haze color" t "Colour of the haze light."}
 comp_haze_color {0.06 0.13 0.33}
 addUserKnob {18 comp_haze_falloff l "haze falloff" t "How fast each colour fades with distance: higher fades sooner. Blue above red gives the warm near, blue far of aerial perspective."}
 comp_haze_falloff {0.75 1 1.4}
 addUserKnob {7 comp_haze_shadow l "haze in shadow" t "Brightness of the haze where the cloud shades it: below 1 darkens the air between the beams." R 0 2}
 comp_haze_shadow 0.35
 addUserKnob {7 comp_haze_lit l "haze in sun" t "Brightness of the haze where the sun reaches it." R 0 4}
 comp_haze_lit 1.5
 addUserKnob {7 comp_shafts l "shafts" t "How much of shafts.rgb is added on top." R 0 2}
 comp_shafts 1
 addUserKnob {26 version_divider l "" +STARTLINE}
 addUserKnob {26 version T "EzCloudShafts v1.0.0"}
 addUserKnob {78 cam_world_matrix l "camera matrix" +INVISIBLE n 16}
 cam_world_matrix {{"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 0) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 1) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 2) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 3) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 4) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 5) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 6) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 7) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 8) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 9) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 10) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 11) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 12) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 13) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 14) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 15) if c is not None else 1\}]"}}
 addUserKnob {7 cam_focal +INVISIBLE}
 cam_focal {{"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['focal'].getValueAt(nuke.frame()) if c is not None else 35\}]"}}
 addUserKnob {7 cam_haperture +INVISIBLE}
 cam_haperture {{"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['haperture'].getValueAt(nuke.frame()) if c is not None else 36\}]"}}
 addUserKnob {7 cam_vaperture +INVISIBLE}
 cam_vaperture {{"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['vaperture'].getValueAt(nuke.frame()) if c is not None else 20.25\}]"}}
 addUserKnob {3 atm_found +INVISIBLE}
 atm_found {{"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 1 if a is not None else 0\}]"}}
 addUserKnob {13 atm_sun +INVISIBLE}
 atm_sun {{"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 0) if a is not None else 0\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 1) if a is not None else 0\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 2) if a is not None else 0\}]"}}
 addUserKnob {7 atm_rotation +INVISIBLE}
 atm_rotation {{"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = a\['hdri_rotation'].getValueAt(nuke.frame()) if a is not None and a.knob('hdri_rotation') else 0\}]"}}
 addUserKnob {3 atm_screen +INVISIBLE}
 atm_screen {{"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 1 if a is not None and a.knob('output_mapping') and int(a\['output_mapping'].getValue()) == 2 else 0\}]"}}
 addUserKnob {3 axis_found +INVISIBLE}
 axis_found {{"\[python -execlocal \{x = nuke.thisNode().input(4)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = 1 if x is not None else 0\}]"}}
 addUserKnob {13 axis_position +INVISIBLE}
 axis_position {{"\[python -execlocal \{x = nuke.thisNode().input(4)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 3) if x is not None else 0\}]"} {"\[python -execlocal \{x = nuke.thisNode().input(4)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 7) if x is not None else 0\}]"} {"\[python -execlocal \{x = nuke.thisNode().input(4)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 11) if x is not None else 0\}]"}}
 addUserKnob {3 sun_source +INVISIBLE}
 sun_source {{"sun_from==1 ? (axis_found ? 1 : 0) : sun_from==2 ? (atm_found ? 2 : 0) : sun_from==3 ? 0 : (axis_found ? 1 : atm_found ? 2 : 0)"}}
 sun_in_use {{"sun_source==1 ? axis_position.x : sun_source==2 ? atm_sun.x : sun_direction.x"} {"sun_source==1 ? axis_position.y : sun_source==2 ? atm_sun.y : sun_direction.y"} {"sun_source==1 ? axis_position.z : sun_source==2 ? atm_sun.z : sun_direction.z"}}
 sun_rotation_in_use {{"sun_source==2 ? atm_rotation : 0"}}
}
