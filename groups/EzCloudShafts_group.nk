  recompileCount 1
  KernelDescription "3 \"EzCloudShafts\" iterate pixelWise 67d872eeac81e9d07e28e119c87f04ed446eddbcd0a341d9acdc54fc8533999c 6 \"pos\" Read Point \"clouds\" Read Random \"envSun\" Read Random \"sunClouds\" Read Random \"sunMap\" Read Random \"dst\" Write Point 43 \"output\" Int 1 AAAAAA== \"cam_row0\" Float 3 AACAPwAAAAAAAAAAAAAAAA== \"cam_row1\" Float 3 AAAAAAAAgD8AAAAAAAAAAA== \"cam_row2\" Float 3 AAAAAAAAAAAAAIA/AAAAAA== \"cam_position\" Float 3 AAAAAAAAAAAAAAAAAAAAAA== \"focal\" Float 1 AAAMQg== \"haperture\" Float 1 AAAQQg== \"vaperture\" Float 1 AACiQQ== \"frame_size\" Float 2 AADwRAAAh0Q= \"scene_scale\" Float 1 zczMPQ== \"clouds_size\" Float 2 AADwRAAAh0Q= \"clouds_overscan\" Float 2 AAAAAAAAAAA= \"sun_direction\" Float 3 AAAAAAAAAD8AAIC/AAAAAA== \"sun_rotation\" Float 1 AAAAAA== \"cloud_height\" Float 1 AAD6RA== \"cloud_density\" Float 1 AACAPw== \"shadow_strength\" Float 1 AACAPw== \"outside_lit\" Int 1 AQAAAA== \"drift\" Float 2 AAAAAAAAAAA= \"penumbra\" Float 1 AAAAPw== \"samples\" Int 1 CAAAAA== \"shaft_density\" Float 1 F7fROA== \"haze_height\" Float 1 AACWRA== \"shaft_start\" Float 1 AAAAAA== \"max_distance\" Float 1 AAAAAA== \"sky_distance\" Float 1 AECcRg== \"march_steps\" Int 1 MAAAAA== \"use_env\" Int 1 AAAAAA== \"env_screen\" Int 1 AAAAAA== \"env_rotation\" Float 1 AAAAAA== \"shaft_color\" Float 3 AACAP2ZmZj8AAEA/AAAAAA== \"shaft_intensity\" Float 1 AACAPw== \"seed\" Float 1 AACAPw== \"use_depth\" Int 1 AAAAAA== \"use_sun_view\" Int 1 AAAAAA== \"sun_row0\" Float 3 AACAPwAAAAAAAAAAAAAAAA== \"sun_row1\" Float 3 AAAAAAAAgD8AAAAAAAAAAA== \"sun_row2\" Float 3 AAAAAAAAAAAAAIA/AAAAAA== \"sun_position\" Float 3 AAAAAAAAAAAAAAAAAAAAAA== \"sun_width\" Float 1 AFDDRw== \"use_sun_map\" Int 1 AAAAAA== \"sun_map_size\" Float 1 AEAcRg== \"ground_height\" Float 1 AAAAAA== 43 \"output\" 1 1 Default \"camRow0\" 3 1 Default \"camRow1\" 3 1 Default \"camRow2\" 3 1 Default \"camPosition\" 3 1 Default \"focal\" 1 1 Default \"haperture\" 1 1 Default \"vaperture\" 1 1 Default \"frameSize\" 2 1 Default \"sceneScale\" 1 1 Default \"cloudsSize\" 2 1 Default \"cloudsOverscan\" 2 1 Default \"sunDirection\" 3 1 Default \"sunRotation\" 1 1 Default \"cloudHeight\" 1 1 Default \"cloudDensity\" 1 1 Default \"shadowStrength\" 1 1 Default \"outsideLit\" 1 1 Default \"drift\" 2 1 Default \"penumbra\" 1 1 Default \"samples\" 1 1 Default \"shaftDensity\" 1 1 Default \"hazeHeight\" 1 1 Default \"shaftStart\" 1 1 Default \"maxDistance\" 1 1 Default \"skyDistance\" 1 1 Default \"marchSteps\" 1 1 Default \"useEnv\" 1 1 Default \"envScreen\" 1 1 Default \"envRotation\" 1 1 Default \"shaftColor\" 3 1 Default \"shaftIntensity\" 1 1 Default \"seed\" 1 1 Default \"useDepth\" 1 1 Default \"useSunView\" 1 1 Default \"sunRow0\" 3 1 Default \"sunRow1\" 3 1 Default \"sunRow2\" 3 1 Default \"sunPosition\" 3 1 Default \"sunWidth\" 1 1 Default \"useSunMap\" 1 1 Default \"sunMapSize\" 1 1 Default \"groundHeight\" 1 1 Default 4 \"pi\" Float 1 1 AAAAAA== \"sunWorld\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"sunX\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"sunY\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA=="
  kernelSource "// EzCloudShafts: sun shafts and a ground cloud-shadow matte from a CG clouds render used as a\n// gobo, seen through the shot camera.\n//\n// The clouds are treated as a sheet at cloudHeight (metres, +Y up). For a world point p below\n// it, the ray towards the sun meets the sheet at\n//\n//   hit = p + sun * (cloudHeight - p.y) / sun.y\n//\n// and the hit is projected through the shot camera into the clouds image. Its alpha is how\n// much of the sun the cloud stops there: lit = 1 - shadowStrength * clamp(alpha * cloudDensity).\n// The sun direction is spread over a small cone (penumbra) and averaged, so shadow edges soften\n// with the distance to the cloud, as real ones do.\n//\n// output 0, shafts: each camera ray is stepped from the lens to the surface (or to the cloud\n//   sheet, for sky), through haze of density shaftDensity at camera height that thins with\n//   height over hazeHeight. A step adds its in-scatter when the gobo lets the sun through.\n//   rgb = that in-scatter coloured by the sun (EzAtmosScatter's atmos_haze_sun along the view\n//   ray, or shaftColor), alpha = the same without colour, as a matte.\n// output 2, lit share: the same march; rgb = the share of the ray's haze in-scatter that is\n//   sunlit (1 all lit, 0 all under cloud), whatever the haze amount, to grade the haze up in\n//   the beams and down in the shadowed air. alpha = the haze in-scatter, lit or not (0..1).\n// output 3, view colour: rgb = `envSun` looked up along each view ray, with no march, for the\n//   atmos's sky haze colour in the camera's view.\n// output 1, ground: rgb = the gobo at the surface from the sun's centre, unsoftened (to check\n//   alignment), alpha = the softened sun visibility, 1 lit, 0 under cloud. Sky is 1.\n//\n// frameSize is the size of `pos`'s format: the camera frame, for the view rays of sky pixels.\n// The passes can run on a scaled-down `pos` (impulse filtered) and be scaled back up after.\n//\n// Inputs: `pos` world position (P) in scene units in rgb, 0 for sky. `clouds` the flattened\n// clouds render, alpha = opacity, in the shot camera's view (overscan in its bbox, or baked\n// into a bigger format: cloudsOverscan). `envSun` EzAtmosScatter's atmos_haze_sun, lat-long\n// (or the camera's view with envScreen). Scene units turn into metres with sceneScale.\n//\n// useDepth: the clouds' red holds their Planar Z (scene units). The height where the sun ray\n// meets the cloud is then refined from it, so tall clouds cast from their real height.\n// useSunView: `sunClouds` is the clouds' opacity from an orthographic camera looking along the\n// sun (sunRow*, sunPosition, sunWidth in scene units), and is used instead of `clouds`: it has no\n// in-frame limit. The sun ray still meets the sheet first, so softness works the same.\n// useSunMap: `sunMap` is EzCloudGen's cloud_sunmap layer: for each ground point around the\n// camera (sunMapSize sets its reach), the clouds' optical depth along the sun ray in red, and\n// that times the mean altitude (km) and mean squared altitude in green and blue. The clouds are\n// then real volumes, not a sheet: a point is shaded by the part of the optical depth above its\n// own altitude, so tall clouds, clouds outside the frame and the air above a low deck all come\n// out right. cloudHeight is not used.\n\nkernel EzCloudShafts : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> pos;\n  Image<eRead, eAccessRandom, eEdgeClamped> clouds;\n  Image<eRead, eAccessRandom, eEdgeClamped> envSun;\n  Image<eRead, eAccessRandom, eEdgeClamped> sunClouds;\n  Image<eRead, eAccessRandom, eEdgeClamped> sunMap;\n  Image<eWrite> dst;\n\nparam:\n  int output;\n  float3 camRow0;\n  float3 camRow1;\n  float3 camRow2;\n  float3 camPosition;\n  float focal;\n  float haperture;\n  float vaperture;\n  float2 frameSize;\n  float sceneScale;\n  float2 cloudsSize;\n  float2 cloudsOverscan;\n  float3 sunDirection;\n  float sunRotation;\n  float cloudHeight;\n  float cloudDensity;\n  float shadowStrength;\n  int outsideLit;\n  float2 drift;\n  float penumbra;\n  int samples;\n  float shaftDensity;\n  float hazeHeight;\n  float shaftStart;\n  float maxDistance;\n  float skyDistance;\n  int marchSteps;\n  int useEnv;\n  int envScreen;\n  float envRotation;\n  float3 shaftColor;\n  float shaftIntensity;\n  float seed;\n  int useDepth;\n  int useSunView;\n  float3 sunRow0;\n  float3 sunRow1;\n  float3 sunRow2;\n  float3 sunPosition;\n  float sunWidth;\n  int useSunMap;\n  float sunMapSize;\n  float groundHeight;\n\nlocal:\n  float pi;\n  float3 sunWorld;\n  float3 sunX;\n  float3 sunY;\n\n  void define()\n  \{\n    defineParam(output, \"output\", 0);\n    defineParam(camRow0, \"cam_row0\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(camRow1, \"cam_row1\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(camRow2, \"cam_row2\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(camPosition, \"cam_position\", float3(0.0f, 0.0f, 0.0f));\n    defineParam(focal, \"focal\", 35.0f);\n    defineParam(haperture, \"haperture\", 36.0f);\n    defineParam(vaperture, \"vaperture\", 20.25f);\n    defineParam(frameSize, \"frame_size\", float2(1920.0f, 1080.0f));\n    defineParam(sceneScale, \"scene_scale\", 0.1f);\n    defineParam(cloudsSize, \"clouds_size\", float2(1920.0f, 1080.0f));\n    defineParam(cloudsOverscan, \"clouds_overscan\", float2(0.0f, 0.0f));\n    defineParam(sunDirection, \"sun_direction\", float3(0.0f, 0.5f, -1.0f));\n    defineParam(sunRotation, \"sun_rotation\", 0.0f);\n    defineParam(cloudHeight, \"cloud_height\", 2000.0f);\n    defineParam(cloudDensity, \"cloud_density\", 1.0f);\n    defineParam(shadowStrength, \"shadow_strength\", 1.0f);\n    defineParam(outsideLit, \"outside_lit\", 1);\n    defineParam(drift, \"drift\", float2(0.0f, 0.0f));\n    defineParam(penumbra, \"penumbra\", 0.5f);\n    defineParam(samples, \"samples\", 8);\n    defineParam(shaftDensity, \"shaft_density\", 0.0001f);\n    defineParam(hazeHeight, \"haze_height\", 1200.0f);\n    defineParam(shaftStart, \"shaft_start\", 0.0f);\n    defineParam(maxDistance, \"max_distance\", 0.0f);\n    defineParam(skyDistance, \"sky_distance\", 20000.0f);\n    defineParam(marchSteps, \"march_steps\", 48);\n    defineParam(useEnv, \"use_env\", 0);\n    defineParam(envScreen, \"env_screen\", 0);\n    defineParam(envRotation, \"env_rotation\", 0.0f);\n    defineParam(shaftColor, \"shaft_color\", float3(1.0f, 0.9f, 0.75f));\n    defineParam(shaftIntensity, \"shaft_intensity\", 1.0f);\n    defineParam(seed, \"seed\", 1.0f);\n    defineParam(useDepth, \"use_depth\", 0);\n    defineParam(useSunView, \"use_sun_view\", 0);\n    defineParam(sunRow0, \"sun_row0\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(sunRow1, \"sun_row1\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(sunRow2, \"sun_row2\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(sunPosition, \"sun_position\", float3(0.0f, 0.0f, 0.0f));\n    defineParam(sunWidth, \"sun_width\", 100000.0f);\n    defineParam(useSunMap, \"use_sun_map\", 0);\n    defineParam(sunMapSize, \"sun_map_size\", 10000.0f);\n    defineParam(groundHeight, \"ground_height\", 0.0f);\n  \}\n\n  void init()\n  \{\n    pi = 3.14159265358979f;\n    // An EzAtmosScatter sun is in its lat-long's frame, turned by its hdri rotation.\n    float a = -sunRotation * pi / 180.0f;\n    float3 sd = normalize(sunDirection);\n    sunWorld = float3(sd.x * cos(a) + sd.z * sin(a), sd.y, -sd.x * sin(a) + sd.z * cos(a));\n    float3 up = fabs(sunWorld.y) < 0.9f ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f);\n    sunX = normalize(cross(up, sunWorld));\n    sunY = cross(sunWorld, sunX);\n  \}\n\n  // Per-pixel jitter: interleaved gradient noise with a golden-ratio offset per use.\n  float jitterAt(int2 p, float k)\n  \{\n    float g = 52.9829189f * (0.06711056f * p.x + 0.00583715f * p.y);\n    g = g - floor(g);\n    float v = g + k * 0.6180339887f + seed * 0.1234f;\n    return v - floor(v);\n  \}\n\n  // The sun direction spread over a cone of radius `penumbra` degrees.\n  float3 jitteredSun(float j1, float j2)\n  \{\n    float r = penumbra * pi / 180.0f * sqrt(j1);\n    float a = 2.0f * pi * j2;\n    return normalize(sunWorld + sunX * (r * cos(a)) + sunY * (r * sin(a)));\n  \}\n\n  float3 cameraOrigin()\n  \{\n    return camPosition * sceneScale;\n  \}\n\n  // View ray of the plate pixel at (u, v) in 0..1 of the format.\n  float3 viewDir(float u, float v)\n  \{\n    float3 c = float3((u - 0.5f) * haperture / focal, (v - 0.5f) * vaperture / focal, -1.0f);\n    return normalize(float3(dot(camRow0, c), dot(camRow1, c), dot(camRow2, c)));\n  \}\n\n  // Opacity of the cloud the sun passes through on its way to p: 0 clear, 1 blocked.\n  // `inside` is set to 0 when the hit lands outside the clouds image.\n  float cloudOpacity(float3 p, float3 sun, float &inside)\n  \{\n    inside = 1.0f;\n    if (useSunMap != 0) \{\n      if (sun.y <= 0.01f) \{\n        inside = 0.0f;\n        return 0.0f;\n      \}\n      // The ground point this sun ray comes up from, in metres around the camera.\n      float3 o = cameraOrigin();\n      float qy = p.y - groundHeight * sceneScale;\n      float gx = p.x - drift.x - o.x - sun.x / sun.y * qy;\n      float gz = p.z - drift.y - o.z - sun.z / sun.y * qy;\n      float k = 1.0f / (sqrt(gx * gx + gz * gz) + sunMapSize);\n      float w = sunMap.bounds.width();\n      float h = sunMap.bounds.height();\n      float4 m = bilinear(sunMap, sunMap.bounds.x1 + (gx * k * 0.5f + 0.5f) * w - 0.5f,\n                          sunMap.bounds.y1 + (gz * k * 0.5f + 0.5f) * h - 0.5f);\n      float tau = m.x;\n      if (tau < 1e-4f)\n        return 0.0f;\n      // The cloud on this ray as a slab around its mean altitude: p is shaded by what is above it.\n      float mean = m.y / tau;\n      float hw = sqrt(3.0f * max(m.z / tau - mean * mean, 0.0f)) + 0.02f;\n      float f = clamp((qy * 0.001f - (mean - hw)) / (2.0f * hw), 0.0f, 1.0f);\n      return clamp(1.0f - exp(-tau * (1.0f - f) * cloudDensity), 0.0f, 1.0f);\n    \}\n    if (p.y >= cloudHeight)\n      return 0.0f;\n    if (sun.y <= 0.01f) \{\n      inside = 0.0f;\n      return 0.0f;\n    \}\n    float height = cloudHeight;\n    if (useSunView != 0) \{\n      float3 hit = p + sun * ((height - p.y) / sun.y);\n      hit = float3(hit.x - drift.x, hit.y, hit.z - drift.y);\n      float3 d = hit - sunPosition * sceneScale;\n      float sx = sunRow0.x * d.x + sunRow1.x * d.y + sunRow2.x * d.z;\n      float sy = sunRow0.y * d.x + sunRow1.y * d.y + sunRow2.y * d.z;\n      float w = sunClouds.bounds.width();\n      float perMetre = w / (sunWidth * sceneScale);\n      float x = sunClouds.bounds.x1 + 0.5f * w + sx * perMetre;\n      float y = sunClouds.bounds.y1 + 0.5f * sunClouds.bounds.height() + sy * perMetre;\n      if (x < sunClouds.bounds.x1 || x >= sunClouds.bounds.x2 || y < sunClouds.bounds.y1 || y >= sunClouds.bounds.y2) \{\n        inside = 0.0f;\n        return 0.0f;\n      \}\n      return clamp(bilinear(sunClouds, x - 0.5f, y - 0.5f).w * cloudDensity, 0.0f, 1.0f);\n    \}\n    // With the clouds' depth, look again from the height the first lookup found.\n    int passes = useDepth != 0 ? 3 : 1;\n    float a = 0.0f;\n    for (int pass = 0; pass < passes; pass++) \{\n      float3 hit = p + sun * ((height - p.y) / sun.y);\n      hit = float3(hit.x - drift.x, hit.y, hit.z - drift.y);\n      float3 d = hit - cameraOrigin();\n      // Into camera space with the transpose of the camera rotation.\n      float cx = camRow0.x * d.x + camRow1.x * d.y + camRow2.x * d.z;\n      float cy = camRow0.y * d.x + camRow1.y * d.y + camRow2.y * d.z;\n      float cz = camRow0.z * d.x + camRow1.z * d.y + camRow2.z * d.z;\n      if (cz > -1e-3f) \{\n        inside = 0.0f;\n        return 0.0f;\n      \}\n      float u = 0.5f + (cx / -cz) * focal / haperture;\n      float v = 0.5f + (cy / -cz) * focal / vaperture;\n      // The format is the camera's frame; overscan baked into a bigger format sits around it.\n      float x = cloudsOverscan.x + u * (cloudsSize.x - 2.0f * cloudsOverscan.x);\n      float y = cloudsOverscan.y + v * (cloudsSize.y - 2.0f * cloudsOverscan.y);\n      if (x < clouds.bounds.x1 || x >= clouds.bounds.x2 || y < clouds.bounds.y1 || y >= clouds.bounds.y2) \{\n        inside = 0.0f;\n        return 0.0f;\n      \}\n      float4 c = bilinear(clouds, x - 0.5f, y - 0.5f);\n      a = c.w;\n      if (pass + 1 < passes) \{\n        if (c.x <= 0.0f || a < 0.5f)\n          break;\n        float z = c.x * sceneScale;\n        float vy = (v - 0.5f) * vaperture / focal;\n        float ux = (u - 0.5f) * haperture / focal;\n        float next = cameraOrigin().y + z * (camRow1.x * ux + camRow1.y * vy - camRow1.z);\n        if (next <= p.y + 1.0f)\n          break;\n        height = next;\n      \}\n    \}\n    return clamp(a * cloudDensity, 0.0f, 1.0f);\n  \}\n\n  // Share of the sun that reaches p through the clouds: 1 lit, 0 under cloud.\n  float sunThrough(float3 p, float3 sun)\n  \{\n    float inside;\n    float o = cloudOpacity(p, sun, inside);\n    if (inside == 0.0f)\n      return outsideLit != 0 ? 1.0f : 1.0f - shadowStrength;\n    return 1.0f - shadowStrength * o;\n  \}\n\n  float2 latlongUV(float3 d)\n  \{\n    float lon = atan2(d.x, -d.z) - envRotation * pi / 180.0f;\n    float lat = asin(clamp(d.y, -1.0f, 1.0f));\n    float u = lon / (2.0f * pi) + 0.5f;\n    return float2(u - floor(u), lat / pi + 0.5f);\n  \}\n\n  float3 sunLight(float3 d, float2 screen)\n  \{\n    if (useEnv == 0)\n      return shaftColor;\n    float2 uv = envScreen != 0 ? screen : latlongUV(d);\n    float4 c = bilinear(envSun, envSun.bounds.x1 + uv.x * envSun.bounds.width() - 0.5f,\n                        envSun.bounds.y1 + uv.y * envSun.bounds.height() - 0.5f);\n    return float3(c.x, c.y, c.z) * shaftColor;\n  \}\n\n  void process(int2 xy)\n  \{\n    float4 P = pos();\n    // The camera frame is the format (frameSize), not the bbox, which may hold overscan.\n    float u = (xy.x + 0.5f) / frameSize.x;\n    float v = (xy.y + 0.5f) / frameSize.y;\n    float3 origin = cameraOrigin();\n    bool sky = P.x == 0.0f && P.y == 0.0f && P.z == 0.0f;\n    float3 surface = float3(P.x, P.y, P.z) * sceneScale;\n    float3 dir = sky ? viewDir(u, v) : normalize(surface - origin);\n    float dist = sky ? skyDistance : length(surface - origin);\n\n    if (output == 3) \{\n      float3 c = sunLight(dir, float2(u, v));\n      dst() = float4(c.x, c.y, c.z, 1.0f);\n      return;\n    \}\n\n    if (output == 1) \{\n      // Sky counts as lit, so a matte scaled up from a smaller size has no dark rims on ridges.\n      if (sky) \{\n        dst() = float4(1.0f);\n        return;\n      \}\n      float raw = sunThrough(surface, sunWorld);\n      float lit = 0.0f;\n      int n = samples > 1 ? samples : 1;\n      for (int k = 0; k < n; k++)\n        lit += sunThrough(surface, jitteredSun((k + jitterAt(xy, 3.0f)) / n, jitterAt(xy, 5.0f + k)));\n      lit /= n;\n      dst() = float4(raw, raw, raw, lit);\n      return;\n    \}\n\n    // Shafts: march the air from shaftStart to the surface, stopping at the cloud sheet.\n    if (maxDistance > 0.0f)\n      dist = min(dist, maxDistance);\n    if (useSunMap == 0 && dir.y > 1e-4f && origin.y < cloudHeight)\n      dist = min(dist, (cloudHeight - origin.y) / dir.y);\n    float s = min(shaftStart, dist);\n    float3 light = sunLight(dir, float2(u, v));\n    float transmittance = 1.0f;\n    float lit = 0.0f;\n    float haze = 0.0f;\n    float tPrev = s;\n    int steps = marchSteps > 1 ? marchSteps : 1;\n    float jitter = jitterAt(xy, 17.0f);\n    for (int i = 1; i <= steps; i++) \{\n      // Quadratic spacing packs the steps near the camera, where beams are largest.\n      float f = (i - 1 + jitter) / steps;\n      float t = i < steps ? s + (dist - s) * f * f : dist;\n      if (t <= tPrev)\n        continue;\n      float tMid = 0.5f * (tPrev + t);\n      float3 p = origin + dir * tMid;\n      float sigma = shaftDensity * exp(-(p.y - origin.y) / hazeHeight) * (t - tPrev);\n      float scatter = transmittance * (1.0f - exp(-sigma));\n      float3 sun = jitteredSun(jitterAt(xy, 29.0f + i), jitterAt(xy, 31.0f + i));\n      lit += scatter * sunThrough(p, sun);\n      haze += scatter;\n      transmittance *= exp(-sigma);\n      tPrev = t;\n    \}\n    if (output == 2) \{\n      float share = haze > 1e-6f ? lit / haze : 1.0f;\n      dst() = float4(share, share, share, haze);\n      return;\n    \}\n    float m = lit * shaftIntensity;\n    float3 rgb = light * m;\n    dst() = float4(rgb.x, rgb.y, rgb.z, m);\n  \}\n\};\n"
  rebuild ""
  EzCloudShafts_output 3
  EzCloudShafts_cam_row0 {{parent.cam_world_matrix.0} {parent.cam_world_matrix.1} {parent.cam_world_matrix.2}}
  EzCloudShafts_cam_row1 {{parent.cam_world_matrix.4} {parent.cam_world_matrix.5} {parent.cam_world_matrix.6}}
  EzCloudShafts_cam_row2 {{parent.cam_world_matrix.8} {parent.cam_world_matrix.9} {parent.cam_world_matrix.10}}
  EzCloudShafts_cam_position {{parent.cam_world_matrix.3} {parent.cam_world_matrix.7} {parent.cam_world_matrix.11}}
  EzCloudShafts_focal {{parent.cam_focal}}
  EzCloudShafts_haperture {{parent.cam_haperture}}
  EzCloudShafts_vaperture {{parent.cam_vaperture}}
  EzCloudShafts_frame_size {{WorkPosShafts.width} {WorkPosShafts.height}}
  EzCloudShafts_scene_scale {{parent.scene_scale}}
  EzCloudShafts_clouds_size {{CloudsOrNone.width} {CloudsOrNone.height}}
  EzCloudShafts_clouds_overscan {{"max(0, (CloudsOrNone.width - PositionPick.width) / 2)"} {"max(0, (CloudsOrNone.height - PositionPick.height) / 2)"}}
  EzCloudShafts_sun_direction {{parent.sun_in_use.x} {parent.sun_in_use.y} {parent.sun_in_use.z}}
  EzCloudShafts_sun_rotation {{parent.sun_rotation_in_use}}
  EzCloudShafts_cloud_height {{parent.cloud_height}}
  EzCloudShafts_cloud_density {{parent.cloud_density}}
  EzCloudShafts_shadow_strength {{parent.shadow_strength}}
  EzCloudShafts_outside_lit {{"parent.outside_frame==0"}}
  EzCloudShafts_drift {{"parent.drift_x * (frame - parent.drift_frame)"} {"parent.drift_z * (frame - parent.drift_frame)"}}
  EzCloudShafts_penumbra {{parent.penumbra}}
  EzCloudShafts_samples {{parent.samples}}
  EzCloudShafts_shaft_density {{"parent.shaft_density / 1000"}}
  EzCloudShafts_haze_height {{"parent.haze_height * 1000"}}
  EzCloudShafts_shaft_start {{parent.shaft_start}}
  EzCloudShafts_max_distance {{"parent.max_distance * 1000"}}
  EzCloudShafts_sky_distance {{"parent.sky_distance * 1000"}}
  EzCloudShafts_march_steps {{parent.march_steps}}
  EzCloudShafts_use_env {{"parent.atm_found"}}
  EzCloudShafts_env_screen {{parent.atm_screen}}
  EzCloudShafts_env_rotation {{parent.atm_rotation}}
  EzCloudShafts_shaft_color {1 1 1}
  EzCloudShafts_shaft_intensity {{parent.shaft_intensity}}
  EzCloudShafts_seed {{frame}}
  EzCloudShafts_use_depth {{parent.use_cloud_depth}}
  EzCloudShafts_use_sun_view {{parent.sun_view_on}}
  EzCloudShafts_sun_row0 {{parent.sun_world_matrix.0} {parent.sun_world_matrix.1} {parent.sun_world_matrix.2}}
  EzCloudShafts_sun_row1 {{parent.sun_world_matrix.4} {parent.sun_world_matrix.5} {parent.sun_world_matrix.6}}
