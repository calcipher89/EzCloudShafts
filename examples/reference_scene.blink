// Synthetic renders for the EzCloudShafts reference demo: layered mountain ridges and a broken
// cloud deck, ray cast through the shot camera. Metres inside; P is written in scene units.
//
// mode 0: terrain P (rgb, scene units, sky 0), alpha 1 on terrain.
// mode 1: ambient light on terrain, plus the sky (src = the terrain P).
// mode 2: sun light on terrain (src = the terrain P).
// mode 3: clouds, premultiplied rgb, alpha = opacity.
// mode 4: clouds' Planar Z in rgb, scene units.
// mode 5: the clouds' opacity from an orthographic camera along the sun (a sun-view render).
// mode 6: the true sun visibility at the terrain (src = the terrain P), to check the gobo.

kernel RefScene : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> src;
  Image<eWrite> dst;

param:
  int mode;
  float camY;
  float pitch;
  float focal;
  float haperture;
  float vaperture;
  float2 frameSize;
  float3 sunDir;
  float cloudH;
  float unit;
  float gapBias;
  float cloudScale;
  float3 orthoCenter;
  float orthoWidth;

local:
  float cp;
  float sp;
  float3 sun;
  float sheetX;
  float sheetZ;

  void define()
  {
    defineParam(mode, "mode", 0);
    defineParam(camY, "cam_y", 1200.0f);
    defineParam(pitch, "pitch", 3.0f);
    defineParam(focal, "focal", 40.0f);
    defineParam(haperture, "haperture", 36.0f);
    defineParam(vaperture, "vaperture", 20.25f);
    defineParam(frameSize, "frame_size", float2(1920.0f, 1080.0f));
    defineParam(sunDir, "sun_dir", float3(0.0f, 0.26f, -1.0f));
    defineParam(cloudH, "cloud_h", 3000.0f);
    defineParam(unit, "unit", 10.0f);
    defineParam(gapBias, "gap_bias", 0.0f);
    defineParam(cloudScale, "cloud_scale", 1.0f);
    defineParam(orthoCenter, "ortho_center", float3(0.0f, 0.0f, 0.0f));
    defineParam(orthoWidth, "ortho_width", 100000.0f);
  }

  void init()
  {
    float a = pitch * 3.14159265f / 180.0f;
    cp = cos(a);
    sp = sin(a);
    sun = normalize(sunDir);
    sheetX = sun.x / sun.y * (cloudH - camY) / 1000.0f;
    sheetZ = sun.z / sun.y * (cloudH - camY) / 1000.0f;
  }

  float fr(float v) { return v - floor(v); }

  float hash(float x, float y)
  {
    float a = fr(x * 0.1031f);
    float b = fr(y * 0.1030f);
    float c = fr(x * 0.0973f);
    float d = a * (b + 33.33f) + b * (c + 33.33f) + c * (a + 33.33f);
    a += d;
    b += d;
    c += d;
    return fr((a + b) * c);
  }

  float vn(float x, float y)
  {
    float ix = floor(x);
    float iy = floor(y);
    float fx = x - ix;
    float fy = y - iy;
    float ux = fx * fx * fx * (fx * (fx * 6.0f - 15.0f) + 10.0f);
    float uy = fy * fy * fy * (fy * (fy * 6.0f - 15.0f) + 10.0f);
    float a = hash(ix, iy);
    float b = hash(ix + 1.0f, iy);
    float c = hash(ix, iy + 1.0f);
    float d = hash(ix + 1.0f, iy + 1.0f);
    return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;
  }

  float fbm(float x, float y, int oct)
  {
    float s = 0.0f;
    float amp = 0.5f;
    float total = 0.0f;
    for (int i = 0; i < oct; i++) {
      s += amp * vn(x, y);
      total += amp;
      amp *= 0.5f;
      float nx = 1.6f * x + 1.2f * y + 13.7f;
      y = -1.2f * x + 1.6f * y + 7.3f;
      x = nx;
    }
    return s / total;
  }

  float ridged(float x, float y, int oct)
  {
    float s = 0.0f;
    float amp = 0.5f;
    float total = 0.0f;
    for (int i = 0; i < oct; i++) {
      float n = 1.0f - fabs(2.0f * vn(x, y) - 1.0f);
      s += amp * n * n;
      total += amp;
      amp *= 0.5f;
      float nx = 1.7f * x + 1.1f * y + 5.1f;
      y = -1.1f * x + 1.7f * y + 9.2f;
      x = nx;
    }
    return s / total;
  }

  float smax(float a, float b, float k)
  {
    float h = clamp(0.5f + 0.5f * (a - b) / k, 0.0f, 1.0f);
    return b + (a - b) * h + k * h * (1.0f - h);
  }

  float ridgeTerm(float x, float z, float zi, float hi, float ai, float wi, float seed, float cur)
  {
    float d0 = -z - zi;
    if (fabs(d0) > 4.5f * wi)
      return cur;
    float shift = (vn(x / (zi * 0.4f) + seed, seed * 3.1f) - 0.5f) * wi * 1.8f;
    float crest = hi + ai * (fbm(x / (zi * 0.16f + 150.0f) + seed * 7.0f, seed * 1.7f, 4) - 0.5f) * 2.4f;
    float d = (d0 - shift) / wi;
    float v = 350.0f + (crest - 350.0f) * exp(-d * d);
    return smax(cur, v, wi * 0.12f);
  }

  // Height of the land at x, z. `t` is the viewing distance, for level of detail.
  float terrain(float x, float z, float t)
  {
    float h = 350.0f;
    h = ridgeTerm(x, z, 1300.0f, 965.0f, 30.0f, 330.0f, 1.0f, h);
    h = ridgeTerm(x, z, 2500.0f, 960.0f, 60.0f, 700.0f, 2.0f, h);
    h = ridgeTerm(x, z, 5000.0f, 938.0f, 90.0f, 1300.0f, 3.0f, h);
    h = ridgeTerm(x, z, 9000.0f, 950.0f, 130.0f, 2200.0f, 4.0f, h);
    h = ridgeTerm(x, z, 15000.0f, 1040.0f, 180.0f, 3500.0f, 5.0f, h);
    h = ridgeTerm(x, z, 24000.0f, 1200.0f, 260.0f, 5000.0f, 6.0f, h);
    h = ridgeTerm(x, z, 38000.0f, 1600.0f, 320.0f, 7000.0f, 7.0f, h);
    float rel = clamp((h - 350.0f) / 550.0f, 0.0f, 1.0f);
    int oct = t < 6000.0f ? 5 : (t < 18000.0f ? 4 : 3);
    h += rel * 105.0f * (ridged(x / 1500.0f, z / 1500.0f, oct) - 0.45f);
    if (t < 9000.0f)
      h += rel * 22.0f * (fbm(x / 120.0f, z / 120.0f, 3) - 0.5f);
    // Tree crowns on the near ridges: one cone per cell, inside the cell so they stay continuous.
    if (t < 3500.0f && rel > 0.1f) {
      // Two rotated grids of crowns at different sizes, so no rows line up.
      float tree = 0.0f;
      float tall = 0.0f;
      for (int g = 0; g < 2; g++) {
        float ca = g == 0 ? 0.80f : 0.34f;
        float sa = g == 0 ? 0.60f : 0.94f;
        float cell = g == 0 ? 10.5f : 15.5f;
        float gx = (ca * x + sa * z) / cell + g * 17.3f;
        float gz = (-sa * x + ca * z) / cell + g * 5.9f;
        float cx = floor(gx);
        float cz = floor(gz);
        float jx = hash(cx, cz) * 0.5f + 0.25f;
        float jz = hash(cz + 3.0f, cx + 7.0f) * 0.5f + 0.25f;
        float dx = gx - cx - jx;
        float dz = gz - cz - jz;
        float cone = max(0.0f, 1.0f - sqrt(dx * dx + dz * dz) / 0.25f);
        float th = 7.0f + 22.0f * hash(cx + 11.0f, cz + 5.0f) * hash(cz + 2.0f, cx + 9.0f);
        tall = max(tall, cone * th);
      }
      tree = 1.0f;
      h += tree * tall * (1.0f - clamp((t - 2200.0f) / 1300.0f, 0.0f, 1.0f));
    }
    return h;
  }

  float3 viewRay(float u, float v)
  {
    float cx = (u - 0.5f) * haperture / focal;
    float cy = (v - 0.5f) * vaperture / focal;
    return float3(cx, cy * cp + sp, cy * sp - cp);
  }

  float4 marchTerrain(float3 o, float3 d)
  {
    float t = 300.0f;
    float tPrev = t;
    int hit = 0;
    for (int i = 0; i < 300; i++) {
      float3 p = o + d * t;
      if (p.y > 2800.0f && d.y > 0.0f)
        break;
      float gap = p.y - terrain(p.x, p.z, t);
      if (gap < 0.0f) {
        hit = 1;
        break;
      }
      tPrev = t;
      t += max(gap * 0.5f, t * 0.002f + 0.5f);
      if (t > 70000.0f)
        break;
    }
    if (hit == 0)
      return float4(0.0f);
    float a = tPrev;
    float b = t;
    for (int i = 0; i < 6; i++) {
      float m = 0.5f * (a + b);
      float3 p = o + d * m;
      if (p.y - terrain(p.x, p.z, m) < 0.0f)
        b = m;
      else
        a = m;
    }
    float3 p = o + d * b;
    return float4(p.x * unit, p.y * unit, p.z * unit, 1.0f);
  }

  float3 forest(float3 p, float dist)
  {
    float big = fbm(p.x / 700.0f, p.z / 700.0f, 3);
    float mid = fbm(p.x / 70.0f, p.z / 70.0f, 3);
    float fine = dist < 5000.0f ? vn(p.x / 6.0f, p.z / 6.0f) : 0.5f;
    float autumn = clamp((big - 0.48f) * 7.0f, 0.0f, 1.0f) * clamp((mid - 0.3f) * 3.0f, 0.0f, 1.0f);
    float3 green = float3(0.017f, 0.026f, 0.015f);
    float3 rust = float3(0.072f, 0.040f, 0.018f);
    float3 c = green + (rust - green) * autumn;
    return c * (0.55f + 0.9f * mid) * (0.7f + 0.6f * fine);
  }

  float3 normalAt(float3 p, float dist)
  {
    float e = max(1.5f, dist * 0.0012f);
    float hx = terrain(p.x + e, p.z, dist) - terrain(p.x - e, p.z, dist);
    float hz = terrain(p.x, p.z + e, dist) - terrain(p.x, p.z - e, dist);
    return normalize(float3(-hx / (2.0f * e), 1.0f, -hz / (2.0f * e)));
  }

  float sunShadow(float3 p)
  {
    float s = 30.0f;
    float lit = 1.0f;
    for (int i = 0; i < 26; i++) {
      float3 q = p + sun * s;
      if (q.y > 2300.0f)
        break;
      float gap = q.y - terrain(q.x, q.z, 20000.0f);
      lit = min(lit, clamp(gap / (s * 0.05f) + 0.5f, 0.0f, 1.0f));
      if (lit <= 0.0f)
        break;
      s *= 1.28f;
    }
    return lit;
  }

  float cloudField(float X, float Z, int oct)
  {
    float x = X * cloudScale;
    float z = Z * cloudScale;
    float wx = fbm(x * 0.4f + 3.1f, z * 0.4f, 3) - 0.5f;
    float wz = fbm(x * 0.4f + 9.7f, z * 0.4f + 5.0f, 3) - 0.5f;
    float base = fbm((x + wx * 2.2f) * 0.55f, (z + wz * 2.2f) * 0.55f, oct);
    // Ragged, cell-like gaps.
    float cells = ridged(x * 1.6f + wx * 1.5f, z * 1.6f + wz * 1.5f, 3);
    base = base - 0.09f * (cells - 0.3f);
    // Radially stretched structure around the sun's point: gaps here make long coherent beams.
    float dx = X - sheetX;
    float dz = Z - sheetZ;
    float r = sqrt(dx * dx + dz * dz) + 0.05f;
    float th = atan2(dx, -dz);
    float wedge = clamp(1.4f - r / 22.0f, 0.0f, 1.0f) * clamp((r - 2.0f) / 4.0f, 0.0f, 1.0f);
    float rad = fbm(th * 34.0f + 40.0f, log(r) * 1.2f, 4) - 0.5f;
    return base + 0.22f * rad * wedge;
  }

  float cloudThreshold(float X, float Z)
  {
    float dx = X - sheetX;
    float dz = Z - sheetZ;
    float r = sqrt(dx * dx + dz * dz);
    // Broken around the sun and in the wedge of deck below it on screen; closed further out.
    float wedge = (dz < 0.0f && fabs(dx) < 0.6f * (-dz) && r < 34.0f) ? 0.42f : 0.0f;
    float openness = max(0.75f * exp(-r * r / 30.0f), wedge * clamp(1.2f - r / 34.0f, 0.0f, 1.0f));
    return 0.30f + gapBias + 0.13f * openness;
  }
  // Opacity of the deck at a point on it, in km.
  float cloudAlpha(float X, float Z)
  {
    float dist = sqrt(X * X + Z * Z);
    int oct = dist < 12.0f ? 7 : (dist < 28.0f ? 6 : 4);
    float dens = clamp((cloudField(X, Z, oct) - cloudThreshold(X, Z)) / (0.2f + dist * 0.008f), 0.0f, 1.0f);
    float far = clamp((dist - 46.0f) / 22.0f, 0.0f, 1.0f);
    return (1.0f - exp(-dens * 9.0f)) * (1.0f - far);
  }

  float4 clouds(float3 o, float3 d, float3 nd, float &tOut)
  {
    tOut = 0.0f;
    if (d.y <= 0.004f)
      return float4(0.0f);
    float t = (cloudH - o.y) / d.y;
    tOut = t;
    float X = t * d.x / 1000.0f;
    float Z = t * d.z / 1000.0f;
    float dist = sqrt(X * X + Z * Z);
    int oct = dist < 12.0f ? 7 : (dist < 28.0f ? 6 : 4);
    float f = cloudField(X, Z, oct);
    float T = cloudThreshold(X, Z);
    float dens = clamp((f - T) / (0.2f + dist * 0.008f), 0.0f, 1.0f);
    // Far away the deck closes up into a solid-looking line.
    float far = clamp((dist - 46.0f) / 22.0f, 0.0f, 1.0f);
    float alpha = 1.0f - exp(-dens * 9.0f);
    alpha = alpha * (1.0f - far);
    // Light comes from the sun's side of each puff: sample the field a little towards it.
    float lx = sheetX - X;
    float lz = sheetZ - Z;
    float ll = sqrt(lx * lx + lz * lz) + 1e-3f;
    float f2 = cloudField(X + lx / ll * 0.12f, Z + lz / ll * 0.12f, oct);
    float toward = clamp((f2 - T) / 0.16f, 0.0f, 1.0f);
    float sd = max(dot(nd, sun), 0.0f);
    float edge = exp(-toward * 4.0f) * exp(-dens * 3.5f);
    float nearSun = pow(sd, 40.0f) * 1.3f + pow(sd, 10.0f) * 0.07f + 0.006f;
    float body = 0.55f + 0.9f * (fbm(X * 1.5f + 2.0f, Z * 1.5f, 4) - 0.5f);
    float3 under = float3(0.075f, 0.082f, 0.105f) * body;
    float3 silver = float3(5.0f, 3.8f, 2.4f);
    float3 c = under + silver * (edge * nearSun);
    return float4(c.x * alpha, c.y * alpha, c.z * alpha, alpha);
  }

  void process(int2 xy)
  {
    float u = (xy.x + 0.5f) / frameSize.x;
    float v = (xy.y + 0.5f) / frameSize.y;
    float3 o = float3(0.0f, camY, 0.0f);
    float3 d = viewRay(u, v);
    float3 nd = normalize(d);

    if (mode == 0) {
      dst() = marchTerrain(o, d);
      return;
    }
    if (mode == 5) {
      float th = atan2(sun.x, sun.z);
      float ph = -asin(sun.y);
      float3 ax = float3(cos(th), 0.0f, -sin(th));
      float3 ay = float3(sin(ph) * sin(th), cos(ph), sin(ph) * cos(th));
      float per = orthoWidth / frameSize.x;
      float3 w = orthoCenter + ax * ((xy.x + 0.5f - 0.5f * frameSize.x) * per) + ay * ((xy.y + 0.5f - 0.5f * frameSize.y) * per);
      float3 hit = w + sun * ((cloudH - w.y) / sun.y);
      float a = cloudAlpha(hit.x / 1000.0f, hit.z / 1000.0f);
      dst() = float4(a, a, a, a);
      return;
    }
    if (mode == 6) {
      float4 Q = src();
      float3 q = float3(Q.x, Q.y, Q.z) / unit;
      float3 hit = q + sun * ((cloudH - q.y) / sun.y);
      float a = 1.0f - cloudAlpha(hit.x / 1000.0f, hit.z / 1000.0f);
      dst() = float4(a, a, a, Q.w);
      return;
    }
    if (mode == 3 || mode == 4) {
      float t;
      float4 c = clouds(o, d, nd, t);
      if (mode == 3)
        dst() = c;
      else
        dst() = float4(t * unit, t * unit, t * unit, 1.0f);
      return;
    }

    float4 P = src();
    if (P.w < 0.5f) {
      if (mode == 2) {
        dst() = float4(0.0f);
        return;
      }
      // Sky.
      float el = max(nd.y, 0.0f);
      float sd = max(dot(nd, sun), 0.0f);
      float k = clamp(el / 0.32f, 0.0f, 1.0f);
      float3 hor = float3(0.82f, 0.62f, 0.44f);
      float3 zen = float3(0.14f, 0.2f, 0.34f);
      float3 c = hor + (zen - hor) * k;
      float g = 5.0f * pow(sd, 700.0f) + 0.5f * pow(sd, 70.0f) + 0.08f * pow(sd, 8.0f);
      float disk = 0.0f;
      c = c + float3(1.0f, 0.86f, 0.66f) * (g + disk);
      dst() = float4(c.x, c.y, c.z, 0.0f);
      return;
    }

    float3 p = float3(P.x, P.y, P.z) / unit;
    float dist = length(p - o);
    float3 n = normalAt(p, dist);
    float3 alb = forest(p, dist);
    if (mode == 1) {
      float low = clamp((p.y - 350.0f) / 500.0f, 0.25f, 1.0f);
      float sky = (0.55f + 0.45f * n.y) * low;
      float3 c = alb * float3(0.42f, 0.55f, 0.85f) * sky * 1.5f;
      dst() = float4(c.x, c.y, c.z, 1.0f);
      return;
    }
    float ndl = max(dot(n, sun), 0.0f);
    float view = max(dot(normalize(o - p), -sun), 0.0f);
    float shadow = sunShadow(p + n * 2.0f);
    float through = 0.28f * pow(view, 3.0f);
    float3 c = alb * float3(16.0f, 12.5f, 7.6f) * ((ndl + through) * shadow);
    dst() = float4(c.x, c.y, c.z, 1.0f);
  }
};
