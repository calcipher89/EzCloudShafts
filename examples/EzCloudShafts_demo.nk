  file_type exr
  file "\[python -execlocal \{import os\ng = nuke.thisGroup()\nready = g.knob('bake_file') is not None and g.knob('bake_folder') is not None\ns = nuke.root().name()\nbase = os.path.splitext(os.path.basename(s))\[0]\np = g\['bake_file'].value().strip() if ready else ''\nif not p:\n    d = g\['bake_folder'].value().strip() if ready else ''\n    d = d or os.path.join(os.path.dirname(s), 'ezcloudshafts_cache')\n    p = d.rstrip('/') + '/' + base + '/' + g.name() + '/' + base + '_' + g.name() + '.####.exr'\np = os.path.expandvars(p)\nif '\[' in p:\n    try:\n        p = nuke.tcl('subst', p)\n    except RuntimeError:\n        p = ''\nret = '' if '\$' in p or not ready else p.replace(chr(92), '/')\}]"
  first {{parent.baked_first}}
  last {{parent.baked_last}}
  origfirst {{parent.baked_first}}
  origlast {{parent.baked_last}}
  on_error black
  in_colorspace scene_linear
  out_colorspace scene_linear
  name BakeRead
  xpos 180
  ypos 1602
 }
