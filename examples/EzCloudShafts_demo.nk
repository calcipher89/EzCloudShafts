}
push $N591c6000
push $N32cf400
Constant {
 inputs 0
 name EnvFormat
 xpos 0
}
Expression {
 channel0 {rgba.red -rgba.green -rgba.blue none}
 expr0 (((x+0.5)/width-0.5)*1.02857143)
 channel1 {-rgba.red rgba.green -rgba.blue none}
 expr1 ((((y+0.5)/height-0.5)*0.57857143)*0.99756405+0.06975647)
 channel2 {-rgba.red -rgba.green rgba.blue none}
 expr2 ((((y+0.5)/height-0.5)*0.57857143)*0.06975647-0.99756405)
 channel3 alpha
 expr3 1
 name EnvRay
 label "world ray per pixel, z = -1 in camera"
 xpos 0
 ypos 48
}
Expression {
 temp_name0 tr
 temp_expr0 4000/(-b)
 temp_name1 yr
 temp_expr1 30+tr*g
 temp_name2 xr
 temp_expr2 tr*r
 temp_name3 hr
 temp_expr3 (330+110*sin(xr/1300+0.5)+60*sin(xr/470+2)+45*fBm(xr/380,1.7,3.1,4,2,0.5))
 channel0 {rgba.red -rgba.green -rgba.blue none}
 expr0 (yr>0&&yr<hr)?xr*10:(g<0?r*30/(-g)*10:0)
 channel1 {-rgba.red rgba.green -rgba.blue none}
 expr1 (yr>0&&yr<hr)?yr*10:0
 channel2 {-rgba.red -rgba.green rgba.blue none}
 expr2 (yr>0&&yr<hr)?-40000:(g<0?b*30/(-g)*10:0)
 channel3 alpha
 expr3 (yr>0&&yr<hr)?2:(g<0?1:0)
 name EnvHit
 label "ground plane and ridge: rgb = P, a = 0 sky, 1 ground, 2 ridge"
 xpos 0
 ypos 96
}
add_layer {P P.red P.green P.blue}
Shuffle2 {
 fromInput1 {{0} B}
 out1 P
 fromInput2 {{0} B}
 mappings "3 rgba.red 0 0 P.red 0 0 rgba.green 0 1 P.green 0 1 rgba.blue 0 2 P.blue 0 2"
 name EnvToP
 label "rgb to the P layer"
 xpos 0
 ypos 144
}
Expression {
 temp_name0 el
 temp_expr0 ((((y+0.5)/height-0.5)*0.57857143)*0.99756405+0.06975647)/sqrt((((x+0.5)/width-0.5)*1.02857143)*(((x+0.5)/width-0.5)*1.02857143)+((((y+0.5)/height-0.5)*0.57857143)*0.99756405+0.06975647)*((((y+0.5)/height-0.5)*0.57857143)*0.99756405+0.06975647)+((((y+0.5)/height-0.5)*0.57857143)*0.06975647-0.99756405)*((((y+0.5)/height-0.5)*0.57857143)*0.06975647-0.99756405))
 temp_name1 sd
 temp_expr1 ((((x+0.5)/width-0.5)*1.02857143)*0.10047921+((((y+0.5)/height-0.5)*0.57857143)*0.99756405+0.06975647)*0.27563736+((((y+0.5)/height-0.5)*0.57857143)*0.06975647-0.99756405)*-0.95599580)/sqrt((((x+0.5)/width-0.5)*1.02857143)*(((x+0.5)/width-0.5)*1.02857143)+((((y+0.5)/height-0.5)*0.57857143)*0.99756405+0.06975647)*((((y+0.5)/height-0.5)*0.57857143)*0.99756405+0.06975647)+((((y+0.5)/height-0.5)*0.57857143)*0.06975647-0.99756405)*((((y+0.5)/height-0.5)*0.57857143)*0.06975647-0.99756405))
