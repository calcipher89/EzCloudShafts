Group {
 inputs 2
 name Atmos
 onCreate "g = nuke.thisNode()\nif g\['bake_first'].value() == 0 and g\['bake_last'].value() == 0:\n    g\['bake_first'].setValue(int(nuke.root()\['first_frame'].value()))\n    g\['bake_last'].setValue(int(nuke.root()\['last_frame'].value()))\ng = nuke.thisNode()\nif g.knob('bake_valid') is not None:\n    import hashlib\n    s = \[]\n    for n in \['view_output', 'passes', 'sun_from', 'sun_direction', 'hdri_rotation', 'self_lit', 'light_from_hdri', 'sun_color', 'sun_strength', 'sun_boost', 'sky_light', 'sky_amount', 'haze_amount', 'haze_glow_size', 'haze_height', 'camera_height', 'max_distance', 'haze_density', 'haze_distance', 'quality', 'viewer_resolution', 'render_resolution', 'scatter_scale', 'rayleigh_coefficients', 'mie_coefficient', 'rayleigh_scale_height', 'planet_radius', 'atmosphere_thickness', 'manual_sun_brightness', 'clear_sky_ratio', 'sun_search_cone', 'clip_ratio']:\n        if g.knob(n):\n            s.append((n, g\[n].toScript()))\n    # Where the skydome sits shapes the output too.\n    d = g.node('DomeRemap')\n    if d is not None and g.input(2) is not None:\n        for k in ('dome_row0', 'dome_row1', 'dome_row2', 'eye', 'radius'):\n            s.append((k, repr(d\['EzAtmosDome_' + k].value())))\n    h = hashlib.md5(repr(s).encode()).hexdigest()\n    import os, re\n    r = g.node('BakeRead')\n    p = (nuke.filename(r) or '') if r is not None else ''\n    fr = int(g\['baked_first'].value())\n    m = re.search('(#+)|%(0?\[0-9]*)d', p)\n    if m is not None:\n        width = len(m.group(1)) if m.group(1) else int(m.group(2) or 1)\n        p = p\[:m.start()] + str(fr).zfill(width) + p\[m.end():]\n    ok = bool(g\['baked_hash'].value()) and g\['baked_hash'].value() == h and os.path.exists(p)\n    if bool(g\['bake_valid'].value()) != ok:\n        g\['bake_valid'].setValue(ok)\n    status = ('baked' if ok else 'bake out of date: live') if g\['use_baked'].value() and g\['baked_hash'].value() else ''\n    if g\['label'].value() in ('', 'baked', 'bake out of date: live') and g\['label'].value() != status:\n        g\['label'].setValue(status)\n"
 knobChanged "if nuke.thisKnob().name() in \['view_output', 'passes', 'sun_from', 'sun_direction', 'hdri_rotation', 'self_lit', 'light_from_hdri', 'sun_color', 'sun_strength', 'sun_boost', 'sky_light', 'sky_amount', 'haze_amount', 'haze_glow_size', 'haze_height', 'camera_height', 'max_distance', 'haze_density', 'haze_distance', 'quality', 'viewer_resolution', 'render_resolution', 'scatter_scale', 'rayleigh_coefficients', 'mie_coefficient', 'rayleigh_scale_height', 'planet_radius', 'atmosphere_thickness', 'manual_sun_brightness', 'clear_sky_ratio', 'sun_search_cone', 'clip_ratio', 'use_baked', 'bake_file', 'bake_folder', 'baked_hash', 'baked_first', 'inputChange']:\n    g = nuke.thisNode()\n    if g.knob('bake_valid') is not None:\n        import hashlib\n        s = \[]\n        for n in \['view_output', 'passes', 'sun_from', 'sun_direction', 'hdri_rotation', 'self_lit', 'light_from_hdri', 'sun_color', 'sun_strength', 'sun_boost', 'sky_light', 'sky_amount', 'haze_amount', 'haze_glow_size', 'haze_height', 'camera_height', 'max_distance', 'haze_density', 'haze_distance', 'quality', 'viewer_resolution', 'render_resolution', 'scatter_scale', 'rayleigh_coefficients', 'mie_coefficient', 'rayleigh_scale_height', 'planet_radius', 'atmosphere_thickness', 'manual_sun_brightness', 'clear_sky_ratio', 'sun_search_cone', 'clip_ratio']:\n            if g.knob(n):\n                s.append((n, g\[n].toScript()))\n        # Where the skydome sits shapes the output too.\n        d = g.node('DomeRemap')\n        if d is not None and g.input(2) is not None:\n            for k in ('dome_row0', 'dome_row1', 'dome_row2', 'eye', 'radius'):\n                s.append((k, repr(d\['EzAtmosDome_' + k].value())))\n        h = hashlib.md5(repr(s).encode()).hexdigest()\n        import os, re\n        r = g.node('BakeRead')\n        p = (nuke.filename(r) or '') if r is not None else ''\n        fr = int(g\['baked_first'].value())\n        m = re.search('(#+)|%(0?\[0-9]*)d', p)\n        if m is not None:\n            width = len(m.group(1)) if m.group(1) else int(m.group(2) or 1)\n            p = p\[:m.start()] + str(fr).zfill(width) + p\[m.end():]\n        ok = bool(g\['baked_hash'].value()) and g\['baked_hash'].value() == h and os.path.exists(p)\n        if bool(g\['bake_valid'].value()) != ok:\n            g\['bake_valid'].setValue(ok)\n        status = ('baked' if ok else 'bake out of date: live') if g\['use_baked'].value() and g\['baked_hash'].value() else ''\n        if g\['label'].value() in ('', 'baked', 'bake out of date: live') and g\['label'].value() != status:\n            g\['label'].setValue(status)\n"
 tile_color 0x4a7fb5ff
 xpos 900
 ypos 384
 addUserKnob {20 ezatmos l EzAtmosScatter}
 addUserKnob {4 view_output l "view output" t "What the main rgba shows. Every pass is also written to its own atmos_* layer." M {"Scatter Preview Comp" Scatter "Sky (Rayleigh)" "Haze (Mie)" "Sky Light (Ambient)" Transmittance "Haze Color" "Haze Preview"}}
 addUserKnob {4 passes t "Atmosphere: every ray runs through the whole sky down to the ground, as seen from the camera. Depth Haze: Scatter, Sky, Haze, Sky Light and Transmittance describe the haze around the camera out to 'haze distance', with no ground and no horizon line, for hazing a plate. Composite either with plate * transmittance + scatter." M {Atmosphere "Depth Haze"}}
 passes "Depth Haze"
 addUserKnob {4 output_mapping l "output as" t "Lat-long: every layer is a lat-long around the camera. Skydome (with a dome in the 'dome' input): every layer is laid out as the dome's own texture instead, through the dome's transforms and seen from the camera, so it goes straight onto the same Sphere in the comp and lines up with it. Camera (with the shot camera in 'camera'): every layer as the camera sees the sky, at the project format, per frame: what a ScanlineRender of the skydome would give, without the 3D setup." M {Lat-long Skydome Camera}}
 addUserKnob {26 analyze_divider l Analyze}
 addUserKnob {22 analyze t "Looks at the camera, skydome and HDRI and sets the node up for depth hazing this shot: passes, camera height, haze distance (to the horizon), self-lit and where the sun comes from. Shows what it set, with warnings about the sun." -STARTLINE T "\"\"\"Analyze: set EzAtmosScatter up for depth hazing the shot in its inputs.\n\nbuild_gizmo.py embeds this file in the gizmo's \"analyze\" button, so Nuke needs no Python\nmodule at run time. It runs once when pressed and sets plain knob values:\n\n- passes: Depth Haze;\n- camera height: the camera's height above 'ground height', in metres;\n- haze distance: the distance to the HDRI's own horizon line (from how far below level it\n  sits), or else to the horizon seen from the camera height;\n- self-lit with no HDRI; with one, the sun from the HDRI when it has a clear sun.\n\nIt then shows what it set, with warnings for a sun beside or behind the camera, a high\nsun, or a skydome without a camera.\n\nKept to top-level code with plain loops: Nuke runs button scripts with separate locals,\nwhich functions and comprehensions can't see.\n\"\"\"\nimport math\nimport nuke\n\ng = nuke.thisNode()\ndone = \[]\nwarn = \[]\n\n# The camera, through any Dots or NoOps in between.\ncam = g.input(3)\nwhile cam is not None and not cam.knob(\"world_matrix\"):\n    cam = cam.input(0) if cam.inputs() else None\nscale = g\[\"scene_scale\"].value()\n# Nothing in the scene says what its units are, so ask once per node (when it is still at 1),\n# showing the camera height each choice would give.\nif nuke.GUI and abs(scale - 1.0) < 1e-9 and not g\[\"units_confirmed\"].value():\n    units = \[(\"Metres\", 1.0), (\"Decimetres\", 0.1), (\"Centimetres\", 0.01), (\"Millimetres\", 0.001),\n             (\"Feet\", 0.3048), (\"Inches\", 0.0254)]\n    raw = cam\[\"world_matrix\"].getValue(7) - g\[\"ground_height\"].value() if cam is not None else None\n    options = \[]\n    for label, m in units:\n        options.append(label if raw is None else \"%s: camera %.4g m up\" % (label, raw * m))\n    try:\n        pick = nuke.choice(\"EzAtmosScatter analyze\", \"What units is the scene in?\", options, 0)\n    except Exception:\n        pick = None\n    if pick is not None and pick >= 0:\n        scale = units\[pick]\[1]\n        g\[\"scene_scale\"].setValue(scale)\n        g\[\"units_confirmed\"].setValue(True)\n        done.append(\"Units to metres %g: the scene is in %s (you picked it).\" % (scale, units\[pick]\[0].lower()))\nfwd = None\nif cam is not None:\n    wm = cam\[\"world_matrix\"]\n    height = max((wm.getValue(7) - g\[\"ground_height\"].value()) * scale, 1.0)\n    g\[\"camera_height\"].setValue(round(height, 1))\n    done.append(\"Camera height %.0f m (camera %s, units to metres %g).\" % (height, cam.name(), scale))\n    fwd = \[-wm.getValue(2), -wm.getValue(6), -wm.getValue(10)]\nelse:\n    height = g\[\"camera_height\"].value()\n    warn.append(\"No camera connected: kept camera height %.0f m. Connect the shot camera to 'camera'.\" % height)\n\nradius = g\[\"planet_radius\"].value()\nhorizon = math.sqrt((radius + height / 1000.0) ** 2 - radius ** 2)\n\n# The HDRI's own horizon line: the row edge below 0 deg (down to 10 deg) where the image drops most\n# from sky to ground (over 3 rows, by at least 1.5x), from the median brightness of 64 columns.\n# Its dip below 0 deg gives the distance to that horizon, so the depth haze reaches exactly the\n# line the HDRI shows.\nhdri = g.input(0)\ndip = None\nif hdri is not None:\n    w, h = hdri.width(), hdri.height()\n    rows = \[]\n    for r in range(0, max(int(h * 10.0 / 180.0), 4) + 2):\n        y = h * 0.5 - r - 0.5 + 1.0\n        vals = \[]\n        for i in range(64):\n            x = (i + 0.5) * w / 64.0\n            vals.append(0.2126 * hdri.sample(\"red\", x, y) + 0.7152 * hdri.sample(\"green\", x, y) +\n                        0.0722 * hdri.sample(\"blue\", x, y))\n        vals.sort()\n        rows.append(vals\[32])\n    best, best_r = 1.0, None\n    for r in range(len(rows) - 1):\n        drop = (rows\[r] + 1e-4) / (rows\[r + 1] + 1e-4)\n        span = (rows\[max(r - 1, 0)] + 1e-4) / (rows\[min(r + 2, len(rows) - 1)] + 1e-4)\n        if drop > best and span > 1.5:\n            best, best_r = drop, r\n    if best_r is not None:\n        dip = best_r * 180.0 / h\nif dip is not None and dip > 0.0:\n    horizon = radius * math.tan(math.radians(dip))\n    g\[\"haze_distance\"].setValue(round(horizon, 1))\n    done.append(\"Haze distance %.1f km: the HDRI's horizon line, %.2f deg below level.\" % (horizon, dip))\nelse:\n    g\[\"haze_distance\"].setValue(round(horizon, 1))\n    done.append(\"Haze distance %.1f km: the horizon seen from %.0f m%s.\" % (\n        horizon, height, \"\" if hdri is None else \" (no clear horizon line in the HDRI)\"))\ng\[\"passes\"].setValue(\"Depth Haze\")\ndone.append(\"Passes: Depth Haze.\")\n\nsun = None\nif g.input(0) is None:\n    g\[\"self_lit\"].setValue(True)\n    if g\[\"sun_from\"].value() == \"Auto (HDRI)\":\n        g\[\"sun_from\"].setValue(\"Manual\")\n    done.append(\"No HDRI: self-lit on, sun from Manual.\")\nelse:\n    g\[\"self_lit\"].setValue(False)\n    with g:\n        light = nuke.toNode(\"Light\")\n        found = \[]\n        for c in (\"red\", \"green\", \"blue\"):\n            found.append(light.sample(c, 0.5, 0.5))\n        peak = light.sample(\"alpha\", 0.5, 0.5)\n        sky = 0.2126 * light.sample(\"red\", 2.5, 0.5) + 0.7152 * light.sample(\"green\", 2.5, 0.5) + \\\n            0.0722 * light.sample(\"blue\", 2.5, 0.5)\n        clipped = light.sample(\"alpha\", 1.5, 0.5) > 0.5\n    ratio = peak / max(sky, 1e-6)\n    # A clipped sun (LDR or a capped HDRI) stands out less, but its direction is still good.\n    if any(found) and (ratio > 4.0 or (clipped and ratio > 1.5)):\n        g\[\"sun_from\"].setValue(\"Auto (HDRI)\")\n        g\[\"light_from_hdri\"].setValue(True)\n        sun = found\n        if clipped:\n            done.append(\"Clipped sun found in the HDRI: sun from Auto; its brightness is rebuilt, tune 'sun boost'.\")\n        else:\n            done.append(\"Sun found in the HDRI (%.0fx the sky): sun from Auto, light from HDRI.\" % ratio)\n    else:\n        warn.append(\"No clear sun in the HDRI (overcast?): set 'sun from' to Manual or Axis yourself.\")\n\nif g.input(2) is not None:\n    if cam is None:\n        warn.append(\"A skydome is connected but no camera: the dome is seen from its centre.\")\n    else:\n        done.append(\"Skydome connected: the HDRI is re-mapped as the camera sees the dome.\")\n\nif sun is None and g\[\"sun_from\"].value() == \"Manual\":\n    sun = list(g\[\"sun_direction\"].value())\nif sun is not None:\n    ln = math.sqrt(sun\[0] ** 2 + sun\[1] ** 2 + sun\[2] ** 2) or 1.0\n    elev = math.degrees(math.asin(max(-1.0, min(1.0, sun\[1] / ln))))\n    if fwd is not None:\n        az = math.degrees(math.atan2(sun\[0], -sun\[2]) - math.atan2(fwd\[0], -fwd\[2]))\n        az = (az + 180.0) % 360.0 - 180.0\n        done.append(\"Sun %.0f deg up, %.0f deg %s of where the camera looks.\" % (elev, abs(az), \"right\" if az > 0 else \"left\"))\n        if abs(az) > 60.0:\n            warn.append(\"The sun is beside or behind the camera: backlit haze and shafts need it in front.\")\n    if elev > 20.0:\n        warn.append(\"The sun is high (%.0f deg): sunrise and golden hour looks need it under 10 deg.\" % elev)\n\nsummary = \"\\n\".join(done + (\[\"\"] + \[\"Note: \" + w for w in warn] if warn else \[]))\nif nuke.GUI:\n    nuke.message(\"EzAtmosScatter analyze\\n\\n\" + summary)\nelse:\n    print(summary)\n"}
 addUserKnob {7 scene_scale l "units to metres" t "Scene units to metres for analyze, e.g. 0.1 for decimetres, 0.01 for centimetres." R 0.001 100}
 scene_scale 0.1
 addUserKnob {6 units_confirmed l "units confirmed" t "Set when the scene units were picked in analyze, so it doesn't ask again." -STARTLINE +INVISIBLE}
 units_confirmed true
 addUserKnob {7 ground_height l "ground height" t "Height of the ground in scene units, so analyze measures the camera height above it."}
 addUserKnob {26 sun_divider l Sun}
 addUserKnob {4 sun_from l "sun from" t "Auto finds the sun in the HDRI. Axis points at the Axis node plugged into the 'sun' input (its world position). Manual uses 'sun direction'." M {"Auto (HDRI)" Axis Manual}}
 sun_from Axis
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up. Used when 'sun from' is Manual."}
 sun_direction {0 0.5 -1}
 addUserKnob {22 use_detected_sun l "copy detected sun to manual" t "Writes the sun direction found in the HDRI into 'sun direction'." -STARTLINE T "ez_atmos = nuke.thisNode()\nwith ez_atmos:\n    light = nuke.toNode(\"Light\")\n    found = \[light.sample(\"red\", 0.5, 0.5), light.sample(\"green\", 0.5, 0.5), light.sample(\"blue\", 0.5, 0.5)]\nif not any(found):\n    nuke.message(\"No sun found: is an HDRI connected?\")\nelse:\n    ez_atmos\[\"sun_direction\"].setValue(found)\n    ez_atmos\[\"sun_from\"].setValue(\"Manual\")\n"}
 addUserKnob {22 reset_sun l "reset sun" t "Puts the sun back to its defaults: sun from Auto (HDRI), sun direction (0, 0.5, -1)." -STARTLINE T "ez_atmos = nuke.thisNode()\nez_atmos\[\"sun_from\"].setValue(\"Auto (HDRI)\")\nez_atmos\[\"sun_direction\"].setValue(\[0.0, 0.5, -1.0])\n"}
 addUserKnob {13 sun_in_use l "sun in use" t "The sun direction the node is using, whichever 'sun from' is set: found in the HDRI, from the Axis, or the manual one. EzDepthHaze reads this. Read only."}
 sun_in_use {{"sun_from==0 ? \[sample Light red 0.5 0.5] : sun_from==1 && \[exists input1] ? (\[python -execlocal \{n = nuke.thisNode().input(1)\nwhile n is not None and not n.knob('world_matrix'):\n    n = n.input(0) if n.inputs() else None\nret = n\['world_matrix'].getValueAt(nuke.frame(), 3) if n is not None else 0\}]) : sun_direction.x"} {"sun_from==0 ? \[sample Light green 0.5 0.5] : sun_from==1 && \[exists input1] ? (\[python -execlocal \{n = nuke.thisNode().input(1)\nwhile n is not None and not n.knob('world_matrix'):\n    n = n.input(0) if n.inputs() else None\nret = n\['world_matrix'].getValueAt(nuke.frame(), 7) if n is not None else 0\}]) : sun_direction.y"} {"sun_from==0 ? \[sample Light blue 0.5 0.5] : sun_from==1 && \[exists input1] ? (\[python -execlocal \{n = nuke.thisNode().input(1)\nwhile n is not None and not n.knob('world_matrix'):\n    n = n.input(0) if n.inputs() else None\nret = n\['world_matrix'].getValueAt(nuke.frame(), 11) if n is not None else 0\}]) : sun_direction.z"}}
 addUserKnob {7 hdri_rotation l "hdri rotation" t "Rotates the lat-long mapping in degrees, if the HDRI's centre column does not look down -Z." R -180 180}
 addUserKnob {6 self_lit l "self-lit (no HDRI)" t "For setups without an HDRI: the sky light comes from this atmosphere's own sky instead of the hdri input, and the sun from 'sun color' and 'sun strength' (light from HDRI is ignored). Set 'sun from' to Manual or Axis." +STARTLINE}
 addUserKnob {6 light_from_hdri l "light from HDRI" t "Take the sun's colour and brightness from the HDRI. Off: 'sun color' and 'sun strength' set them directly." +STARTLINE}
 addUserKnob {18 sun_color l "sun color" t "Tint on the HDRI's sun, or the sun colour itself when 'light from HDRI' is off."}
 sun_color 1
 addUserKnob {6 sun_color_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 sun_strength l "sun strength" t "Multiplies the sun's brightness." R 0 4}
 sun_strength 1
 addUserKnob {7 sun_boost l "sun boost" t "Only used when the HDRI's sun is clipped (JPEGs, LDR captures). The sun is then sized from the sky brightness; this scales it." R 0 4}
 sun_boost 1
 addUserKnob {7 sky_light l "sky light" t "Light from the whole HDRI sky scattered into the haze. Fills in what a single bounce from the sun misses." R 0 2}
 sky_light 1
 addUserKnob {26 atmos_divider l Atmosphere}
 addUserKnob {7 sky_amount l "sky amount" t "Density of the air (Rayleigh). More gives a bluer, brighter sky." R 0 4}
 sky_amount 1
 addUserKnob {7 haze_amount l "haze amount" t "Density of the haze (Mie). More gives whiter, thicker air." R 0 10}
 haze_amount 1
 addUserKnob {7 haze_glow_size l "haze glow size" t "Size of the glow around the sun. Bigger spreads it wider." R 0 4}
 haze_glow_size 1
 addUserKnob {7 haze_height l "haze height (km)" t "Height over which the haze thins out by about two thirds (its scale height). Low keeps it near the ground, so looking up clears quickly; high fills the air evenly around the camera." R 0.1 10}
 haze_height 1.2
 addUserKnob {7 camera_height l "camera height (m)" t "Camera height above sea level, in metres." R 0 5000}
 camera_height 30
 addUserKnob {7 max_distance l "max distance (km)" t "How far the haze reaches along each ray. 0 = to the top of the atmosphere." R 0 200}
 addUserKnob {26 depth_haze_divider l "Depth Haze"}
 addUserKnob {18 haze_density l "haze density (1/m)" t "Read only. How much the air and haze at camera height dim light per metre. For depth hazing a plate: T = exp(-haze_density * depth_in_metres), then plate * T + atmos_haze_color * (1 - T)." +DISABLED}
 haze_density {{"(rayleigh_coefficients.x * sky_amount * exp(-camera_height / 1000 / rayleigh_scale_height) + mie_coefficient * haze_amount / 0.9 * exp(-camera_height / 1000 / haze_height)) / 1000"} {"(rayleigh_coefficients.y * sky_amount * exp(-camera_height / 1000 / rayleigh_scale_height) + mie_coefficient * haze_amount / 0.9 * exp(-camera_height / 1000 / haze_height)) / 1000"} {"(rayleigh_coefficients.z * sky_amount * exp(-camera_height / 1000 / rayleigh_scale_height) + mie_coefficient * haze_amount / 0.9 * exp(-camera_height / 1000 / haze_height)) / 1000"}}
 addUserKnob {6 haze_density_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 haze_distance l "haze distance (km)" t "How far the depth haze reaches: used by the Haze Preview view and, with passes set to Depth Haze, by every pass. The haze thins with height along each ray." R 0 300}
 haze_distance 20
 addUserKnob {4 quality t "Number of samples along each ray. Draft is about 4x faster than High." M {Draft Normal High}}
 quality Normal
 addUserKnob {4 viewer_resolution l "viewer resolution" t "Resolution the haze is computed at while you work in the Nuke GUI. It is smooth, so Half or Quarter look almost the same and are 4x or 16x faster. The horizon stays sharp." M {Full Half Quarter}}
 viewer_resolution Half
 addUserKnob {4 render_resolution l "render resolution" t "Resolution the haze is computed at when rendering from a terminal or on the farm." M {Full Half Quarter}}
 render_resolution Half
 addUserKnob {7 scatter_scale l "scatter scale" +INVISIBLE}
 scatter_scale {{"\$gui ? (viewer_resolution==0 ? 1 : viewer_resolution==1 ? 0.5 : 0.25) : (render_resolution==0 ? 1 : render_resolution==1 ? 0.5 : 0.25)"}}
 addUserKnob {20 advanced l Advanced n 2}
 addUserKnob {13 rayleigh_coefficients l "rayleigh coefficients" t "Sea-level Rayleigh scattering per km at 680, 550, 440 nm."}
 rayleigh_coefficients {0.0052 0.0121 0.0296}
 addUserKnob {7 mie_coefficient l "mie coefficient" t "Sea-level Mie scattering per km. Extinction is this / 0.9."}
 mie_coefficient 0.021
 addUserKnob {7 rayleigh_scale_height l "rayleigh scale height (km)" t "Height over which air density falls by e."}
 rayleigh_scale_height 8.5
 addUserKnob {7 planet_radius l "planet radius (km)"}
 planet_radius 6360
 addUserKnob {7 atmosphere_thickness l "atmosphere thickness (km)"}
 atmosphere_thickness 60
 addUserKnob {7 manual_sun_brightness l "manual sun brightness" t "Sun brightness when 'light from HDRI' is off, before 'sun strength'."}
 manual_sun_brightness 20
 addUserKnob {7 clear_sky_ratio l "clear sky ratio" t "For clipped suns: sun brightness relative to the average sky."}
 clear_sky_ratio 55
 addUserKnob {7 sun_search_cone l "sun search cone (deg)" t "Radius around the brightest spot counted as the sun."}
 sun_search_cone 6
 addUserKnob {7 clip_ratio l "clip ratio" t "The sun counts as clipped when its peak is under this many times the average sky."}
 clip_ratio 20
 addUserKnob {20 advanced_end n -1}
 addUserKnob {26 bake_divider l Bake}
 addUserKnob {2 bake_folder l "bake folder" t "Where bakes go, for example on the job so the farm can read them: /data/jobs/\[getenv JOB]/cache/ezAtmosScatter (or \$JOB). Each script and node gets its own subfolder: <folder>/<script>/<node>/<script>_<node>.####.exr. Empty: \$EZATMOS_CACHE_DIR when set, else <script dir>/ezatmos_cache. Missing folders are created when baking."}
 addUserKnob {2 bake_file l "bake file" t "Leave empty to use 'bake folder'. Fill in a full file path (with ####) to override it for this node. \$VAR and \[getenv VAR] work here too."}
 addUserKnob {3 bake_first l "bake range" t "First frame to bake. Set first and last to the same frame to bake one frame, held for the whole shot (a sun that doesn't move)."}
 bake_first 1001
 addUserKnob {3 bake_last l "" t "Last frame to bake." -STARTLINE}
 bake_last 1001
 addUserKnob {22 bake_now l "bake now" t "Writes all layers to the bake file here and now." T "g = nuke.thisNode()\nimport os\npath = nuke.filename(g.node('BakeRead')) or ''\nbad = '' if path and os.path.isabs(path) else ('the bake folder uses an environment variable that '\n    'isn\\'t set in Nuke' if path == '' else 'the bake path isn\\'t a full path: ' + path)\nif not bad and not path.lower().endswith('.exr'):\n    # A folder typed into 'bake file' (which is the whole file name) would make Nuke\n    # write a frame named like the folder.\n    bad = ('\\'bake file\\' is a folder, not a file name like name.####.exr. Put the folder in '\n           '\\'bake folder\\' and leave \\'bake file\\' empty')\nif not bad and not os.path.isdir(os.path.dirname(path)):\n    # The Write's own 'create directories' doesn't always make deep new folders, so\n    # make them here first.\n    try:\n        os.makedirs(os.path.dirname(path))\n    except OSError as e:\n        bad = 'can\\'t create ' + os.path.dirname(path) + ' (' + str(e.strerror or e) + ')'\nif bad:\n    nuke.message('Not baked: ' + bad + '.\\n\\nFolder: ' + (g\['bake_file'].value() or g\['bake_folder'].value()))\nif not bad:\n    import hashlib\n    s = \[]\n    for n in \['view_output', 'passes', 'sun_from', 'sun_direction', 'hdri_rotation', 'self_lit', 'light_from_hdri', 'sun_color', 'sun_strength', 'sun_boost', 'sky_light', 'sky_amount', 'haze_amount', 'haze_glow_size', 'haze_height', 'camera_height', 'max_distance', 'haze_density', 'haze_distance', 'quality', 'viewer_resolution', 'render_resolution', 'scatter_scale', 'rayleigh_coefficients', 'mie_coefficient', 'rayleigh_scale_height', 'planet_radius', 'atmosphere_thickness', 'manual_sun_brightness', 'clear_sky_ratio', 'sun_search_cone', 'clip_ratio']:\n        if g.knob(n):\n            s.append((n, g\[n].toScript()))\n    # Where the skydome sits shapes the output too.\n    d = g.node('DomeRemap')\n    if d is not None and g.input(2) is not None:\n        for k in ('dome_row0', 'dome_row1', 'dome_row2', 'eye', 'radius'):\n            s.append((k, repr(d\['EzAtmosDome_' + k].value())))\n    h = hashlib.md5(repr(s).encode()).hexdigest()\n    first, last = int(g\['bake_first'].value()), int(g\['bake_last'].value())\n    if last < first:\n        first, last = last, first\n    use = g\['use_baked'].value()\n    g\['use_baked'].setValue(False)\n    try:\n        with g:\n            nuke.execute(nuke.toNode('BakeWrite'), first, last)\n        g\['baked_hash'].setValue(h)\n        g\['baked_first'].setValue(first)\n        g\['baked_last'].setValue(last)\n    finally:\n        g\['use_baked'].setValue(use)\n    g = nuke.thisNode()\n    if g.knob('bake_valid') is not None:\n        import hashlib\n        s = \[]\n        for n in \['view_output', 'passes', 'sun_from', 'sun_direction', 'hdri_rotation', 'self_lit', 'light_from_hdri', 'sun_color', 'sun_strength', 'sun_boost', 'sky_light', 'sky_amount', 'haze_amount', 'haze_glow_size', 'haze_height', 'camera_height', 'max_distance', 'haze_density', 'haze_distance', 'quality', 'viewer_resolution', 'render_resolution', 'scatter_scale', 'rayleigh_coefficients', 'mie_coefficient', 'rayleigh_scale_height', 'planet_radius', 'atmosphere_thickness', 'manual_sun_brightness', 'clear_sky_ratio', 'sun_search_cone', 'clip_ratio']:\n            if g.knob(n):\n                s.append((n, g\[n].toScript()))\n        # Where the skydome sits shapes the output too.\n        d = g.node('DomeRemap')\n        if d is not None and g.input(2) is not None:\n            for k in ('dome_row0', 'dome_row1', 'dome_row2', 'eye', 'radius'):\n                s.append((k, repr(d\['EzAtmosDome_' + k].value())))\n        h = hashlib.md5(repr(s).encode()).hexdigest()\n        import os, re\n        r = g.node('BakeRead')\n        p = (nuke.filename(r) or '') if r is not None else ''\n        fr = int(g\['baked_first'].value())\n        m = re.search('(#+)|%(0?\[0-9]*)d', p)\n        if m is not None:\n            width = len(m.group(1)) if m.group(1) else int(m.group(2) or 1)\n            p = p\[:m.start()] + str(fr).zfill(width) + p\[m.end():]\n        ok = bool(g\['baked_hash'].value()) and g\['baked_hash'].value() == h and os.path.exists(p)\n        if bool(g\['bake_valid'].value()) != ok:\n            g\['bake_valid'].setValue(ok)\n        status = ('baked' if ok else 'bake out of date: live') if g\['use_baked'].value() and g\['baked_hash'].value() else ''\n        if g\['label'].value() in ('', 'baked', 'bake out of date: live') and g\['label'].value() != status:\n            g\['label'].setValue(status)\n" +STARTLINE}
 addUserKnob {22 bake_farm_write l "make farm bake Write" t "Adds a Write below this node with the bake path, to render on the farm before the comp." -STARTLINE T "g = nuke.thisNode()\nimport os\npath = nuke.filename(g.node('BakeRead')) or ''\nbad = '' if path and os.path.isabs(path) else ('the bake folder uses an environment variable that '\n    'isn\\'t set in Nuke' if path == '' else 'the bake path isn\\'t a full path: ' + path)\nif not bad and not path.lower().endswith('.exr'):\n    # A folder typed into 'bake file' (which is the whole file name) would make Nuke\n    # write a frame named like the folder.\n    bad = ('\\'bake file\\' is a folder, not a file name like name.####.exr. Put the folder in '\n           '\\'bake folder\\' and leave \\'bake file\\' empty')\nif not bad and not os.path.isdir(os.path.dirname(path)):\n    # The Write's own 'create directories' doesn't always make deep new folders, so\n    # make them here first.\n    try:\n        os.makedirs(os.path.dirname(path))\n    except OSError as e:\n        bad = 'can\\'t create ' + os.path.dirname(path) + ' (' + str(e.strerror or e) + ')'\nif bad:\n    nuke.message('Not baked: ' + bad + '.\\n\\nFolder: ' + (g\['bake_file'].value() or g\['bake_folder'].value()))\nif not bad:\n    import hashlib\n    s = \[]\n    for n in \['view_output', 'passes', 'sun_from', 'sun_direction', 'hdri_rotation', 'self_lit', 'light_from_hdri', 'sun_color', 'sun_strength', 'sun_boost', 'sky_light', 'sky_amount', 'haze_amount', 'haze_glow_size', 'haze_height', 'camera_height', 'max_distance', 'haze_density', 'haze_distance', 'quality', 'viewer_resolution', 'render_resolution', 'scatter_scale', 'rayleigh_coefficients', 'mie_coefficient', 'rayleigh_scale_height', 'planet_radius', 'atmosphere_thickness', 'manual_sun_brightness', 'clear_sky_ratio', 'sun_search_cone', 'clip_ratio']:\n        if g.knob(n):\n            s.append((n, g\[n].toScript()))\n    # Where the skydome sits shapes the output too.\n    d = g.node('DomeRemap')\n    if d is not None and g.input(2) is not None:\n        for k in ('dome_row0', 'dome_row1', 'dome_row2', 'eye', 'radius'):\n            s.append((k, repr(d\['EzAtmosDome_' + k].value())))\n    h = hashlib.md5(repr(s).encode()).hexdigest()\n    first, last = int(g\['bake_first'].value()), int(g\['bake_last'].value())\n    if last < first:\n        first, last = last, first\n    with nuke.root():\n        w = nuke.nodes.Write(name=g.name() + '_BakeWrite', file=path, file_type='exr', channels='all')\n        w\['create_directories'].setValue(True)\n        w\['use_limit'].setValue(True)\n        w\['first'].setValue(first)\n        w\['last'].setValue(last)\n        w.setInput(0, g)\n        w.setXYpos(g.xpos(), g.ypos() + 80)\n    g\['baked_hash'].setValue(h)\n    g\['baked_first'].setValue(first)\n    g\['baked_last'].setValue(last)\n    g\['bake_valid'].setValue(True)\n    if g\['label'].value() in ('', 'bake out of date: live'):\n        g\['label'].setValue('baked')\n    if nuke.GUI:\n        nuke.message('Render %s on the farm before the comp. It writes ' % w.name() + path)\n"}
 addUserKnob {6 use_baked l "use baked" t "Read the bake instead of computing, but only while it exists and these settings still match it; otherwise the node computes live and its label says the bake is out of date. The check runs when a knob or input of this node changes and when the script opens; after moving the skydome upstream, bake again." +STARTLINE}
 use_baked true
 addUserKnob {1 baked_hash l "baked hash" +INVISIBLE}
 addUserKnob {3 baked_first +INVISIBLE}
 addUserKnob {3 baked_last +INVISIBLE}
 addUserKnob {6 bake_valid l "bake valid" -STARTLINE +INVISIBLE}
 addUserKnob {26 version_divider l "" +STARTLINE}
 addUserKnob {26 version -STARTLINE T "EzAtmosScatter v1.0.0"}
}
 Input {
  inputs 0
  name sun
  xpos 600
  ypos -400
  number 1
 }
 Input {
  inputs 0
  name dome
  xpos 150
  ypos -440
