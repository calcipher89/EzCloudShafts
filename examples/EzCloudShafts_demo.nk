 channel0 {rgba.red -rgba.green -rgba.blue none}
 expr0 a<0.5?mix(1.05,0.22,smoothstep(0,0.45,el))+(0.9*pow(max(sd,0),120)+0.25*pow(max(sd,0),12))*1+(smoothstep(0.99985,0.99995,sd)*60)*1:mix((a>1.5?0.16:0.2)*tex,1.05,fog)
 channel1 {-rgba.red rgba.green -rgba.blue none}
 expr1 a<0.5?mix(0.72,0.38,smoothstep(0,0.45,el))+(0.9*pow(max(sd,0),120)+0.25*pow(max(sd,0),12))*0.86+(smoothstep(0.99985,0.99995,sd)*60)*0.86:mix((a>1.5?0.15:0.23)*tex,0.72,fog)
 channel2 {-rgba.red -rgba.green rgba.blue none}
 expr2 a<0.5?mix(0.42,0.72,smoothstep(0,0.45,el))+(0.9*pow(max(sd,0),120)+0.25*pow(max(sd,0),12))*0.62+(smoothstep(0.99985,0.99995,sd)*60)*0.62:mix((a>1.5?0.15:0.11)*tex,0.42,fog)
