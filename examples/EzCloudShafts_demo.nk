 channel2 none
 channel3 alpha
 expr3 a*b*smoothstep(0.82,1.05,sqrt(pow2((r--0.4641)/0.35)+pow2((g--4.8984)/0.5))+0.22*noise(r*3,g*3,-1))*smoothstep(0.82,1.05,sqrt(pow2((r-1.4359)/0.3)+pow2((g--4.7484)/0.45))+0.22*noise(r*3,g*3,0.9))*smoothstep(0.82,1.05,sqrt(pow2((r-0.2359)/0.3)+pow2((g--4.0984)/0.3))+0.22*noise(r*3,g*3,-0.3))*smoothstep(0.82,1.05,sqrt(pow2((r-0.2859)/0.22)+pow2((g--5.7984)/0.3))+0.22*noise(r*3,g*3,-0.25))*smoothstep(0.82,1.05,sqrt(pow2((r-0.8859)/0.25)+pow2((g--6.3984)/0.38))+0.22*noise(r*3,g*3,0.35))*smoothstep(0.82,1.05,sqrt(pow2((r--0.1641)/0.3)+pow2((g--6.9984)/0.45))+0.22*noise(r*3,g*3,-0.7))*smoothstep(0.82,1.05,sqrt(pow2((r-1.3859)/0.38)+pow2((g--7.3984)/0.5))+0.22*noise(r*3,g*3,0.85))*smoothstep(0.82,1.05,sqrt(pow2((r-0.5359)/0.4)+pow2((g--8.0984)/0.55))+0.22*noise(r*3,g*3,0))*smoothstep(0.82,1.05,sqrt(pow2((r--0.8641)/0.45)+pow2((g--8.2984)/0.6))+0.22*noise(r*3,g*3,-1.4))*smoothstep(0.82,1.05,sqrt(pow2((r-2.1359)/0.5)+pow2((g--8.3984)/0.6))+0.22*noise(r*3,g*3,1.6))*smoothstep(0.82,1.05,sqrt(pow2((r--2.7641)/0.9)+pow2((g--6.8984)/1))+0.22*noise(r*3,g*3,-3.3))*smoothstep(0.82,1.05,sqrt(pow2((r-3.7359)/0.8)+pow2((g--6.4984)/1))+0.22*noise(r*3,g*3,3.2))
 name CloudHoles
 label "cuts the gaps around the sun"
