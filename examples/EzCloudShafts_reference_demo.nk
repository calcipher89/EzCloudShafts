 BlinkScript {
  inputs 2
  recompileCount 1
  KernelDescription "3 \"EzCloudShaftsSoften\" iterate pixelWise 45d6b9fcdb620d134d7c21f16e3359242015a6d6f3a519bfa44e366588cd1567 3 \"src\" Read Random \"pos\" Read Random \"dst\" Write Point 3 \"radius\" Float 1 AACAQA== \"edge\" Float 1 j8L1PA== \"cam_position\" Float 3 AAAAAAAAAAAAAAAAAAAAAA== 3 \"radius\" 1 1 Default \"edge\" 1 1 Default \"camPosition\" 3 1 Default 0"
  kernelSource "// EzCloudShaftsSoften: takes the march's grain out of the shafts layers without blurring beams\n// across ridge lines. Each pixel averages its neighbours at about the same distance from the\n// camera, so the grain melts while silhouettes stay sharp. Sky (P = 0) only averages with sky.\n//\n// Inputs: `src` the pass to soften, `pos` world position in scene units.\n\nkernel EzCloudShaftsSoften : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> src;\n  Image<eRead, eAccessRandom, eEdgeClamped> pos;\n  Image<eWrite> dst;\n\nparam:\n  float radius;\n  float edge;\n  float3 camPosition;\n\n  void define()\n  \{\n    defineParam(radius, \"radius\", 4.0f);\n    defineParam(edge, \"edge\", 0.03f);\n    defineParam(camPosition, \"cam_position\", float3(0.0f, 0.0f, 0.0f));\n  \}\n\n  // Distance on a log scale, so \"about the same\" means the same ratio near and far.\n  float key(float4 p)\n  \{\n    if (p.x == 0.0f && p.y == 0.0f && p.z == 0.0f)\n      return 1e6f;\n    return log(length(float3(p.x, p.y, p.z) - camPosition) + 1e-3f);\n  \}\n\n  void process(int2 xy)\n  \{\n    int r = int(radius + 0.5f);\n    if (r <= 0) \{\n      dst() = src(xy.x, xy.y);\n      return;\n    \}\n    float kc = key(pos(xy.x, xy.y));\n    float sigma2 = 2.0f * (radius * 0.6f) * (radius * 0.6f);\n    float4 sum = float4(0.0f);\n    float wsum = 0.0f;\n    for (int dy = -r; dy <= r; dy++) \{\n      for (int dx = -r; dx <= r; dx++) \{\n        float kd = (key(pos(xy.x + dx, xy.y + dy)) - kc) / edge;\n        float w = exp(-(dx * dx + dy * dy) / sigma2 - kd * kd);\n        sum += src(xy.x + dx, xy.y + dy) * w;\n        wsum += w;\n      \}\n    \}\n    dst() = sum / wsum;\n  \}\n\};"
  rebuild ""
  EzCloudShaftsSoften_radius {{parent.soften}}
  EzCloudShaftsSoften_cam_position {{parent.cam_world_matrix.3} {parent.cam_world_matrix.7} {parent.cam_world_matrix.11}}
  rebuild_finalise ""
  name Soft_LitShare_Edge
  xpos 900
  ypos 1254
 }
