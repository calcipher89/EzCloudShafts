BlinkScript {
 recompileCount 2
 KernelDescription "3 \"RefScene\" iterate pixelWise ba8e809263f59bd227dc50badbfaeb59d00a24be7fde2a9353ded6be35915123 2 \"src\" Read Point \"dst\" Write Point 14 \"mode\" Int 1 AAAAAA== \"cam_y\" Float 1 AACWRA== \"pitch\" Float 1 AABAQA== \"focal\" Float 1 AAAgQg== \"haperture\" Float 1 AAAQQg== \"vaperture\" Float 1 AACiQQ== \"frame_size\" Float 2 AADwRAAAh0Q= \"sun_dir\" Float 3 AAAAALgehT4AAIC/AAAAAA== \"cloud_h\" Float 1 AIA7RQ== \"unit\" Float 1 AAAgQQ== \"gap_bias\" Float 1 AAAAAA== \"cloud_scale\" Float 1 AACAPw== \"ortho_center\" Float 3 AAAAAAAAAAAAAAAAAAAAAA== \"ortho_width\" Float 1 AFDDRw== 14 \"mode\" 1 1 Default \"camY\" 1 1 Default \"pitch\" 1 1 Default \"focal\" 1 1 Default \"haperture\" 1 1 Default \"vaperture\" 1 1 Default \"frameSize\" 2 1 Default \"sunDir\" 3 1 Default \"cloudH\" 1 1 Default \"unit\" 1 1 Default \"gapBias\" 1 1 Default \"cloudScale\" 1 1 Default \"orthoCenter\" 3 1 Default \"orthoWidth\" 1 1 Default 5 \"cp\" Float 1 1 AAAAAA== \"sp\" Float 1 1 AAAAAA== \"sun\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"sheetX\" Float 1 1 AAAAAA== \"sheetZ\" Float 1 1 AAAAAA=="
 kernelSource "// Synthetic renders for the EzCloudShafts reference demo: layered mountain ridges and a broken\n// cloud deck, ray cast through the shot camera. Metres inside; P is written in scene units.\n//\n// mode 0: terrain P (rgb, scene units, sky 0), alpha 1 on terrain.\n// mode 1: ambient light on terrain, plus the sky (src = the terrain P).\n// mode 2: sun light on terrain (src = the terrain P).\n// mode 3: clouds, premultiplied rgb, alpha = opacity.\n// mode 4: clouds' Planar Z in rgb, scene units.\n// mode 5: the clouds' opacity from an orthographic camera along the sun (a sun-view render).\n// mode 6: the true sun visibility at the terrain (src = the terrain P), to check the gobo.\n\nkernel RefScene : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> src;\n  Image<eWrite> dst;\n\nparam:\n  int mode;\n  float camY;\n  float pitch;\n  float focal;\n  float haperture;\n  float vaperture;\n  float2 frameSize;\n  float3 sunDir;\n  float cloudH;\n  float unit;\n  float gapBias;\n  float cloudScale;\n  float3 orthoCenter;\n  float orthoWidth;\n\nlocal:\n  float cp;\n  float sp;\n  float3 sun;\n  float sheetX;\n  float sheetZ;\n\n  void define()\n  \{\n    defineParam(mode, \"mode\", 0);\n    defineParam(camY, \"cam_y\", 1200.0f);\n    defineParam(pitch, \"pitch\", 3.0f);\n    defineParam(focal, \"focal\", 40.0f);\n    defineParam(haperture, \"haperture\", 36.0f);\n    defineParam(vaperture, \"vaperture\", 20.25f);\n    defineParam(frameSize, \"frame_size\", float2(1920.0f, 1080.0f));\n    defineParam(sunDir, \"sun_dir\", float3(0.0f, 0.26f, -1.0f));\n    defineParam(cloudH, \"cloud_h\", 3000.0f);\n    defineParam(unit, \"unit\", 10.0f);\n    defineParam(gapBias, \"gap_bias\", 0.0f);\n    defineParam(cloudScale, \"cloud_scale\", 1.0f);\n    defineParam(orthoCenter, \"ortho_center\", float3(0.0f, 0.0f, 0.0f));\n    defineParam(orthoWidth, \"ortho_width\", 100000.0f);\n  \}\n\n  void init()\n  \{\n    float a = pitch * 3.14159265f / 180.0f;\n    cp = cos(a);\n    sp = sin(a);\n    sun = normalize(sunDir);\n    sheetX = sun.x / sun.y * (cloudH - camY) / 1000.0f;\n    sheetZ = sun.z / sun.y * (cloudH - camY) / 1000.0f;\n  \}\n\n  float fr(float v) \{ return v - floor(v); \}\n\n  float hash(float x, float y)\n  \{\n    float a = fr(x * 0.1031f);\n    float b = fr(y * 0.1030f);\n    float c = fr(x * 0.0973f);\n    float d = a * (b + 33.33f) + b * (c + 33.33f) + c * (a + 33.33f);\n    a += d;\n    b += d;\n    c += d;\n    return fr((a + b) * c);\n  \}\n\n  float vn(float x, float y)\n  \{\n    float ix = floor(x);\n    float iy = floor(y);\n    float fx = x - ix;\n    float fy = y - iy;\n    float ux = fx * fx * fx * (fx * (fx * 6.0f - 15.0f) + 10.0f);\n    float uy = fy * fy * fy * (fy * (fy * 6.0f - 15.0f) + 10.0f);\n    float a = hash(ix, iy);\n    float b = hash(ix + 1.0f, iy);\n    float c = hash(ix, iy + 1.0f);\n    float d = hash(ix + 1.0f, iy + 1.0f);\n    return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;\n  \}\n\n  float fbm(float x, float y, int oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float total = 0.0f;\n    for (int i = 0; i < oct; i++) \{\n      s += amp * vn(x, y);\n      total += amp;\n      amp *= 0.5f;\n      float nx = 1.6f * x + 1.2f * y + 13.7f;\n      y = -1.2f * x + 1.6f * y + 7.3f;\n      x = nx;\n    \}\n    return s / total;\n  \}\n\n  float ridged(float x, float y, int oct)\n  \{\n    float s = 0.0f;\n    float amp = 0.5f;\n    float total = 0.0f;\n    for (int i = 0; i < oct; i++) \{\n      float n = 1.0f - fabs(2.0f * vn(x, y) - 1.0f);\n      s += amp * n * n;\n      total += amp;\n      amp *= 0.5f;\n      float nx = 1.7f * x + 1.1f * y + 5.1f;\n      y = -1.1f * x + 1.7f * y + 9.2f;\n      x = nx;\n    \}\n    return s / total;\n  \}\n\n  float smax(float a, float b, float k)\n  \{\n    float h = clamp(0.5f + 0.5f * (a - b) / k, 0.0f, 1.0f);\n    return b + (a - b) * h + k * h * (1.0f - h);\n  \}\n\n  float ridgeTerm(float x, float z, float zi, float hi, float ai, float wi, float seed, float cur)\n  \{\n    float d0 = -z - zi;\n    if (fabs(d0) > 4.5f * wi)\n      return cur;\n    float shift = (vn(x / (zi * 0.4f) + seed, seed * 3.1f) - 0.5f) * wi * 1.8f;\n    float crest = hi + ai * (fbm(x / (zi * 0.16f + 150.0f) + seed * 7.0f, seed * 1.7f, 4) - 0.5f) * 2.4f;\n    float d = (d0 - shift) / wi;\n    float v = 350.0f + (crest - 350.0f) * exp(-d * d);\n    return smax(cur, v, wi * 0.12f);\n  \}\n\n  // Height of the land at x, z. `t` is the viewing distance, for level of detail.\n  float terrain(float x, float z, float t)\n  \{\n    float h = 350.0f;\n    h = ridgeTerm(x, z, 1300.0f, 965.0f, 30.0f, 330.0f, 1.0f, h);\n    h = ridgeTerm(x, z, 2500.0f, 960.0f, 60.0f, 700.0f, 2.0f, h);\n    h = ridgeTerm(x, z, 5000.0f, 938.0f, 90.0f, 1300.0f, 3.0f, h);\n    h = ridgeTerm(x, z, 9000.0f, 950.0f, 130.0f, 2200.0f, 4.0f, h);\n    h = ridgeTerm(x, z, 15000.0f, 1040.0f, 180.0f, 3500.0f, 5.0f, h);\n    h = ridgeTerm(x, z, 24000.0f, 1200.0f, 260.0f, 5000.0f, 6.0f, h);\n    h = ridgeTerm(x, z, 38000.0f, 1600.0f, 320.0f, 7000.0f, 7.0f, h);\n    float rel = clamp((h - 350.0f) / 550.0f, 0.0f, 1.0f);\n    int oct = t < 6000.0f ? 5 : (t < 18000.0f ? 4 : 3);\n    h += rel * 105.0f * (ridged(x / 1500.0f, z / 1500.0f, oct) - 0.45f);\n    if (t < 9000.0f)\n      h += rel * 22.0f * (fbm(x / 120.0f, z / 120.0f, 3) - 0.5f);\n    // Tree crowns on the near ridges: one cone per cell, inside the cell so they stay continuous.\n    if (t < 3500.0f && rel > 0.1f) \{\n      // Two rotated grids of crowns at different sizes, so no rows line up.\n      float tree = 0.0f;\n      float tall = 0.0f;\n      for (int g = 0; g < 2; g++) \{\n        float ca = g == 0 ? 0.80f : 0.34f;\n        float sa = g == 0 ? 0.60f : 0.94f;\n        float cell = g == 0 ? 10.5f : 15.5f;\n        float gx = (ca * x + sa * z) / cell + g * 17.3f;\n        float gz = (-sa * x + ca * z) / cell + g * 5.9f;\n        float cx = floor(gx);\n        float cz = floor(gz);\n        float jx = hash(cx, cz) * 0.5f + 0.25f;\n        float jz = hash(cz + 3.0f, cx + 7.0f) * 0.5f + 0.25f;\n        float dx = gx - cx - jx;\n        float dz = gz - cz - jz;\n        float cone = max(0.0f, 1.0f - sqrt(dx * dx + dz * dz) / 0.25f);\n        float th = 7.0f + 22.0f * hash(cx + 11.0f, cz + 5.0f) * hash(cz + 2.0f, cx + 9.0f);\n        tall = max(tall, cone * th);\n      \}\n      tree = 1.0f;\n      h += tree * tall * (1.0f - clamp((t - 2200.0f) / 1300.0f, 0.0f, 1.0f));\n    \}\n    return h;\n  \}\n\n  float3 viewRay(float u, float v)\n  \{\n    float cx = (u - 0.5f) * haperture / focal;\n    float cy = (v - 0.5f) * vaperture / focal;\n    return float3(cx, cy * cp + sp, cy * sp - cp);\n  \}\n\n  float4 marchTerrain(float3 o, float3 d)\n  \{\n    float t = 300.0f;\n    float tPrev = t;\n    int hit = 0;\n    for (int i = 0; i < 300; i++) \{\n      float3 p = o + d * t;\n      if (p.y > 2800.0f && d.y > 0.0f)\n        break;\n      float gap = p.y - terrain(p.x, p.z, t);\n      if (gap < 0.0f) \{\n        hit = 1;\n        break;\n      \}\n      tPrev = t;\n      t += max(gap * 0.5f, t * 0.002f + 0.5f);\n      if (t > 70000.0f)\n        break;\n    \}\n    if (hit == 0)\n      return float4(0.0f);\n    float a = tPrev;\n    float b = t;\n    for (int i = 0; i < 6; i++) \{\n      float m = 0.5f * (a + b);\n      float3 p = o + d * m;\n      if (p.y - terrain(p.x, p.z, m) < 0.0f)\n        b = m;\n      else\n        a = m;\n    \}\n    float3 p = o + d * b;\n    return float4(p.x * unit, p.y * unit, p.z * unit, 1.0f);\n  \}\n\n  float3 forest(float3 p, float dist)\n  \{\n    float big = fbm(p.x / 700.0f, p.z / 700.0f, 3);\n    float mid = fbm(p.x / 70.0f, p.z / 70.0f, 3);\n    float fine = dist < 5000.0f ? vn(p.x / 6.0f, p.z / 6.0f) : 0.5f;\n    float autumn = clamp((big - 0.48f) * 7.0f, 0.0f, 1.0f) * clamp((mid - 0.3f) * 3.0f, 0.0f, 1.0f);\n    float3 green = float3(0.017f, 0.026f, 0.015f);\n    float3 rust = float3(0.072f, 0.040f, 0.018f);\n    float3 c = green + (rust - green) * autumn;\n    return c * (0.55f + 0.9f * mid) * (0.7f + 0.6f * fine);\n  \}\n\n  float3 normalAt(float3 p, float dist)\n  \{\n    float e = max(1.5f, dist * 0.0012f);\n    float hx = terrain(p.x + e, p.z, dist) - terrain(p.x - e, p.z, dist);\n    float hz = terrain(p.x, p.z + e, dist) - terrain(p.x, p.z - e, dist);\n    return normalize(float3(-hx / (2.0f * e), 1.0f, -hz / (2.0f * e)));\n  \}\n\n  float sunShadow(float3 p)\n  \{\n    float s = 30.0f;\n    float lit = 1.0f;\n    for (int i = 0; i < 26; i++) \{\n      float3 q = p + sun * s;\n      if (q.y > 2300.0f)\n        break;\n      float gap = q.y - terrain(q.x, q.z, 20000.0f);\n      lit = min(lit, clamp(gap / (s * 0.05f) + 0.5f, 0.0f, 1.0f));\n      if (lit <= 0.0f)\n        break;\n      s *= 1.28f;\n    \}\n    return lit;\n  \}\n\n  float cloudField(float X, float Z, int oct)\n  \{\n    float x = X * cloudScale;\n    float z = Z * cloudScale;\n    float wx = fbm(x * 0.4f + 3.1f, z * 0.4f, 3) - 0.5f;\n    float wz = fbm(x * 0.4f + 9.7f, z * 0.4f + 5.0f, 3) - 0.5f;\n    float base = fbm((x + wx * 2.2f) * 0.55f, (z + wz * 2.2f) * 0.55f, oct);\n    // Ragged, cell-like gaps.\n    float cells = ridged(x * 1.6f + wx * 1.5f, z * 1.6f + wz * 1.5f, 3);\n    base = base - 0.09f * (cells - 0.3f);\n    // Radially stretched structure around the sun's point: gaps here make long coherent beams.\n    float dx = X - sheetX;\n    float dz = Z - sheetZ;\n    float r = sqrt(dx * dx + dz * dz) + 0.05f;\n    float th = atan2(dx, -dz);\n    float wedge = clamp(1.4f - r / 22.0f, 0.0f, 1.0f) * clamp((r - 2.0f) / 4.0f, 0.0f, 1.0f);\n    float rad = fbm(th * 34.0f + 40.0f, log(r) * 1.2f, 4) - 0.5f;\n    return base + 0.22f * rad * wedge;\n  \}\n\n  float cloudThreshold(float X, float Z)\n  \{\n    float dx = X - sheetX;\n    float dz = Z - sheetZ;\n    float r = sqrt(dx * dx + dz * dz);\n    // Broken around the sun and in the wedge of deck below it on screen; closed further out.\n    float wedge = (dz < 0.0f && fabs(dx) < 0.6f * (-dz) && r < 34.0f) ? 0.42f : 0.0f;\n    float openness = max(0.75f * exp(-r * r / 30.0f), wedge * clamp(1.2f - r / 34.0f, 0.0f, 1.0f));\n    return 0.30f + gapBias + 0.13f * openness;\n  \}\n  // Opacity of the deck at a point on it, in km.\n  float cloudAlpha(float X, float Z)\n  \{\n    float dist = sqrt(X * X + Z * Z);\n    int oct = dist < 12.0f ? 7 : (dist < 28.0f ? 6 : 4);\n    float dens = clamp((cloudField(X, Z, oct) - cloudThreshold(X, Z)) / (0.2f + dist * 0.008f), 0.0f, 1.0f);\n    float far = clamp((dist - 46.0f) / 22.0f, 0.0f, 1.0f);\n    return (1.0f - exp(-dens * 9.0f)) * (1.0f - far);\n  \}\n\n  float4 clouds(float3 o, float3 d, float3 nd, float &tOut)\n  \{\n    tOut = 0.0f;\n    if (d.y <= 0.004f)\n      return float4(0.0f);\n    float t = (cloudH - o.y) / d.y;\n    tOut = t;\n    float X = t * d.x / 1000.0f;\n    float Z = t * d.z / 1000.0f;\n    float dist = sqrt(X * X + Z * Z);\n    int oct = dist < 12.0f ? 7 : (dist < 28.0f ? 6 : 4);\n    float f = cloudField(X, Z, oct);\n    float T = cloudThreshold(X, Z);\n    float dens = clamp((f - T) / (0.2f + dist * 0.008f), 0.0f, 1.0f);\n    // Far away the deck closes up into a solid-looking line.\n    float far = clamp((dist - 46.0f) / 22.0f, 0.0f, 1.0f);\n    float alpha = 1.0f - exp(-dens * 9.0f);\n    alpha = alpha * (1.0f - far);\n    // Light comes from the sun's side of each puff: sample the field a little towards it.\n    float lx = sheetX - X;\n    float lz = sheetZ - Z;\n    float ll = sqrt(lx * lx + lz * lz) + 1e-3f;\n    float f2 = cloudField(X + lx / ll * 0.12f, Z + lz / ll * 0.12f, oct);\n    float toward = clamp((f2 - T) / 0.16f, 0.0f, 1.0f);\n    float sd = max(dot(nd, sun), 0.0f);\n    float edge = exp(-toward * 4.0f) * exp(-dens * 3.5f);\n    float nearSun = pow(sd, 40.0f) * 1.3f + pow(sd, 10.0f) * 0.07f + 0.006f;\n    float body = 0.55f + 0.9f * (fbm(X * 1.5f + 2.0f, Z * 1.5f, 4) - 0.5f);\n    float3 under = float3(0.075f, 0.082f, 0.105f) * body;\n    float3 silver = float3(5.0f, 3.8f, 2.4f);\n    float3 c = under + silver * (edge * nearSun);\n    return float4(c.x * alpha, c.y * alpha, c.z * alpha, alpha);\n  \}\n\n  void process(int2 xy)\n  \{\n    float u = (xy.x + 0.5f) / frameSize.x;\n    float v = (xy.y + 0.5f) / frameSize.y;\n    float3 o = float3(0.0f, camY, 0.0f);\n    float3 d = viewRay(u, v);\n    float3 nd = normalize(d);\n\n    if (mode == 0) \{\n      dst() = marchTerrain(o, d);\n      return;\n    \}\n    if (mode == 5) \{\n      float th = atan2(sun.x, sun.z);\n      float ph = -asin(sun.y);\n      float3 ax = float3(cos(th), 0.0f, -sin(th));\n      float3 ay = float3(sin(ph) * sin(th), cos(ph), sin(ph) * cos(th));\n      float per = orthoWidth / frameSize.x;\n      float3 w = orthoCenter + ax * ((xy.x + 0.5f - 0.5f * frameSize.x) * per) + ay * ((xy.y + 0.5f - 0.5f * frameSize.y) * per);\n      float3 hit = w + sun * ((cloudH - w.y) / sun.y);\n      float a = cloudAlpha(hit.x / 1000.0f, hit.z / 1000.0f);\n      dst() = float4(a, a, a, a);\n      return;\n    \}\n    if (mode == 6) \{\n      float4 Q = src();\n      float3 q = float3(Q.x, Q.y, Q.z) / unit;\n      float3 hit = q + sun * ((cloudH - q.y) / sun.y);\n      float a = 1.0f - cloudAlpha(hit.x / 1000.0f, hit.z / 1000.0f);\n      dst() = float4(a, a, a, Q.w);\n      return;\n    \}\n    if (mode == 3 || mode == 4) \{\n      float t;\n      float4 c = clouds(o, d, nd, t);\n      if (mode == 3)\n        dst() = c;\n      else\n        dst() = float4(t * unit, t * unit, t * unit, 1.0f);\n      return;\n    \}\n\n    float4 P = src();\n    if (P.w < 0.5f) \{\n      if (mode == 2) \{\n        dst() = float4(0.0f);\n        return;\n      \}\n      // Sky.\n      float el = max(nd.y, 0.0f);\n      float sd = max(dot(nd, sun), 0.0f);\n      float k = clamp(el / 0.32f, 0.0f, 1.0f);\n      float3 hor = float3(0.82f, 0.62f, 0.44f);\n      float3 zen = float3(0.14f, 0.2f, 0.34f);\n      float3 c = hor + (zen - hor) * k;\n      float g = 5.0f * pow(sd, 700.0f) + 0.5f * pow(sd, 70.0f) + 0.08f * pow(sd, 8.0f);\n      float disk = 0.0f;\n      c = c + float3(1.0f, 0.86f, 0.66f) * (g + disk);\n      dst() = float4(c.x, c.y, c.z, 0.0f);\n      return;\n    \}\n\n    float3 p = float3(P.x, P.y, P.z) / unit;\n    float dist = length(p - o);\n    float3 n = normalAt(p, dist);\n    float3 alb = forest(p, dist);\n    if (mode == 1) \{\n      float low = clamp((p.y - 350.0f) / 500.0f, 0.25f, 1.0f);\n      float sky = (0.55f + 0.45f * n.y) * low;\n      float3 c = alb * float3(0.42f, 0.55f, 0.85f) * sky * 1.5f;\n      dst() = float4(c.x, c.y, c.z, 1.0f);\n      return;\n    \}\n    float ndl = max(dot(n, sun), 0.0f);\n    float view = max(dot(normalize(o - p), -sun), 0.0f);\n    float shadow = sunShadow(p + n * 2.0f);\n    float through = 0.28f * pow(view, 3.0f);\n    float3 c = alb * float3(16.0f, 12.5f, 7.6f) * ((ndl + through) * shadow);\n    dst() = float4(c.x, c.y, c.z, 1.0f);\n  \}\n\};\n"
 rebuild ""
 RefScene_mode 1
 RefScene_pitch 1.5
 RefScene_sun_dir {0.05055265178 0.2588190451 -0.9646020585}
 rebuild_finalise ""
 name LightAmbient
 xpos 0
 ypos 144
}
add_layer {P P.red P.green P.blue}
Copy {
 inputs 2
 from0 rgba.red
 to0 P.red
 from1 rgba.green
 to1 P.green
 from2 rgba.blue
 to2 P.blue
 name EnvP
 label "world position, sky 0"
 xpos 0
 ypos 240
}
add_layer {light_sun light_sun.red light_sun.green light_sun.blue}
Copy {
 inputs 2
 from0 rgba.red
 to0 light_sun.red
 from1 rgba.green
 to1 light_sun.green
 from2 rgba.blue
 to2 light_sun.blue
 name EnvSunLayer
 label "the sun light group"
 xpos 0
 ypos 336
}
Expression {
 channel0 {rgba.red -rgba.green -rgba.blue none}
 expr0 r+light_sun.red
 channel1 {-rgba.red rgba.green -rgba.blue none}
 expr1 g+light_sun.green
 channel2 {-rgba.red -rgba.green rgba.blue none}
 expr2 b+light_sun.blue
 channel3 none
 name EnvBeauty
 label "beauty = ambient + sun"
 xpos 0
 ypos 384
}
set Neff50400 [stack 0]
Dot {
 name Dot8
 xpos 184
 ypos 483
}
push $Neff8e800
push $Neff50400
Merge2 {
 inputs 2+1
 bbox B
 maskChannelInput rgba.alpha
 invert_mask true
 name CloudsOverSky
 label "clouds over sky; env alpha holds them out"
 xpos 0
 ypos 480
}
Group {
 inputs 5
 name EzCloudShafts
 onCreate "g = nuke.thisNode()\nif g\['bake_first'].value() == 0 and g\['bake_last'].value() == 0:\n    g\['bake_first'].setValue(int(nuke.root()\['first_frame'].value()))\n    g\['bake_last'].setValue(int(nuke.root()\['last_frame'].value()))\ndef _ezcs_check(g):\n    if g.knob('bake_valid') is None:\n        return\n    import hashlib\n    s = \[]\n    for k in \['position_layer', 'scene_scale', 'sun_from', 'sun_direction', 'cloud_height', 'cloud_density', 'shadow_strength', 'gap_contrast', 'gap_threshold', 'outside_frame', 'penumbra', 'samples', 'drift_x', 'drift_z', 'drift_frame', 'shaft_density', 'haze_height', 'shaft_start', 'max_distance', 'sky_distance', 'march_steps', 'color_from', 'shaft_color', 'shaft_intensity', 'soften', 'edge_aware', 'use_cloud_depth', 'sun_view_width', 'render_resolution', 'shafts_resolution']:\n        if g.knob(k):\n            s.append((k, g\[k].toScript()))\n    # Where the camera and sun are now, read as values since those knobs are expressions.\n    s.append(repr(g\['sun_in_use'].value()))\n    s.append(repr(g\['cam_world_matrix'].value()))\n    h = hashlib.md5(repr(s).encode()).hexdigest()\n    import os, re\n    r = g.node('BakeRead')\n    p = (nuke.filename(r) or '') if r is not None else ''\n    fr = int(g\['baked_first'].value())\n    m = re.search('(#+)|%(0?\[0-9]*)d', p)\n    if m is not None:\n        width = len(m.group(1)) if m.group(1) else int(m.group(2) or 1)\n        p = p\[:m.start()] + str(fr).zfill(width) + p\[m.end():]\n    ok = bool(g\['baked_hash'].value()) and g\['baked_hash'].value() == h and os.path.exists(p)\n    if bool(g\['bake_valid'].value()) != ok:\n        g\['bake_valid'].setValue(ok)\n    text = ('baked' if ok else 'bake out of date: live') if g\['use_baked'].value() and g\['baked_hash'].value() else ''\n    if g\['label'].value() in ('', 'baked', 'bake out of date: live') and g\['label'].value() != text:\n        g\['label'].setValue(text)\n_ezcs_check(nuke.thisNode())\n"
 knobChanged "if nuke.thisKnob().name() in \['position_layer', 'scene_scale', 'sun_from', 'sun_direction', 'cloud_height', 'cloud_density', 'shadow_strength', 'gap_contrast', 'gap_threshold', 'outside_frame', 'penumbra', 'samples', 'drift_x', 'drift_z', 'drift_frame', 'shaft_density', 'haze_height', 'shaft_start', 'max_distance', 'sky_distance', 'march_steps', 'color_from', 'shaft_color', 'shaft_intensity', 'soften', 'edge_aware', 'use_cloud_depth', 'sun_view_width', 'render_resolution', 'shafts_resolution', 'use_baked', 'bake_file', 'bake_folder', 'baked_hash', 'baked_first', 'inputChange']:\n    def _ezcs_check(g):\n        if g.knob('bake_valid') is None:\n            return\n        import hashlib\n        s = \[]\n        for k in \['position_layer', 'scene_scale', 'sun_from', 'sun_direction', 'cloud_height', 'cloud_density', 'shadow_strength', 'gap_contrast', 'gap_threshold', 'outside_frame', 'penumbra', 'samples', 'drift_x', 'drift_z', 'drift_frame', 'shaft_density', 'haze_height', 'shaft_start', 'max_distance', 'sky_distance', 'march_steps', 'color_from', 'shaft_color', 'shaft_intensity', 'soften', 'edge_aware', 'use_cloud_depth', 'sun_view_width', 'render_resolution', 'shafts_resolution']:\n            if g.knob(k):\n                s.append((k, g\[k].toScript()))\n        # Where the camera and sun are now, read as values since those knobs are expressions.\n        s.append(repr(g\['sun_in_use'].value()))\n        s.append(repr(g\['cam_world_matrix'].value()))\n        h = hashlib.md5(repr(s).encode()).hexdigest()\n        import os, re\n        r = g.node('BakeRead')\n        p = (nuke.filename(r) or '') if r is not None else ''\n        fr = int(g\['baked_first'].value())\n        m = re.search('(#+)|%(0?\[0-9]*)d', p)\n        if m is not None:\n            width = len(m.group(1)) if m.group(1) else int(m.group(2) or 1)\n            p = p\[:m.start()] + str(fr).zfill(width) + p\[m.end():]\n        ok = bool(g\['baked_hash'].value()) and g\['baked_hash'].value() == h and os.path.exists(p)\n        if bool(g\['bake_valid'].value()) != ok:\n            g\['bake_valid'].setValue(ok)\n        text = ('baked' if ok else 'bake out of date: live') if g\['use_baked'].value() and g\['baked_hash'].value() else ''\n        if g\['label'].value() in ('', 'baked', 'bake out of date: live') and g\['label'].value() != text:\n            g\['label'].setValue(text)\n    _ezcs_check(nuke.thisNode())\n"
 tile_color 0xb08a4aff
 xpos 0
 ypos 624
 addUserKnob {20 ezcloudshafts l EzCloudShafts}
 addUserKnob {22 analyze t "Reads the cloud height from the clouds' depth (the median of the cloudy pixels), takes the units from the EzAtmosScatter in 'atmos', and reports how much of the ground the gobo reaches. Run it at a frame where the clouds are in view." T "\nimport math\nn = nuke.thisNode()\nframe = nuke.frame()\nnotes = \[]\n\n\ndef up(i, knob):\n    node = n.input(i)\n    while node is not None and not node.knob(knob):\n        node = node.input(0) if node.inputs() else None\n    return node\n\n\natmos = up(3, 'haze_density')\ncam = up(2, 'focal')\nclouds = n.input(1)\nenv = n.input(0)\nif atmos is not None and atmos.knob('scene_scale'):\n    n\['scene_scale'].setValue(atmos\['scene_scale'].value())\n    notes.append('Units to metres %g, from %s.' % (atmos\['scene_scale'].value(), atmos.name()))\nscale = n\['scene_scale'].value()\nif cam is None:\n    notes.append('No camera in the camera input: connect the shot camera.')\nif env is None:\n    notes.append('Nothing in the env input.')\nif clouds is None:\n    notes.append('Nothing in the clouds input.')\n\n# warns: (rank, text), the most important first; the top one becomes the status line.\nwarns = \[]\nif cam is None or env is None or clouds is None:\n    warns.append((0, 'An input is missing: connect env, clouds and camera.'))\n\n# Find the world position and sun light layers by their usual names.\nif env is not None:\n    layers = set()\n    for c in env.channels():\n        layers.add(c.split('.')\[0])\n    if n\['position_layer'].value() not in layers or n\['position_layer'].value() == 'rgba':\n        found = None\n        for want in ('p', 'pworld', 'p_world', 'pw', 'p_w', 'worldp', 'position', 'world_position', 'worldposition',\n                     'position_world', 'pos', 'wp'):\n            for have in sorted(layers):\n                if found is None and have.lower() == want:\n                    found = have\n        if found is not None:\n            n\['position_layer'].setValue(found)\n            notes.append('Position layer: found \"%s\".' % found)\n    if not n\['use_sun_layer'].value():\n        found = None\n        for want in ('light_sun', 'sun', 'sunlight', 'sun_light', 'rgba_sun', 'c_sun', 'lgt_sun', 'lg_sun', 'key',\n                     'key_light', 'light_key', 'rgba_key', 'lgt_key'):\n            for have in sorted(layers):\n                if found is None and have.lower() == want:\n                    found = have\n        if found is not None:\n            n\['sun_layer'].setValue(found)\n            n\['use_sun_layer'].setValue(True)\n            n\['comp_shadow'].setValue(1)\n            notes.append('Sun light layer: found \"%s\", cloud shadow set to 1.' % found)\n\nif cam is not None and clouds is not None:\n    m = \[cam\['world_matrix'].getValueAt(frame, i) for i in range(16)]\n    focal = cam\['focal'].getValueAt(frame)\n    hap = cam\['haperture'].getValueAt(frame)\n    vap = cam\['vaperture'].getValueAt(frame)\n    fmt = clouds.format()\n    efmt = env.format() if env is not None else fmt\n    ox = max(0.0, (fmt.width() - efmt.width()) / 2.0)\n    oy = max(0.0, (fmt.height() - efmt.height()) / 2.0)\n    depth = n\['clouds_depth'].value()\n    if depth not in clouds.channels():\n        notes.append('The clouds input has no %s channel: set \"clouds depth\".' % depth)\n    else:\n        heights = \[]\n        nx, ny = 64, 36\n        for j in range(ny):\n            for i in range(nx):\n                px = (i + 0.5) * fmt.width() / nx\n                py = (j + 0.5) * fmt.height() / ny\n                a = clouds.sample('rgba.alpha', px, py)\n                if a < 0.5:\n                    continue\n                z = clouds.sample(depth, px, py)\n                if z <= 0:\n                    continue\n                u = (px - ox) / (fmt.width() - 2 * ox)\n                v = (py - oy) / (fmt.height() - 2 * oy)\n                cx = (u - 0.5) * hap / focal * z\n                cy = (v - 0.5) * vap / focal * z\n                cz = -z\n                heights.append((m\[4] * cx + m\[5] * cy + m\[6] * cz + m\[7]) * scale)\n        if len(heights) < 10:\n            notes.append('Too little cloud in the clouds alpha (%d of %d samples) to measure its height.'\n                         % (len(heights), nx * ny))\n        else:\n            heights.sort()\n            pick = lambda f: heights\[min(len(heights) - 1, int(f * len(heights)))]\n            if pick(0.5) <= 0:\n                notes.append('The cloud measured below the ground (%.0f m): is the depth Planar Z, in scene '\n                             'units?' % pick(0.5))\n            else:\n                n\['cloud_height'].setValue(round(pick(0.5), 1))\n                notes.append('Cloud height %.0f m (base %.0f m, top %.0f m, from %d samples).'\n                             % (pick(0.5), pick(0.1), pick(0.9), len(heights)))\n\n        # How much of the ground the gobo reaches, from a grid of the env's world positions.\n        layer = n\['position_layer'].value()\n        if env is not None and layer + '.red' in env.channels():\n            sun = \[n\['sun_in_use'].getValueAt(frame, i) for i in range(3)]\n            rot = math.radians(-n\['sun_rotation_in_use'].getValueAt(frame))\n            sun = \[sun\[0] * math.cos(rot) + sun\[2] * math.sin(rot), sun\[1],\n                   -sun\[0] * math.sin(rot) + sun\[2] * math.cos(rot)]\n            norm = math.sqrt(sum(s * s for s in sun)) or 1.0\n            sun = \[s / norm for s in sun]\n            h = n\['cloud_height'].value()\n            cam_pos = \[m\[3] * scale, m\[7] * scale, m\[11] * scale]\n            cz_ok = True\n            ground = covered = 0\n            bounds = clouds.bbox()\n            short = \{'left': 0.0, 'right': 0.0, 'top': 0.0, 'bottom': 0.0\}\n            dists = \[]\n            for j in range(36):\n                for i in range(64):\n                    px = (i + 0.5) * efmt.width() / 64\n                    py = (j + 0.5) * efmt.height() / 36\n                    p = \[env.sample(layer + '.' + c, px, py) * scale\n                         for c in ('red', 'green', 'blue')]\n                    if p == \[0.0, 0.0, 0.0]:\n                        continue\n                    dists.append(math.sqrt((p\[0] - cam_pos\[0]) ** 2 + (p\[1] - cam_pos\[1]) ** 2 +\n                                           (p\[2] - cam_pos\[2]) ** 2))\n                    if p\[1] >= h:\n                        continue\n                    ground += 1\n                    if sun\[1] <= 0.01:\n                        continue\n                    t = (h - p\[1]) / sun\[1]\n                    d = \[p\[k] + sun\[k] * t - cam_pos\[k] for k in range(3)]\n                    cx = m\[0] * d\[0] + m\[4] * d\[1] + m\[8] * d\[2]\n                    cy = m\[1] * d\[0] + m\[5] * d\[1] + m\[9] * d\[2]\n                    cz = m\[2] * d\[0] + m\[6] * d\[1] + m\[10] * d\[2]\n                    if cz > -1e-3:\n                        cz_ok = False\n                        continue\n                    x = ox + (0.5 + cx / -cz * focal / hap) * (fmt.width() - 2 * ox)\n                    y = oy + (0.5 + cy / -cz * focal / vap) * (fmt.height() - 2 * oy)\n                    if bounds.x() <= x < bounds.x() + bounds.w() and bounds.y() <= y < bounds.y() + bounds.h():\n                        covered += 1\n                    else:\n                        short\['left'] = max(short\['left'], bounds.x() - x)\n                        short\['right'] = max(short\['right'], x - bounds.x() - bounds.w())\n                        short\['bottom'] = max(short\['bottom'], bounds.y() - y)\n                        short\['top'] = max(short\['top'], y - bounds.y() - bounds.h())\n            if ground:\n                share = 100.0 * covered / ground\n                notes.append('The gobo reaches %.0f%% of the ground; the rest uses \"outside frame\" (%s).'\n                             % (share, n\['outside_frame'].value()))\n                if share < 90:\n                    need = \[]\n                    for side in ('top', 'left', 'right', 'bottom'):\n                        if short\[side] > 0:\n                            need.append('%s %d px' % (side, short\[side]))\n                    text = 'Gobo reaches only %.0f%% of the ground.' % share\n                    if need and cz_ok:\n                        text += ' Ask CG for more overscan: ' + ', '.join(need) + '.'\n                    else:\n                        text += ' The sun rays land behind the camera, so overscan will not help.'\n                    warns.append((3, text))\n\n            # A first result that shows: haze from how far the scene reaches.\n            if dists:\n                dists.sort()\n                near_km = dists\[len(dists) // 2] / 1000.0\n                far_km = dists\[min(len(dists) - 1, int(len(dists) * 0.99))] / 1000.0\n                n\['scene_depth'].setValue(round(near_km, 3))\n                density = min(2.0, max(0.005, 0.6 / max(near_km, 0.05)))\n                reach = round(max(far_km * 1.2, 1.0), 1)\n                if abs(n\['shaft_density'].value() - 0.1) < 1e-6 and n\['max_distance'].value() == 0:\n                    n\['shaft_density'].setValue(round(density, 3))\n                    n\['max_distance'].setValue(reach)\n                    n\['sky_distance'].setValue(reach)\n                    notes.append('Scene reaches %.1f km (median %.1f km): haze density %.3f /km, max and sky distance '\n                                 '%.1f km.' % (far_km, near_km, density, reach))\n                else:\n                    notes.append('Scene reaches %.1f km (median %.1f km). Haze density around %.3f /km would suit it '\n                                 '(left as it is, since you have set it).' % (far_km, near_km, density))\n                if near_km > 500 or far_km < 0.002:\n                    warns.append((1, 'Units look wrong: the scene is %.3g km deep. Check \"units to metres\".' % near_km))\n        else:\n            notes.append('The env input has no \"%s\" layer: set \"position layer\" to its world position.' % layer)\n\nif cam is not None:\n    m = \[cam\['world_matrix'].getValueAt(frame, i) for i in range(16)]\n    sun = \[n\['sun_in_use'].getValueAt(frame, i) for i in range(3)]\n    rot = math.radians(-n\['sun_rotation_in_use'].getValueAt(frame))\n    sun = \[sun\[0] * math.cos(rot) + sun\[2] * math.sin(rot), sun\[1],\n           -sun\[0] * math.sin(rot) + sun\[2] * math.cos(rot)]\n    norm = math.sqrt(sun\[0] ** 2 + sun\[1] ** 2 + sun\[2] ** 2) or 1.0\n    sun = \[v / norm for v in sun]\n    elev = math.degrees(math.asin(max(-1.0, min(1.0, sun\[1]))))\n    fwd = \[-m\[2], -m\[6], -m\[10]]\n    az = (math.degrees(math.atan2(sun\[0], -sun\[2]) - math.atan2(fwd\[0], -fwd\[2])) + 180.0) % 360.0 - 180.0\n    notes.append('Sun %.0f deg up, %.0f deg %s of where the camera looks.' % (elev, abs(az), 'right' if az > 0 else 'left'))\n    if elev <= 0:\n        warns.append((1, 'The sun is below the horizon (%.0f deg): no beams can form.' % elev))\n    elif abs(az) > 120:\n        warns.append((2, 'The sun is behind the camera (%.0f deg off): beams run away from the lens and the gobo '\n                         'cannot reach. A sun-view clouds render would fix it.' % abs(az)))\n    elif abs(az) > 60:\n        warns.append((2, 'The sun is to the side (%.0f deg off): beams will be faint and the gobo only covers '\n                         'part of the frame.' % abs(az)))\n    elif elev > 55:\n        warns.append((2, 'The sun is high (%.0f deg): beams fall almost straight down and will not fan out.' % elev))\n    height = n\['cloud_height'].value()\n    cam_m = m\[7] * n\['scene_scale'].value()\n    if abs(cam_m) > 20000:\n        warns.append((1, 'Units look wrong: the camera is %.0f km up. Check \"units to metres\".' % (cam_m / 1000.0)))\n    if height <= cam_m:\n        warns.append((1, 'Cloud height (%.0f m) is at or below the camera (%.0f m): nothing can cast from there.'\n                         % (height, cam_m)))\n    elif height > 15000:\n        warns.append((1, 'Cloud height %.0f m is implausibly high. It is in metres whatever the scene units are.' % height))\n\nif n\['sun_view_on'].value():\n    kept = \[]\n    for w in warns:\n        if 'gobo' not in w\[1].lower():\n            kept.append(w)\n    warns = kept\n    notes.append('Sun-view clouds in use: the gobo is not limited to the frame.')\nwarns.sort()\nstatus = warns\[0]\[1] if warns else 'OK: the sun, units and gobo all look right.'\nn\['status'].setValue(status)\nif warns:\n    notes.append('')\n    for rank, text in warns:\n        notes.append('Warning: ' + text)\nnuke.message('EzCloudShafts analyze\\n\\n' + '\\n'.join(notes))\n" +STARTLINE}
 addUserKnob {4 view t "What the main rgb shows. The passes are always written to the shafts and cloudshadow layers; Comp is the finished look (see the Comp knobs). Passthrough leaves rgba as the env render. Lit Share shows shafts_lit: 1 where the haze is sunlit, 0 under cloud." -STARTLINE M {Passthrough "Shafts Over Env" "Shadow Matte" "Gobo Check" "Shafts Matte" "Lit Share" Comp}}
 view Comp
 addUserKnob {22 layer_breakout l "layer breakout" t "Builds the Comp view from this node's layers next to it, as plain nodes: cloud shadow on the sun light, haze from shafts_lit, then the shafts. Their values follow the Comp knobs, and a Difference at the bottom is black while 'view' is Comp." -STARTLINE T "\nn = nuke.thisNode()\nenv = n.input(0)\nif env is None:\n    nuke.message('EzCloudShafts: connect the env input first.')\nelse:\n    N = n.name()\n    col, row = 180, 60\n    x0, y0 = n.xpos() + 300, n.ypos() + 60\n    with (n.parent() or nuke.root()):\n        for other in nuke.allNodes():\n            other.setSelected(False)\n        made = \[]\n\n        def place(node, cx, cy, src=None, src2=None):\n            node.setXYpos(int(x0 + cx * col), int(y0 + cy * row))\n            if src is not None:\n                node.setInput(0, src)\n            if src2 is not None:\n                node.setInput(1, src2)\n            made.append(node)\n            return node\n\n        def dot(cx, cy, src):\n            d = nuke.nodes.Dot()\n            d.setXYpos(int(x0 + cx * col + 34), int(y0 + cy * row + 4))\n            d.setInput(0, src)\n            made.append(d)\n            return d\n\n        def pick(layer, cx, src):\n            sh = nuke.nodes.Shuffle2(name='%s_%s' % (n.name(), layer), label='%s to rgba' % layer)\n            sh\['in1'].setValue(layer)\n            return place(sh, cx, 1, src)\n\n        def expr(name, label, exprs, cx, cy, src):\n            e = nuke.nodes.Expression(name='%s_%s' % (n.name(), name), label=label)\n            for i, text in enumerate(exprs):\n                e\['expr%d' % i].setValue(text.replace('N.', N + '.'))\n            return place(e, cx, cy, src)\n\n        # Row 0: the env trunk on the left, then a row of Dots from the node, one per layer.\n        trunk = dot(0, 0, env)\n        heads = \[dot(2, 0, n)]\n        for cx in (3, 4, 5):\n            heads.append(dot(cx, 0, heads\[-1]))\n        shadow = pick('cloudshadow', 2, heads\[0])\n        lit = pick('shafts_lit', 3, heads\[1])\n        shafts = pick('shafts', 4, heads\[2])\n        haze_col = pick('shafts_haze', 5, heads\[3])\n\n        # Cloud shadow: take the shadowed share of the sun light away from the env.\n        if n\['use_sun_layer'].value():\n            sun_dot = dot(1, 0, trunk)\n            sun = nuke.nodes.Shuffle2(name='%s_sunlight' % n.name(), label='sun light to rgba')\n            sun\['in1'].setValue(n\['sun_layer'].value())\n            sun = place(sun, 1, 1, sun_dot)\n        else:\n            sun = dot(1, 0, trunk)\n        amount = expr('shadow_amount', 'sun lost under cloud',\n                      \['(1-a)*N.comp_shadow'] * 3 + \['a'], 2, 3, shadow)\n        lost = place(nuke.nodes.Merge2(operation='multiply', output='rgb', label='sun light x lost'),\n                     1, 3, amount, sun)\n        land = place(nuke.nodes.Merge2(operation='from', output='rgb', label='cloud shadow'), 0, 4, trunk, lost)\n\n        # Haze: transmittance from shafts_lit.a, haze light graded by the lit share.\n        trans = expr('haze_transmittance', 'T = (1 - haze) ^ amount',\n                     \['pow(clamp(1-a,0,1), N.comp_haze*N.comp_haze_falloff.%s)' % c for c in 'rgb'] + \['r'],\n                     3, 5, lit)\n        hazed = place(nuke.nodes.Merge2(operation='multiply', output='rgb', label='land x T'), 0, 6, land,\n                      dot(3, 6, trans))\n        light = expr('haze_light', '(1 - T) x lit grade',\n                     \['(1-%s)*(N.comp_haze_shadow+(N.comp_haze_lit-N.comp_haze_shadow)*a)'\n                      % c for c in 'rgb'] + \['a'], 3, 7, trans)\n        tinted = place(nuke.nodes.Merge2(operation='multiply', output='rgb', label='x haze colour'), 3, 8, light,\n                       dot(5, 8, haze_col))\n        with_haze = place(nuke.nodes.Merge2(operation='plus', output='rgb', label='+ haze'), 0, 9, hazed,\n                          dot(3, 9, tinted))\n        beams = place(nuke.nodes.Merge2(operation='plus', output='rgb', label='+ shafts'), 0, 10, with_haze,\n                      dot(4, 10, shafts))\n        beams\['mix'].setExpression(N + '.comp_shafts')\n\n        # Check against the node's own Comp view: black when 'view' is Comp.\n        check_dot = dot(6, 11, dot(6, 0, heads\[-1]))\n        check = place(nuke.nodes.Merge2(name='%s_breakout_check' % n.name(), operation='difference', output='rgb',\n                                        label='black when view is Comp'), 0, 11, beams, check_dot)\n        made.append(nuke.nodes.BackdropNode(label='%s breakout' % n.name(), note_font_size=24,\n                                            xpos=int(x0 - 60), ypos=int(y0 - 80),\n                                            bdwidth=col * 7 + 60, bdheight=row * 12 + 100))\n        for node in made:\n            node.setSelected(True)\n"}
 addUserKnob {4 look t "A starting point for the haze, beams and Comp knobs. Press Analyze first, so the haze suits the scene's size, then 'apply look'. Reset puts those knobs back to their defaults." M {"Soft Morning" "God Rays" "Storm Break" "Golden Hour" Reset}}
 look "God Rays"
 addUserKnob {22 apply_look l "apply look" t "Sets the knobs from the chosen look." -STARTLINE T "\nimport math\nn = nuke.thisNode()\nlook = n\['look'].value()\n# tau: optical depth at the scene's median distance. height: haze height as a share of it.\n# beam: target brightness of the beams.\nlooks = \{\n    'Soft Morning': dict(tau=0.5, height=0.7, beam=2.8, penumbra=0.8, steps=96, soften=6, gap=1.0,\n                         tint=\[1.0, 0.96, 0.9], haze=\[0.13, 0.17, 0.26], falloff=\[0.85, 1.0, 1.2],\n                         shadow=0.65, lit=1.2),\n    'God Rays': dict(tau=0.35, height=0.45, beam=4.0, penumbra=0.4, steps=128, soften=5, gap=1.0,\n                     tint=\[0.9, 0.95, 1.1], haze=\[0.06, 0.13, 0.33], falloff=\[0.75, 1.0, 1.4],\n                     shadow=0.35, lit=1.5),\n    'Storm Break': dict(tau=0.55, height=0.4, beam=4.0, penumbra=0.3, steps=128, soften=4, gap=2.5,\n                        tint=\[0.85, 0.93, 1.15], haze=\[0.03, 0.05, 0.11], falloff=\[0.9, 1.0, 1.15],\n                        shadow=0.2, lit=1.8),\n    'Golden Hour': dict(tau=0.4, height=0.5, beam=3.4, penumbra=0.5, steps=128, soften=5, gap=1.2,\n                        tint=\[1.25, 0.88, 0.55], haze=\[0.2, 0.12, 0.09], falloff=\[0.6, 1.0, 1.6],\n                        shadow=0.45, lit=1.6),\n\}\nif look == 'Reset':\n    for knob, value in (('shaft_density', 0.1), ('haze_height', 1.2), ('penumbra', 0.5), ('march_steps', 32),\n                        ('soften', 4), ('gap_contrast', 1), ('gap_threshold', 0.5), ('shaft_intensity', 1),\n                        ('comp_haze', 1), ('comp_haze_shadow', 0.35), ('comp_haze_lit', 1.5), ('comp_shafts', 1)):\n        n\[knob].setValue(value)\n    n\['shaft_color'].setValue(1)\n    n\['comp_haze_color'].setValue(\[0.06, 0.13, 0.33])\n    n\['comp_haze_falloff'].setValue(\[0.75, 1.0, 1.4])\nelse:\n    p = looks\[look]\n    depth = n\['scene_depth'].value()\n    if depth <= 0:\n        depth = 3.0\n        nuke.message('This look used a guessed scene depth of 3 km. Press Analyze, then apply it again.')\n    # How bright the beams' colour is along the sun, so the look doesn't depend on the atmos's level.\n    level = 1.0\n    if int(n\['color_from'].getValue()) == 0 and n\['atm_found'].value():\n        sun = \[n\['sun_in_use'].value(i) for i in range(3)]\n        norm = math.sqrt(sun\[0] ** 2 + sun\[1] ** 2 + sun\[2] ** 2) or 1.0\n        with n:\n            src = nuke.toNode('AtmosOrNone')\n            if n\['atm_screen'].value():\n                u, v = 0.5, 0.9\n            else:\n                lon = math.atan2(sun\[0], -sun\[2]) - math.radians(n\['atm_rotation'].value())\n                u = (lon / (2 * math.pi) + 0.5) % 1.0\n                v = math.asin(max(-1.0, min(1.0, sun\[1] / norm))) / math.pi + 0.5\n            level = max(src.sample('green', u * src.width(), v * src.height()), 1e-3)\n    n\['shaft_density'].setValue(round(p\['tau'] / depth, 4))\n    n\['haze_height'].setValue(round(min(5.0, max(0.2, p\['height'] * depth)), 2))\n    n\['penumbra'].setValue(p\['penumbra'])\n    n\['march_steps'].setValue(p\['steps'])\n    n\['soften'].setValue(p\['soften'])\n    n\['gap_contrast'].setValue(p\['gap'])\n    n\['gap_threshold'].setValue(0.5)\n    n\['shaft_color'].setValue(p\['tint'])\n    n\['shaft_intensity'].setValue(round(p\['beam'] / level, 4))\n    n\['comp_haze'].setValue(1)\n    n\['comp_haze_color'].setValue(p\['haze'])\n    n\['comp_haze_falloff'].setValue(p\['falloff'])\n    n\['comp_haze_shadow'].setValue(p\['shadow'])\n    n\['comp_haze_lit'].setValue(p\['lit'])\n    n\['comp_shafts'].setValue(1)\n"}
 addUserKnob {1 status t "The main warning from the last Analyze. It doesn't update by itself: press Analyze again." +DISABLED}
 status "Press Analyze to check the setup."
 addUserKnob {7 scene_depth +INVISIBLE}
 addUserKnob {4 viewer_resolution l "viewer resolution" t "Size the passes are computed at in the Nuke GUI, then scaled back up. Half is about four times faster than Full. Renders from a terminal or the farm use 'render resolution'." M {Full Half Quarter}}
 viewer_resolution Half
 addUserKnob {4 render_resolution l "render resolution" t "Size the passes are computed at when rendering outside the GUI (terminal, farm)." -STARTLINE M {Full Half Quarter}}
 addUserKnob {4 shafts_resolution l "shafts at" t "The shafts are soft, so they can be computed smaller again than the ground matte: Half of the viewer or render resolution is four times faster and rarely shows." -STARTLINE M {Same Half Quarter}}
 addUserKnob {7 matte_scale +INVISIBLE}
 matte_scale {{"(\$gui ? viewer_resolution : render_resolution) == 0 ? 1 : (\$gui ? viewer_resolution : render_resolution) == 1 ? 0.5 : 0.25"}}
 addUserKnob {7 shafts_scale +INVISIBLE}
 shafts_scale {{"matte_scale * (shafts_resolution == 0 ? 1 : shafts_resolution == 1 ? 0.5 : 0.25)"}}
 addUserKnob {26 inputs_divider l Inputs}
 addUserKnob {41 position_layer l "position layer" t "Layer of the env render holding world position (P World), in scene units." T PositionPick.in1}
 addUserKnob {1 clouds_depth l "clouds depth" t "Channel of the clouds input holding its depth (Planar Z, scene units). Only analyze reads it."}
 clouds_depth depth.Z
 addUserKnob {7 scene_scale l "units to metres" t "Scene units to metres: 0.1 for decimetres. Analyze takes it from the EzAtmosScatter in 'atmos'."}
 scene_scale 0.1
 addUserKnob {26 sun_divider l Sun}
 addUserKnob {4 sun_from l "sun from" t "Auto: the Axis in the 'sun' input if there is one, else the EzAtmosScatter in 'atmos', else 'sun direction'. The Axis's world position is the direction towards the sun." M {Auto "Sun Input (Axis)" EzAtmosScatter Manual}}
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up, used when there is no Axis or atmos (or 'sun from' is Manual)."}
 sun_direction {0 0.5 -1}
 addUserKnob {13 sun_in_use l "sun in use" t "The sun direction in use, whichever 'sun from' picked. Read only." +DISABLED}
 sun_in_use {{"sun_source==1 ? axis_position.x : sun_source==2 ? atm_sun.x : sun_direction.x"} {"sun_source==1 ? axis_position.y : sun_source==2 ? atm_sun.y : sun_direction.y"} {"sun_source==1 ? axis_position.z : sun_source==2 ? atm_sun.z : sun_direction.z"}}
 addUserKnob {7 sun_rotation_in_use l "sun rotation" +INVISIBLE}
 sun_rotation_in_use {{"sun_source==2 ? atm_rotation : 0"}}
 addUserKnob {26 clouds_divider l "Cloud gobo"}
 addUserKnob {4 cast_from l "cast from" t "What casts the shadows. Clouds render: the clouds input's alpha, as a sheet at 'cloud height' (or the sunclouds render). EzCloudGen volumes: the cloud_sunmap layer of an EzCloudGen in the clouds input, so rays and ground shadows come from the real volumes: tall clouds, and clouds above or beside the frame, cast as they should, and 'cloud height' isn't used. Auto picks the volumes when the clouds input is an EzCloudGen with 'sun shadow layer' and 'breakout layers' on." M {Auto "Clouds render" "EzCloudGen volumes"}}
 addUserKnob {7 cloud_height l "cloud height (m)" t "Height of the cloud sheet above the scene's 0, in metres. Analyze measures it from the clouds' depth; raise or lower it to slide the shadows along the sun." R 0 8000}
 cloud_height 3000
 addUserKnob {7 cloud_density l "cloud density" t "Multiplies the clouds alpha: above 1 thin cloud blocks more sun." R 0 3}
 cloud_density 1
 addUserKnob {7 gap_contrast l "gap contrast" t "Levels on the clouds' alpha before it is used as the gobo. Above 1 thin, soft clouds become more clearly solid or clear, for crisper beams. 1 with threshold 0.5 changes nothing." R 0.1 10}
 gap_contrast 1
 addUserKnob {7 gap_threshold l "gap threshold" t "The alpha that stays at 0.5 under 'gap contrast'. Higher opens more gaps; lower closes them."}
 gap_threshold 0.5
 addUserKnob {6 use_cloud_depth l "use cloud depth" t "Casts each cloud from the height its depth says, instead of one flat 'cloud height'. For clouds at clearly different heights; needs a good depth channel. Off suits a single layer." +STARTLINE}
 addUserKnob {7 sun_view_width l "sun view width" t "With the 'sunclouds' input: the width the sun-view render covers, in scene units (the orthographic camera's width)." R 0 1e+06}
 sun_view_width 100000
 addUserKnob {7 shadow_strength l "shadow strength" t "How much sunlight the cloud takes away: 1 is all of it."}
 shadow_strength 1
 addUserKnob {4 outside_frame l "outside frame" t "Where the sun ray meets the cloud sheet outside the clouds render (past its overscan), as the camera sees it: count it as a gap (Lit) or as cloud (Shadowed)." M {Lit Shadowed}}
 addUserKnob {7 penumbra l "softness (deg)" t "Spreads the sun over a cone this wide, so shadow edges soften the further they fall from the cloud. The real sun is about 0.27." R 0 5}
 penumbra 0.4
 addUserKnob {3 samples l "softness samples" t "Sun directions averaged for the ground matte. More is smoother and slower."}
 samples 8
 addUserKnob {7 drift_x l "drift x (m/frame)" t "Moves the cloud shadows across the ground over time, for clouds rendered still." R -20 20}
 addUserKnob {7 drift_z l "drift z (m/frame)" t "Moves the cloud shadows across the ground over time, for clouds rendered still." R -20 20}
 addUserKnob {3 drift_frame l "drift from frame" t "The frame where the drift is 0."}
 drift_frame 1001
 addUserKnob {26 shafts_divider l Shafts}
 addUserKnob {7 shaft_density l "haze density (1/km)" t "How much the air in front of the terrain scatters the sun at camera height: more gives stronger beams. 0.1 is light haze."}
 shaft_density 0.12
 addUserKnob {7 haze_height l "haze height (km)" t "Height over which the haze thins out by a factor of e." R 0.1 5}
 haze_height 1.3
 addUserKnob {7 shaft_start l "start (m)" t "Air nearer than this has no beams." R 0 2000}
 addUserKnob {7 max_distance l "max distance (km)" t "Air further than this has no beams. 0 runs to the terrain." R 0 50}
 max_distance 45
 addUserKnob {7 sky_distance l "sky distance (km)" t "How far the beams reach where there is no terrain (sky), if the cloud sheet is not met first." R 1 100}
 sky_distance 45
 addUserKnob {3 march_steps l steps t "Steps along each view ray. More gives cleaner beams and is slower."}
 march_steps 128
 addUserKnob {4 color_from l "colour from" t "EzAtmosScatter: the sunlit haze colour of the atmos input (atmos_haze_sun along the view), times 'shaft color'. Color: 'shaft color' alone. Without an atmos input it is Color." M {EzAtmosScatter Color}}
 addUserKnob {18 shaft_color l "shaft color" t "Colour of the beams, or a tint on the atmos colour."}
 shaft_color {0.9 0.95 1.1}
 addUserKnob {6 shaft_color_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 shaft_intensity l intensity t "Multiplies the beams, rgb and matte." R 0 10}
 shaft_intensity 0.24
 addUserKnob {7 soften l "soften (px)" t "Blurs the shafts and shafts_lit layers to take out the sampling grain of long rays. 0 is off." R 0 20}
 soften 5
 addUserKnob {6 edge_aware l "edge aware" t "Keeps the softening from blurring beams across ridge lines, using the distance to the camera from the position layer. Off is a plain blur, which is a little faster." -STARTLINE}
 edge_aware true
 addUserKnob {26 comp_divider l Comp}
 addUserKnob {7 comp_shadow l "cloud shadow" t "How much of the sun light the cloud shadow takes off the env: 0 none, 1 all of it. Use 1 with a sun light layer; without one the whole env is darkened, so keep it lower."}
 comp_shadow 1
 addUserKnob {6 use_sun_layer l "sun light layer" t "On: the cloud shadow only darkens the env's sun light group, picked on the right (the beauty must be the sum of its light groups). Off: it darkens the whole env." +STARTLINE}
 use_sun_layer true
 addUserKnob {41 sun_layer l "" t "Layer of the env render holding the sun's light group." -STARTLINE T SunPick.in1}
 addUserKnob {7 comp_haze l "haze amount" t "How strongly the haze veils the env with distance. 0 is no haze: only the shadow and the shafts." R 0 3}
 comp_haze 1
 addUserKnob {18 comp_haze_color l "haze color" t "Colour of the haze light."}
 comp_haze_color {0.06 0.13 0.33}
 addUserKnob {6 comp_haze_color_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {4 comp_haze_from l "haze color from" t "Color: 'haze color'. EzAtmosScatter: the atmos's sky haze along each view ray, times 'haze tint', so the air matches the sky. Without an atmos input it is Color." M {Color EzAtmosScatter}}
 addUserKnob {18 comp_haze_tint l "haze tint" t "Multiplies the atmos's sky haze."}
 comp_haze_tint 1
 addUserKnob {6 comp_haze_tint_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {18 comp_haze_falloff l "haze falloff" t "How fast each colour fades with distance: higher fades sooner. Blue above red gives the warm near, blue far of aerial perspective."}
 comp_haze_falloff {0.75 1 1.4}
 addUserKnob {6 comp_haze_falloff_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 comp_haze_shadow l "haze in shadow" t "Brightness of the haze where the cloud shades it: below 1 darkens the air between the beams." R 0 2}
 comp_haze_shadow 0.35
 addUserKnob {7 comp_haze_lit l "haze in sun" t "Brightness of the haze where the sun reaches it." R 0 4}
 comp_haze_lit 1.5
 addUserKnob {7 comp_shafts l shafts t "How much of shafts.rgb is added on top." R 0 2}
 comp_shafts 1
 addUserKnob {26 bake_divider l Bake}
 addUserKnob {2 bake_folder l "bake folder" t "Where bakes go, for example on the job so the farm can read them. Each script and node gets its own subfolder. \$VAR and \[getenv VAR] work. Empty: an ezcloudshafts_cache folder beside the script."}
 bake_folder "\[getenv NUKE_TEMP_DIR]/ezCloudShafts"
 addUserKnob {2 bake_file l "bake file" t "Leave empty to use 'bake folder'. A full file path with #### overrides it for this node."}
 addUserKnob {3 bake_first l "bake range" t "First frame to bake."}
 bake_first 1001
 addUserKnob {3 bake_last l "" t "Last frame to bake." -STARTLINE}
 bake_last 1001
 addUserKnob {22 bake_now l "bake now" t "Writes the shafts, shafts_lit and cloudshadow layers to the bake file here and now." T "g = nuke.thisNode()\nimport os\npath = nuke.filename(g.node('BakeRead')) or ''\nbad = '' if path and os.path.isabs(path) else ('the bake folder uses an environment variable that '\n    'is not set in Nuke' if path == '' else 'the bake path is not a full path: ' + path)\nif not bad and not path.lower().endswith('.exr'):\n    bad = 'bake file is a folder, not a file name like name.####.exr'\nif not bad and not os.path.isdir(os.path.dirname(path)):\n    try:\n        os.makedirs(os.path.dirname(path))\n    except OSError as e:\n        bad = 'cannot create ' + os.path.dirname(path) + ' (' + str(e.strerror or e) + ')'\nif bad:\n    nuke.message('Not baked: ' + bad + '.')\nif not bad:\n    import hashlib\n    s = \[]\n    for k in \['position_layer', 'scene_scale', 'sun_from', 'sun_direction', 'cloud_height', 'cloud_density', 'shadow_strength', 'gap_contrast', 'gap_threshold', 'outside_frame', 'penumbra', 'samples', 'drift_x', 'drift_z', 'drift_frame', 'shaft_density', 'haze_height', 'shaft_start', 'max_distance', 'sky_distance', 'march_steps', 'color_from', 'shaft_color', 'shaft_intensity', 'soften', 'edge_aware', 'use_cloud_depth', 'sun_view_width', 'render_resolution', 'shafts_resolution']:\n        if g.knob(k):\n            s.append((k, g\[k].toScript()))\n    # Where the camera and sun are now, read as values since those knobs are expressions.\n    s.append(repr(g\['sun_in_use'].value()))\n    s.append(repr(g\['cam_world_matrix'].value()))\n    h = hashlib.md5(repr(s).encode()).hexdigest()\n    first, last = int(g\['bake_first'].value()), int(g\['bake_last'].value())\n    if last < first:\n        first, last = last, first\n    use = g\['use_baked'].value()\n    g\['use_baked'].setValue(False)\n    try:\n        with g:\n            nuke.execute(nuke.toNode('BakeWrite'), first, last)\n        g\['baked_hash'].setValue(h)\n        g\['baked_first'].setValue(first)\n        g\['baked_last'].setValue(last)\n    finally:\n        g\['use_baked'].setValue(use)\n    def _ezcs_check(g):\n        if g.knob('bake_valid') is None:\n            return\n        import hashlib\n        s = \[]\n        for k in \['position_layer', 'scene_scale', 'sun_from', 'sun_direction', 'cloud_height', 'cloud_density', 'shadow_strength', 'gap_contrast', 'gap_threshold', 'outside_frame', 'penumbra', 'samples', 'drift_x', 'drift_z', 'drift_frame', 'shaft_density', 'haze_height', 'shaft_start', 'max_distance', 'sky_distance', 'march_steps', 'color_from', 'shaft_color', 'shaft_intensity', 'soften', 'edge_aware', 'use_cloud_depth', 'sun_view_width', 'render_resolution', 'shafts_resolution']:\n            if g.knob(k):\n                s.append((k, g\[k].toScript()))\n        # Where the camera and sun are now, read as values since those knobs are expressions.\n        s.append(repr(g\['sun_in_use'].value()))\n        s.append(repr(g\['cam_world_matrix'].value()))\n        h = hashlib.md5(repr(s).encode()).hexdigest()\n        import os, re\n        r = g.node('BakeRead')\n        p = (nuke.filename(r) or '') if r is not None else ''\n        fr = int(g\['baked_first'].value())\n        m = re.search('(#+)|%(0?\[0-9]*)d', p)\n        if m is not None:\n            width = len(m.group(1)) if m.group(1) else int(m.group(2) or 1)\n            p = p\[:m.start()] + str(fr).zfill(width) + p\[m.end():]\n        ok = bool(g\['baked_hash'].value()) and g\['baked_hash'].value() == h and os.path.exists(p)\n        if bool(g\['bake_valid'].value()) != ok:\n            g\['bake_valid'].setValue(ok)\n        text = ('baked' if ok else 'bake out of date: live') if g\['use_baked'].value() and g\['baked_hash'].value() else ''\n        if g\['label'].value() in ('', 'baked', 'bake out of date: live') and g\['label'].value() != text:\n            g\['label'].setValue(text)\n    _ezcs_check(nuke.thisNode())\n" +STARTLINE}
 addUserKnob {22 bake_farm_write l "make farm bake Write" t "Adds a Write below this node with the bake path, to render on the farm before the comp." -STARTLINE T "g = nuke.thisNode()\nimport os\npath = nuke.filename(g.node('BakeRead')) or ''\nbad = '' if path and os.path.isabs(path) else ('the bake folder uses an environment variable that '\n    'is not set in Nuke' if path == '' else 'the bake path is not a full path: ' + path)\nif not bad and not path.lower().endswith('.exr'):\n    bad = 'bake file is a folder, not a file name like name.####.exr'\nif not bad and not os.path.isdir(os.path.dirname(path)):\n    try:\n        os.makedirs(os.path.dirname(path))\n    except OSError as e:\n        bad = 'cannot create ' + os.path.dirname(path) + ' (' + str(e.strerror or e) + ')'\nif bad:\n    nuke.message('Not baked: ' + bad + '.')\nif not bad:\n    import hashlib\n    s = \[]\n    for k in \['position_layer', 'scene_scale', 'sun_from', 'sun_direction', 'cloud_height', 'cloud_density', 'shadow_strength', 'gap_contrast', 'gap_threshold', 'outside_frame', 'penumbra', 'samples', 'drift_x', 'drift_z', 'drift_frame', 'shaft_density', 'haze_height', 'shaft_start', 'max_distance', 'sky_distance', 'march_steps', 'color_from', 'shaft_color', 'shaft_intensity', 'soften', 'edge_aware', 'use_cloud_depth', 'sun_view_width', 'render_resolution', 'shafts_resolution']:\n        if g.knob(k):\n            s.append((k, g\[k].toScript()))\n    # Where the camera and sun are now, read as values since those knobs are expressions.\n    s.append(repr(g\['sun_in_use'].value()))\n    s.append(repr(g\['cam_world_matrix'].value()))\n    h = hashlib.md5(repr(s).encode()).hexdigest()\n    first, last = int(g\['bake_first'].value()), int(g\['bake_last'].value())\n    if last < first:\n        first, last = last, first\n    with (g.parent() or nuke.root()):\n        w = nuke.nodes.Write(name=g.name() + '_BakeWrite', file=path, file_type='exr', channels='all')\n        w\['create_directories'].setValue(True)\n        w\['use_limit'].setValue(True)\n        w\['first'].setValue(first)\n        w\['last'].setValue(last)\n        w.setInput(0, g)\n        w.setXYpos(g.xpos(), g.ypos() + 80)\n    g\['baked_hash'].setValue(h)\n    g\['baked_first'].setValue(first)\n    g\['baked_last'].setValue(last)\n    g\['bake_valid'].setValue(True)\n    if nuke.GUI:\n        nuke.message('Render %s on the farm before the comp. It writes ' % w.name() + path)\n"}
 addUserKnob {6 use_baked l "use baked" t "Read the bake instead of computing, but only while it exists and the settings still match it. Otherwise the node computes live and its label says the bake is out of date. The check runs when a knob or input of this node changes and when the script opens; after changing the camera or clouds upstream, bake again." +STARTLINE}
 use_baked true
 addUserKnob {1 baked_hash +INVISIBLE}
 addUserKnob {3 baked_first +INVISIBLE}
 addUserKnob {3 baked_last +INVISIBLE}
 addUserKnob {6 bake_valid -STARTLINE +INVISIBLE}
 addUserKnob {22 bake_check -STARTLINE +INVISIBLE T "def _ezcs_check(g):\n    if g.knob('bake_valid') is None:\n        return\n    import hashlib\n    s = \[]\n    for k in \['position_layer', 'scene_scale', 'sun_from', 'sun_direction', 'cloud_height', 'cloud_density', 'shadow_strength', 'gap_contrast', 'gap_threshold', 'outside_frame', 'penumbra', 'samples', 'drift_x', 'drift_z', 'drift_frame', 'shaft_density', 'haze_height', 'shaft_start', 'max_distance', 'sky_distance', 'march_steps', 'color_from', 'shaft_color', 'shaft_intensity', 'soften', 'edge_aware', 'use_cloud_depth', 'sun_view_width', 'render_resolution', 'shafts_resolution']:\n        if g.knob(k):\n            s.append((k, g\[k].toScript()))\n    # Where the camera and sun are now, read as values since those knobs are expressions.\n    s.append(repr(g\['sun_in_use'].value()))\n    s.append(repr(g\['cam_world_matrix'].value()))\n    h = hashlib.md5(repr(s).encode()).hexdigest()\n    import os, re\n    r = g.node('BakeRead')\n    p = (nuke.filename(r) or '') if r is not None else ''\n    fr = int(g\['baked_first'].value())\n    m = re.search('(#+)|%(0?\[0-9]*)d', p)\n    if m is not None:\n        width = len(m.group(1)) if m.group(1) else int(m.group(2) or 1)\n        p = p\[:m.start()] + str(fr).zfill(width) + p\[m.end():]\n    ok = bool(g\['baked_hash'].value()) and g\['baked_hash'].value() == h and os.path.exists(p)\n    if bool(g\['bake_valid'].value()) != ok:\n        g\['bake_valid'].setValue(ok)\n    text = ('baked' if ok else 'bake out of date: live') if g\['use_baked'].value() and g\['baked_hash'].value() else ''\n    if g\['label'].value() in ('', 'baked', 'bake out of date: live') and g\['label'].value() != text:\n        g\['label'].setValue(text)\n_ezcs_check(nuke.thisNode())\n"}
 addUserKnob {26 version_divider l "" +STARTLINE}
 addUserKnob {26 version -STARTLINE T "EzCloudShafts v1.1.0"}
 addUserKnob {78 cam_world_matrix l "camera matrix" +INVISIBLE n 16}
