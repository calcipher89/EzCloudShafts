set Nc7d2e000 [stack 0]
 Write {
  channels all
  file "\[python -execlocal \{import os\ng = nuke.thisGroup()\nready = g.knob('bake_file') is not None and g.knob('bake_folder') is not None\ns = nuke.root().name()\nbase = os.path.splitext(os.path.basename(s))\[0]\np = g\['bake_file'].value().strip() if ready else ''\nif not p:\n    d = (g\['bake_folder'].value().strip() if ready else '') or os.environ.get('EZATMOS_CACHE_DIR', '')\n    d = d or os.path.join(os.path.dirname(s), 'ezatmos_cache')\n    p = d.rstrip('/') + '/' + base + '/' + g.name() + '/' + base + '_' + g.name() + '.####.exr'\np = os.path.expandvars(p)\nif '\[' in p:\n    try:\n        p = nuke.tcl('subst', p)\n    except RuntimeError:\n        p = ''\nret = '' if '\$' in p or not ready else p.replace(chr(92), '/')\}]"
  file_type exr
  first_part rgba
  create_directories true
  in_colorspace scene_linear
  out_colorspace scene_linear
  ocioColorspace scene_linear
  display default
  view sRGB
  name BakeWrite
  xpos 200
  ypos 840
 }
push $Neff13e00
 Reformat {
  name CameraFormat
  xpos 400
  ypos 920
 }
 BlinkScript {
  recompileCount 2
  KernelDescription "3 \"EzAtmosCameraUV\" iterate pixelWise ef3ebfacbe5119f38aafd7c67595b27a441134e888d9ecd146bb2ebb8b47a1ff 2 \"ref\" Read Point \"dst\" Write Point 9 \"cam_row0\" Float 3 AACAPwAAAAAAAAAAAAAAAA== \"cam_row1\" Float 3 AAAAAAAAgD8AAAAAAAAAAA== \"cam_row2\" Float 3 AAAAAAAAAAAAAIA/AAAAAA== \"focal\" Float 1 AABIQg== \"haperture\" Float 1 ppvEQQ== \"win_translate\" Float 2 AAAAAAAAAAA= \"win_scale\" Float 2 AACAPwAAgD8= \"win_roll\" Float 1 AAAAAA== \"pixel_aspect\" Float 1 AACAPw== 9 \"camRow0\" 3 1 Default \"camRow1\" 3 1 Default \"camRow2\" 3 1 Default \"focal\" 1 1 Default \"haperture\" 1 1 Default \"winTranslate\" 2 1 Default \"winScale\" 2 1 Default \"winRoll\" 1 1 Default \"pixelAspect\" 1 1 Default 1 \"pi\" Float 1 1 AAAAAA=="
  kernelSource "// EzAtmosCameraUV: for each pixel of the shot camera's frame, the direction the camera looks\n// through it, and that direction's place in EzAtmosScatter's lat-long, as an ST map (red = u,\n// green = v). An STMap then turns every output layer into what a ScanlineRender of a skydome\n// textured with it shows through this camera: a sky plate in the shot's format.\n//\n// Inputs: `ref` sets the output size (the project format). `camRow0..2` are the rows of the\n// camera's world rotation, `focal`, `haperture` the lens, `winTranslate`, `winScale`, `winRoll`\n// its window, `pixelAspect` the format's pixel aspect.\n\nkernel EzAtmosCameraUV : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> ref;\n  Image<eWrite> dst;\n\nparam:\n  float3 camRow0;\n  float3 camRow1;\n  float3 camRow2;\n  float focal;\n  float haperture;\n  float2 winTranslate;\n  float2 winScale;\n  float winRoll;\n  float pixelAspect;\n\nlocal:\n  float pi;\n\n  void define()\n  \{\n    defineParam(camRow0, \"cam_row0\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(camRow1, \"cam_row1\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(camRow2, \"cam_row2\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(focal, \"focal\", 50.0f);\n    defineParam(haperture, \"haperture\", 24.576f);\n    defineParam(winTranslate, \"win_translate\", float2(0.0f, 0.0f));\n    defineParam(winScale, \"win_scale\", float2(1.0f, 1.0f));\n    defineParam(winRoll, \"win_roll\", 0.0f);\n    defineParam(pixelAspect, \"pixel_aspect\", 1.0f);\n  \}\n\n  void init()\n  \{\n    pi = 3.14159265358979f;\n  \}\n\n  void process(int2 pos)\n  \{\n    float w = ref.bounds.width();\n    float h = ref.bounds.height();\n    // Screen position, -1..1 across the width; the height in the same units (the format's\n    // aspect), as in Nuke's camera projection.\n    float sx = ((pos.x - ref.bounds.x1 + 0.5f) / w) * 2.0f - 1.0f;\n    float sy = (((pos.y - ref.bounds.y1 + 0.5f) / h) * 2.0f - 1.0f) * h / (w * pixelAspect);\n    // Undo the camera window the way Nuke applies it (nukescripts.snap3d.cameraProjectionMatrix):\n    // screen = roll * (projected - winTranslate) / winScale.\n    float cr = cos(-winRoll * pi / 180.0f);\n    float sn = sin(-winRoll * pi / 180.0f);\n    float rx = sx * cr - sy * sn;\n    float ry = sx * sn + sy * cr;\n    float spread = 0.5f * haperture / focal;\n    float3 ray = float3((rx * winScale.x + winTranslate.x) * spread, (ry * winScale.y + winTranslate.y) * spread, -1.0f);\n    float3 d = normalize(float3(dot(camRow0, ray), dot(camRow1, ray), dot(camRow2, ray)));\n    // EzAtmosScatter's lat-long: the centre column looks down -Z, the top row up.\n    float u = 0.5f + atan2(d.x, -d.z) / (2.0f * pi);\n    float v = 0.5f + asin(clamp(d.y, -1.0f, 1.0f)) / pi;\n    // Blue: u for the lat-long turned half way round; alpha: 1 away from the 0/1 seam, where\n    // the plain lat-long can be read (see _seamless_stmap in build_gizmo.py).\n    float turned = u + 0.5f - floor(u + 0.5f);\n    dst() = float4(u, v, turned, u > 0.1f && u < 0.9f ? 1.0f : 0.0f);\n  \}\n\};\n"
  rebuild ""
  EzAtmosCameraUV_cam_row0 {{"\[python -execlocal \{def local(n, t):\n    import math\n    M = nuke.math.Matrix4\n    def v(k, i):\n        return n\[k].getValueAt(t, i)\n    T = M()\n    T.makeIdentity()\n    T.translate(v('translate', 0), v('translate', 1), v('translate', 2))\n    P = M()\n    P.makeIdentity()\n    P.translate(v('pivot', 0), v('pivot', 1), v('pivot', 2))\n    us = n\['uniform_scale'].getValueAt(t)\n    S = M()\n    S.makeIdentity()\n    S.scale(v('scaling', 0) * us, v('scaling', 1) * us, v('scaling', 2) * us)\n    R = M()\n    R.makeIdentity()\n    for axis in reversed(n\['rot_order'].value()):\n        a = math.radians(v('rotate', 'XYZ'.index(axis)))\n        if axis == 'X':\n            R.rotateX(a)\n        elif axis == 'Y':\n            R.rotateY(a)\n        else:\n            R.rotateZ(a)\n    m = M()\n    m.makeIdentity()\n    for op in n\['xform_order'].value():\n        if op == 'T':\n            m = T * m\n        else:\n            m = P * (S if op == 'S' else R) * P.inverse() * m\n    return m\nt = nuke.frame()\ng = nuke.thisGroup()\nn = g.input(2)\nm = nuke.math.Matrix4()\nm.makeIdentity()\nr = 1.0\nwhile n is not None:\n    p = n.input(1) if n.Class() == 'TransformGeo' else None\n    if p is not None and p.knob('world_matrix'):\n        w = nuke.math.Matrix4()\n        for i in range(16):\n            w\[(i % 4) * 4 + i // 4] = p\['world_matrix'].getValueAt(t, i)\n        m = m * w\n    if n.knob('transform') and n\['transform'].Class() == 'Axis_Knob':\n        m = m * local(n, t)\n    if n.Class() == 'Sphere':\n        r = n\['radius'].getValueAt(t)\n        break\n    n = n.input(0)\n# The camera, through any Dots or NoOps in between.\nc = g.input(3)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(t, 0) if c is not None else 1\}]"} {"\[python -execlocal \{def local(n, t):\n    import math\n    M = nuke.math.Matrix4\n    def v(k, i):\n        return n\[k].getValueAt(t, i)\n    T = M()\n    T.makeIdentity()\n    T.translate(v('translate', 0), v('translate', 1), v('translate', 2))\n    P = M()\n    P.makeIdentity()\n    P.translate(v('pivot', 0), v('pivot', 1), v('pivot', 2))\n    us = n\['uniform_scale'].getValueAt(t)\n    S = M()\n    S.makeIdentity()\n    S.scale(v('scaling', 0) * us, v('scaling', 1) * us, v('scaling', 2) * us)\n    R = M()\n    R.makeIdentity()\n    for axis in reversed(n\['rot_order'].value()):\n        a = math.radians(v('rotate', 'XYZ'.index(axis)))\n        if axis == 'X':\n            R.rotateX(a)\n        elif axis == 'Y':\n            R.rotateY(a)\n        else:\n            R.rotateZ(a)\n    m = M()\n    m.makeIdentity()\n    for op in n\['xform_order'].value():\n        if op == 'T':\n            m = T * m\n        else:\n            m = P * (S if op == 'S' else R) * P.inverse() * m\n    return m\nt = nuke.frame()\ng = nuke.thisGroup()\nn = g.input(2)\nm = nuke.math.Matrix4()\nm.makeIdentity()\nr = 1.0\nwhile n is not None:\n    p = n.input(1) if n.Class() == 'TransformGeo' else None\n    if p is not None and p.knob('world_matrix'):\n        w = nuke.math.Matrix4()\n        for i in range(16):\n            w\[(i % 4) * 4 + i // 4] = p\['world_matrix'].getValueAt(t, i)\n        m = m * w\n    if n.knob('transform') and n\['transform'].Class() == 'Axis_Knob':\n        m = m * local(n, t)\n    if n.Class() == 'Sphere':\n        r = n\['radius'].getValueAt(t)\n        break\n    n = n.input(0)\n# The camera, through any Dots or NoOps in between.\nc = g.input(3)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(t, 1) if c is not None else 0\}]"} {"\[python -execlocal \{def local(n, t):\n    import math\n    M = nuke.math.Matrix4\n    def v(k, i):\n        return n\[k].getValueAt(t, i)\n    T = M()\n    T.makeIdentity()\n    T.translate(v('translate', 0), v('translate', 1), v('translate', 2))\n    P = M()\n    P.makeIdentity()\n    P.translate(v('pivot', 0), v('pivot', 1), v('pivot', 2))\n    us = n\['uniform_scale'].getValueAt(t)\n    S = M()\n    S.makeIdentity()\n    S.scale(v('scaling', 0) * us, v('scaling', 1) * us, v('scaling', 2) * us)\n    R = M()\n    R.makeIdentity()\n    for axis in reversed(n\['rot_order'].value()):\n        a = math.radians(v('rotate', 'XYZ'.index(axis)))\n        if axis == 'X':\n            R.rotateX(a)\n        elif axis == 'Y':\n            R.rotateY(a)\n        else:\n            R.rotateZ(a)\n    m = M()\n    m.makeIdentity()\n    for op in n\['xform_order'].value():\n        if op == 'T':\n            m = T * m\n        else:\n            m = P * (S if op == 'S' else R) * P.inverse() * m\n    return m\nt = nuke.frame()\ng = nuke.thisGroup()\nn = g.input(2)\nm = nuke.math.Matrix4()\nm.makeIdentity()\nr = 1.0\nwhile n is not None:\n    p = n.input(1) if n.Class() == 'TransformGeo' else None\n    if p is not None and p.knob('world_matrix'):\n        w = nuke.math.Matrix4()\n        for i in range(16):\n            w\[(i % 4) * 4 + i // 4] = p\['world_matrix'].getValueAt(t, i)\n        m = m * w\n    if n.knob('transform') and n\['transform'].Class() == 'Axis_Knob':\n        m = m * local(n, t)\n    if n.Class() == 'Sphere':\n        r = n\['radius'].getValueAt(t)\n        break\n    n = n.input(0)\n# The camera, through any Dots or NoOps in between.\nc = g.input(3)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(t, 2) if c is not None else 0\}]"}}
