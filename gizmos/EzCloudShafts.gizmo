push $N1a700000
 Shuffle2 {
  fromInput1 {{0} B}
  in1 P
  fromInput2 {{0} B}
  mappings "4 P.red 0 0 rgba.red 0 0 P.green 0 1 rgba.green 0 1 P.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3"
  name PositionPick
  xpos 180
  ypos 60
 }
set N1a700005 [stack 0]
 Constant {
  inputs 0
  format "8 4 0 0 8 4 1 EzCloudShafts_tiny"
  name NoClouds
  xpos 360
  ypos 0
 }
