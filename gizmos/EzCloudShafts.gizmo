version 15.1 v3
add_layer {P P.red P.green P.blue}
add_layer {shafts shafts.red shafts.green shafts.blue shafts.alpha}
add_layer {cloudshadow cloudshadow.red cloudshadow.green cloudshadow.blue cloudshadow.alpha}
add_layer {atmos_haze_sun atmos_haze_sun.red atmos_haze_sun.green atmos_haze_sun.blue}
Gizmo {
 name EzCloudShafts1
 tile_color 0xb08a4aff
 addUserKnob {20 ezcloudshafts l EzCloudShafts}
 addUserKnob {22 analyze t "Reads the cloud height from the clouds' depth (the median of the cloudy pixels), takes the units from the EzAtmosScatter in 'atmos', and reports how much of the ground the gobo reaches. Run it at a frame where the clouds are in view." T "\nimport math\nn = nuke.thisNode()\nframe = nuke.frame()\nnotes = \[]\n\n\ndef up(i, knob):\n    node = n.input(i)\n    while node is not None and not node.knob(knob):\n        node = node.input(0) if node.inputs() else None\n    return node\n\n\natmos = up(3, 'haze_density')\ncam = up(2, 'focal')\nclouds = n.input(1)\nenv = n.input(0)\nif atmos is not None and atmos.knob('scene_scale'):\n    n\['scene_scale'].setValue(atmos\['scene_scale'].value())\n    notes.append('Units to metres %g, from %s.' % (atmos\['scene_scale'].value(), atmos.name()))\nscale = n\['scene_scale'].value()\nif cam is None:\n    notes.append('No camera in the camera input: connect the shot camera.')\nif env is None:\n    notes.append('Nothing in the env input.')\nif clouds is None:\n    notes.append('Nothing in the clouds input.')\n\nif cam is not None and clouds is not None:\n    m = \[cam\['world_matrix'].getValueAt(frame, i) for i in range(16)]\n    focal = cam\['focal'].getValueAt(frame)\n    hap = cam\['haperture'].getValueAt(frame)\n    vap = cam\['vaperture'].getValueAt(frame)\n    fmt = clouds.format()\n    efmt = env.format() if env is not None else fmt\n    ox = max(0.0, (fmt.width() - efmt.width()) / 2.0)\n    oy = max(0.0, (fmt.height() - efmt.height()) / 2.0)\n    depth = n\['clouds_depth'].value()\n    if depth not in clouds.channels():\n        notes.append('The clouds input has no %s channel: set \"clouds depth\".' % depth)\n    else:\n        heights = \[]\n        nx, ny = 64, 36\n        for j in range(ny):\n            for i in range(nx):\n                px = (i + 0.5) * fmt.width() / nx\n                py = (j + 0.5) * fmt.height() / ny\n                a = clouds.sample('rgba.alpha', px, py)\n                if a < 0.5:\n                    continue\n                z = clouds.sample(depth, px, py)\n                if z <= 0:\n                    continue\n                u = (px - ox) / (fmt.width() - 2 * ox)\n                v = (py - oy) / (fmt.height() - 2 * oy)\n                cx = (u - 0.5) * hap / focal * z\n                cy = (v - 0.5) * vap / focal * z\n                cz = -z\n                heights.append((m\[4] * cx + m\[5] * cy + m\[6] * cz + m\[7]) * scale)\n        if len(heights) < 10:\n            notes.append('Too little cloud in the clouds alpha (%d of %d samples) to measure its height.'\n                         % (len(heights), nx * ny))\n        else:\n            heights.sort()\n            pick = lambda f: heights\[min(len(heights) - 1, int(f * len(heights)))]\n            if pick(0.5) <= 0:\n                notes.append('The cloud measured below the ground (%.0f m): is the depth Planar Z, in scene '\n                             'units?' % pick(0.5))\n            else:\n                n\['cloud_height'].setValue(round(pick(0.5), 1))\n                notes.append('Cloud height %.0f m (base %.0f m, top %.0f m, from %d samples).'\n                             % (pick(0.5), pick(0.1), pick(0.9), len(heights)))\n\n        # How much of the ground the gobo reaches, from a grid of the env's world positions.\n        layer = n\['position_layer'].value()\n        if env is not None and layer + '.red' in env.channels():\n            sun = \[n\['sun_in_use'].getValueAt(frame, i) for i in range(3)]\n            rot = math.radians(-n\['sun_rotation_in_use'].getValueAt(frame))\n            sun = \[sun\[0] * math.cos(rot) + sun\[2] * math.sin(rot), sun\[1],\n                   -sun\[0] * math.sin(rot) + sun\[2] * math.cos(rot)]\n            norm = math.sqrt(sum(s * s for s in sun)) or 1.0\n            sun = \[s / norm for s in sun]\n            h = n\['cloud_height'].value()\n            cam_pos = \[m\[3] * scale, m\[7] * scale, m\[11] * scale]\n            ground = covered = 0\n            bounds = clouds.bbox()\n            for j in range(36):\n                for i in range(64):\n                    px = (i + 0.5) * efmt.width() / 64\n                    py = (j + 0.5) * efmt.height() / 36\n                    p = \[env.sample(layer + '.' + c, px, py) * scale\n                         for c in ('red', 'green', 'blue')]\n                    if p == \[0.0, 0.0, 0.0] or p\[1] >= h:\n                        continue\n                    ground += 1\n                    if sun\[1] <= 0.01:\n                        continue\n                    t = (h - p\[1]) / sun\[1]\n                    d = \[p\[k] + sun\[k] * t - cam_pos\[k] for k in range(3)]\n                    cx = m\[0] * d\[0] + m\[4] * d\[1] + m\[8] * d\[2]\n                    cy = m\[1] * d\[0] + m\[5] * d\[1] + m\[9] * d\[2]\n                    cz = m\[2] * d\[0] + m\[6] * d\[1] + m\[10] * d\[2]\n                    if cz > -1e-3:\n                        continue\n                    x = ox + (0.5 + cx / -cz * focal / hap) * (fmt.width() - 2 * ox)\n                    y = oy + (0.5 + cy / -cz * focal / vap) * (fmt.height() - 2 * oy)\n                    if bounds.x() <= x < bounds.x() + bounds.w() and bounds.y() <= y < bounds.y() + bounds.h():\n                        covered += 1\n            if ground:\n                notes.append('The gobo reaches %.0f%% of the ground; the rest uses \"outside frame\" (%s). '\n                             'More overscan on the clouds render raises it.'\n                             % (100.0 * covered / ground, n\['outside_frame'].value()))\n        else:\n            notes.append('The env input has no \"%s\" layer: set \"position layer\" to its world position.' % layer)\n\nnuke.message('EzCloudShafts analyze\\n\\n' + '\\n'.join(notes))\n" +STARTLINE}
 addUserKnob {4 view t "What the main rgb shows. The passes are always written to the shafts and cloudshadow layers; Passthrough leaves rgba as the env render." -STARTLINE M {Passthrough "Shafts Over Env" "Shadow Matte" "Gobo Check" "Shafts Matte"}}
 view "Shafts Over Env"
 addUserKnob {4 viewer_resolution l "viewer resolution" t "Size the passes are computed at in the Nuke GUI, then scaled back up. Half is about four times faster than Full. Renders from a terminal or the farm use 'render resolution'." M {Full Half Quarter}}
 viewer_resolution Half
 addUserKnob {4 render_resolution l "render resolution" t "Size the passes are computed at when rendering outside the GUI (terminal, farm)." -STARTLINE M {Full Half Quarter}}
 addUserKnob {4 shafts_resolution l "shafts at" t "The shafts are soft, so they can be computed smaller again than the ground matte: Half of the viewer or render resolution is four times faster and rarely shows." -STARTLINE M {Same Half Quarter}}
 shafts_resolution Half
 addUserKnob {7 matte_scale +INVISIBLE}
 matte_scale {{"(\$gui ? viewer_resolution : render_resolution) == 0 ? 1 : (\$gui ? viewer_resolution : render_resolution) == 1 ? 0.5 : 0.25"}}
 addUserKnob {7 shafts_scale +INVISIBLE}
 shafts_scale {{"matte_scale * (shafts_resolution == 0 ? 1 : shafts_resolution == 1 ? 0.5 : 0.25)"}}
 addUserKnob {26 inputs_divider l Inputs}
 addUserKnob {41 position_layer l "position layer" t "Layer of the env render holding world position (P World), in scene units." T PositionPick.in1}
 addUserKnob {1 clouds_depth l "clouds depth" t "Channel of the clouds input holding its depth (Planar Z, scene units). Only analyze reads it."}
 clouds_depth depth.Z
 addUserKnob {7 scene_scale l "units to metres" t "Scene units to metres: 0.1 for decimetres. Analyze takes it from the EzAtmosScatter in 'atmos'." R 0 1}
 scene_scale 0.1
 addUserKnob {26 sun_divider l Sun}
 addUserKnob {4 sun_from l "sun from" t "Auto: the Axis in the 'sun' input if there is one, else the EzAtmosScatter in 'atmos', else 'sun direction'. The Axis's world position is the direction towards the sun." M {Auto "Sun Input (Axis)" EzAtmosScatter Manual}}
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up, used when there is no Axis or atmos (or 'sun from' is Manual)."}
 sun_direction {0 0.5 -1}
 addUserKnob {13 sun_in_use l "sun in use" t "The sun direction in use, whichever 'sun from' picked. Read only." +DISABLED}
 addUserKnob {7 sun_rotation_in_use l "sun rotation" +INVISIBLE}
 addUserKnob {26 clouds_divider l "Cloud gobo"}
 addUserKnob {7 cloud_height l "cloud height (m)" t "Height of the cloud sheet above the scene's 0, in metres. Analyze measures it from the clouds' depth; raise or lower it to slide the shadows along the sun." R 0 8000}
 cloud_height 2000
 addUserKnob {7 cloud_density l "cloud density" t "Multiplies the clouds alpha: above 1 thin cloud blocks more sun." R 0 3}
 cloud_density 1
 addUserKnob {7 shadow_strength l "shadow strength" t "How much sunlight the cloud takes away: 1 is all of it."}
 shadow_strength 1
 addUserKnob {4 outside_frame l "outside frame" t "Where the sun ray meets the cloud sheet outside the clouds render (past its overscan), as the camera sees it: count it as a gap (Lit) or as cloud (Shadowed)." M {Lit Shadowed}}
 addUserKnob {7 penumbra l "softness (deg)" t "Spreads the sun over a cone this wide, so shadow edges soften the further they fall from the cloud. The real sun is about 0.27." R 0 5}
 penumbra 0.5
 addUserKnob {3 samples l "softness samples" t "Sun directions averaged for the ground matte. More is smoother and slower."}
 samples 6
 addUserKnob {7 drift_x l "drift x (m/frame)" t "Moves the cloud shadows across the ground over time, for clouds rendered still." R -20 20}
 addUserKnob {7 drift_z l "drift z (m/frame)" t "Moves the cloud shadows across the ground over time, for clouds rendered still." R -20 20}
 addUserKnob {3 drift_frame l "drift from frame" t "The frame where the drift is 0."}
 drift_frame 1001
 addUserKnob {26 shafts_divider l Shafts}
 addUserKnob {7 shaft_density l "haze density (1/km)" t "How much the air in front of the terrain scatters the sun at camera height: more gives stronger beams. 0.1 is light haze." R 0 1}
 shaft_density 0.1
 addUserKnob {7 haze_height l "haze height (km)" t "Height over which the haze thins out by a factor of e." R 0.1 5}
 haze_height 1.2
 addUserKnob {7 shaft_start l "start (m)" t "Air nearer than this has no beams." R 0 2000}
 addUserKnob {7 max_distance l "max distance (km)" t "Air further than this has no beams. 0 runs to the terrain." R 0 50}
 addUserKnob {7 sky_distance l "sky distance (km)" t "How far the beams reach where there is no terrain (sky), if the cloud sheet is not met first." R 1 100}
 sky_distance 20
 addUserKnob {3 march_steps l steps t "Steps along each view ray. More gives cleaner beams and is slower."}
 march_steps 32
 addUserKnob {4 color_from l "colour from" t "EzAtmosScatter: the sunlit haze colour of the atmos input (atmos_haze_sun along the view), times 'shaft color'. Color: 'shaft color' alone. Without an atmos input it is Color." M {EzAtmosScatter Color}}
 addUserKnob {18 shaft_color l "shaft color" t "Colour of the beams, or a tint on the atmos colour."}
 shaft_color 1
 addUserKnob {7 shaft_intensity l intensity t "Multiplies the beams, rgb and matte." R 0 10}
 shaft_intensity 1
 addUserKnob {26 version_divider l "" +STARTLINE}
 addUserKnob {26 version T "EzCloudShafts v1.0.0"}
 addUserKnob {78 cam_world_matrix l "camera matrix" +INVISIBLE n 16}
 cam_world_matrix {{"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 0) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 1) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 2) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 3) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 4) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 5) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 6) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 7) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 8) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 9) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 10) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 11) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 12) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 13) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 14) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 15) if c is not None else 1\}]"}}
 addUserKnob {7 cam_focal +INVISIBLE}
 cam_focal {{"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['focal'].getValueAt(nuke.frame()) if c is not None else 35\}]"}}
 addUserKnob {7 cam_haperture +INVISIBLE}
 cam_haperture {{"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['haperture'].getValueAt(nuke.frame()) if c is not None else 36\}]"}}
 addUserKnob {7 cam_vaperture +INVISIBLE}
 cam_vaperture {{"\[python -execlocal \{c = nuke.thisNode().input(2)\nwhile c is not None and not c.knob('focal'):\n    c = c.input(0) if c.inputs() else None\nret = c\['vaperture'].getValueAt(nuke.frame()) if c is not None else 20.25\}]"}}
 addUserKnob {3 atm_found +INVISIBLE}
 atm_found {{"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 1 if a is not None else 0\}]"}}
 addUserKnob {13 atm_sun +INVISIBLE}
 atm_sun {{"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 0) if a is not None else 0\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 1) if a is not None else 0\}]"} {"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = (a.knob('sun_in_use') or a.knob('sun_direction')).getValueAt(nuke.frame(), 2) if a is not None else 0\}]"}}
 addUserKnob {7 atm_rotation +INVISIBLE}
 atm_rotation {{"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = a\['hdri_rotation'].getValueAt(nuke.frame()) if a is not None and a.knob('hdri_rotation') else 0\}]"}}
 addUserKnob {3 atm_screen +INVISIBLE}
 atm_screen {{"\[python -execlocal \{a = nuke.thisNode().input(3)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 1 if a is not None and a.knob('output_mapping') and int(a\['output_mapping'].getValue()) == 2 else 0\}]"}}
 addUserKnob {3 axis_found +INVISIBLE}
 axis_found {{"\[python -execlocal \{x = nuke.thisNode().input(4)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = 1 if x is not None else 0\}]"}}
 addUserKnob {13 axis_position +INVISIBLE}
 axis_position {{"\[python -execlocal \{x = nuke.thisNode().input(4)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 3) if x is not None else 0\}]"} {"\[python -execlocal \{x = nuke.thisNode().input(4)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 7) if x is not None else 0\}]"} {"\[python -execlocal \{x = nuke.thisNode().input(4)\nwhile x is not None and not x.knob('world_matrix'):\n    x = x.input(0) if x.inputs() else None\nret = x\['world_matrix'].getValueAt(nuke.frame(), 11) if x is not None else 0\}]"}}
 addUserKnob {3 sun_source +INVISIBLE}
 sun_source {{"sun_from==1 ? (axis_found ? 1 : 0) : sun_from==2 ? (atm_found ? 2 : 0) : sun_from==3 ? 0 : (axis_found ? 1 : atm_found ? 2 : 0)"}}
 sun_in_use {{"sun_source==1 ? axis_position.x : sun_source==2 ? atm_sun.x : sun_direction.x"} {"sun_source==1 ? axis_position.y : sun_source==2 ? atm_sun.y : sun_direction.y"} {"sun_source==1 ? axis_position.z : sun_source==2 ? atm_sun.z : sun_direction.z"}}
 sun_rotation_in_use {{"sun_source==2 ? atm_rotation : 0"}}
}
